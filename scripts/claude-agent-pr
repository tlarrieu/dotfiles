#!/usr/bin/env bash
# Spawns a Claude agent (see claude-agent-spawn) on a pull request, in a
# worktree at its latest commit, for one of these tasks:
#   fix      fix it (mine): resolve its conflicts with its base branch (merging
#            it in, committed on my local copy of its branch, which its worktree
#            checks out when it can), address its unresolved
#            review threads, and its failing CI checks; it leaves those other
#            changes uncommitted for me to review, asks in the session when it
#            disagrees with a comment, and re-runs the jobs that failed for
#            infrastructure reasons
#   review   review it (someone else's), critically: design and naming first,
#            bugs on the side; in the session only, changing nothing
# Either way, it pushes nothing, and posts nothing on GitHub unless asked
# (re-runs aside).
# The repository's clone: the one in ~/dev or ~/git whose origin it is.
# Usage: claude-agent-pr <fix|review> <owner/repo> <number>

assets=$(dirname "$(readlink -f "$0")")
# shellcheck source-path=SCRIPTDIR source=lib/github.sh
. "$assets/lib/github.sh" # github_ignored_check
fail() { notify-send --app-name=claude --icon="$assets/claude.png" Claude "$1"; exit 1; }

task=$1 repo=$2 number=$3
case $task in fix | review) ;; *) task='' ;; esac
[ -n "$task" ] && [ -n "$repo" ] && [ -n "$number" ] \
  || { echo "Usage: claude-agent-pr <fix|review> <owner/repo> <number>" >&2; exit 2; }

# Any remote URL form: git@github.com:owner/repo(.git), https://github.com/owner/repo(.git)
clone=''
for dir in ~/dev/*/ ~/git/*/; do
  origin=$(git -C "$dir" remote get-url origin 2>/dev/null) || continue
  origin=${origin%.git} origin=${origin%/}
  if [[ ${origin,,} == *[:/]"${repo,,}" ]]; then
    clone=${dir%/}
    break
  fi
done
[ -n "$clone" ] || fail "No clone of $repo in ~/dev or ~/git"

# The pull request's latest commit, whichever fork its branch lives in
timeout 60 git -C "$clone" fetch --quiet origin "refs/pull/$number/head" 2>/dev/null \
  || fail "Could not fetch $repo#$number"
head=$(git -C "$clone" rev-parse FETCH_HEAD)

url="https://github.com/$repo/pull/$number"
about="You work on pull request #$number of $repo ($url), at its latest commit."

if [ "$task" = fix ]; then
  # Its branches, for the merge (left to the agent to find out without them)
  IFS=$'\t' read -r branch base < <(timeout 30 gh pr view "$number" -R "$repo" \
    --json headRefName,baseRefName --jq '[.headRefName, .baseRefName] | @tsv' 2>/dev/null)

  # The agent's worktree checks out my local copy of its head branch,
  # fast-forwarded to its latest commit (created there when missing), so that
  # its commits land on the branch I push from; not when another worktree (my
  # clone's included) has it checked out, or it holds commits the pull request
  # doesn't: then the agent asks me where to commit
  local_branch='' unusable=''
  if [ -z "$branch" ]; then
    unusable='its head branch is unknown (gh pr view failed)'
  elif git -C "$clone" worktree list --porcelain | grep -qxF "branch refs/heads/$branch"; then
    unusable="$branch is checked out in another worktree"
  elif ! git -C "$clone" show-ref --verify --quiet "refs/heads/$branch"; then
    git -C "$clone" branch --quiet "$branch" "$head" && local_branch=$branch
    git -C "$clone" show-ref --verify --quiet "refs/remotes/origin/$branch" &&
      git -C "$clone" branch --quiet --set-upstream-to="origin/$branch" "$branch"
  elif git -C "$clone" merge-base --is-ancestor "refs/heads/$branch" "$head"; then
    git -C "$clone" branch --quiet --force "$branch" "$head" && local_branch=$branch
  else
    unusable="the local $branch holds commits the pull request doesn't"
  fi
  [ -n "$local_branch" ] || [ -n "$unusable" ] || unusable="$branch could not be moved to its latest commit"
  branch=${branch:-<its head branch, see gh pr view>} base=${base:-<its base branch, see gh pr view>}

  if [ -n "$local_branch" ]; then
    read -r -d '' where <<WHERE
Your worktree is on $branch, the user's local copy of its head branch,
fast-forwarded to its latest commit: make any commit there, and never create
another branch.
WHERE
    push="git push origin $branch"
  else
    read -r -d '' where <<WHERE
Your worktree is on a detached HEAD, as it could not be put on its head branch:
$unusable. Before your first commit, tell the user so, and ask them which
branch to make it on.
WHERE
    push="git push origin <the branch you committed on>:$branch"
  fi

  read -r -d '' rules <<RULES
$about
$where
Never push. Commit only the merge resolving its conflicts (see the task),
unless the user asks for more: leave every other change uncommitted, for the
user to review. Whenever you commit, give the user the command to push it
from their clone, $clone (your worktree goes once you stop; the branch stays,
as worktrees share their clone's branches): $push.
Don't reply to, nor resolve, any review thread on GitHub unless the user asks
you to. Re-run a CI job only when it failed for an infrastructure reason, and
once (see the task); no other one unless the user asks. When you disagree
with a reviewer's comment, or can't tell what it asks, ask the user here
before changing anything for it.
RULES

  read -r -d '' prompt <<PROMPT
Fix $url: its conflicts with its base branch, its unresolved review threads,
and its failing CI checks.
0. Conflicts: check whether it has any with gh pr view $number -R $repo
   --json mergeable (CONFLICTING). If so, git fetch origin $base and
   git merge origin/$base, as GitHub's "Update
   branch" would (a merge, not a rebase: the pull request's branch then only
   moves forward). Resolve each conflict from what both sides meant: read the
   pull request's change and what $base changed there since (git log -p
   --merge, for each conflicting file). When the right resolution isn't
   clear, ask the user before settling it. Run the specs covering the
   conflicting files, then commit the merge (git commit --no-edit), and give
   the push command in your summary.
1. Review threads: fetch them with gh api graphql (the pull request's
   reviewThreads, keeping those whose isResolved is false, with their path,
   line and comments). For each, make the change asked for.
2. CI: list the checks of its latest commit with gh pr checks $number -R $repo
   (tab separated: name, state, duration, link), keeping those whose state is
   fail; skip "$github_ignored_check", which only waits for approvals, and
   summaries of the others (such as "CI Summary"). For a GitHub Actions job
   (its link ends with /job/<job id>), read its log with
   gh api repos/$repo/actions/jobs/<job id>/logs (gh run view --log-failed
   prints nothing here): look for ##[error] lines and the test failures above
   them. Fix what the pull request broke. A failure it didn't cause is not
   yours to fix: tell it apart, and say so instead of changing code for it.
   When it's the infrastructure's (the runner shut down or lost, a timeout
   fetching dependencies or images, a service that didn't start: nothing the
   code did), re-run that job, once, with
   gh api -X POST repos/$repo/actions/jobs/<job id>/rerun (the id from its
   link; not gh run rerun --job, which wants another one): if it fails again,
   report it instead. One re-run already (its run_attempt, in
   gh api repos/$repo/actions/jobs/<job id>, is above 1): report it too. A
   flaky spec, or one failing on the base branch too: report it only.
Any of them may have nothing to do: say so and move on. Then run the specs
covering what you changed. Finish with a summary: the conflicts (how you
resolved each), then thread by thread, then check by check, what you changed,
re-ran, or why you did neither.
PROMPT
else
  read -r -d '' rules <<RULES
$about
You review it for the user: change no file, commit nothing, and post nothing
on GitHub (no comment, no review) unless the user asks you to. Your review
goes here, in the session.
Be a demanding, skeptical reviewer: no praise, no filler, no softening. What
matters most is design (responsibilities, coupling, wrong or premature
abstractions, code that belongs elsewhere in the codebase, consistency with
its existing patterns) and naming (misleading, vague or inconsistent names,
ones off the codebase's or the domain's vocabulary). Judge against the
surrounding code, not the diff alone.
RULES

  read -r -d '' prompt <<PROMPT
Review $url. Read its description and base branch with gh pr view, fetch that
base, then review the changes against its merge base with HEAD (so that what
landed on the base since stays out).
Report design and naming issues, the most severe first. For each:
- the file and line range,
- the part of the diff it is about, as a diff code block: only the lines
  concerned, with a few lines of context (not the whole hunk); when the issue
  recurs, the most telling excerpt, then the other places it occurs,
- what is wrong and why,
- a concrete alternative (as code when it helps).
Then, in a short separate section, bugs you noticed along the way (same
format). Leave out style nitpicks a linter would catch.
PROMPT
fi

CLAUDE_AGENT_DIR=$clone CLAUDE_AGENT_AT=$head CLAUDE_AGENT_BRANCH=$local_branch CLAUDE_AGENT_CONTEXT=$rules CLAUDE_AGENT_PR="$repo#$number" \
  exec "$assets/claude-agent-spawn" "$prompt"
