#!/usr/bin/env bash
# Rofi hub for my pull requests in the merge queue, those ready to join it, and
# my other open ones, with what blocks them (see merge-queue). Enter: open in the browser. Alt+r: refresh from GitHub.
# Alt+q: open the merge queue page of the selected pull request's repository.

assets=$(dirname "$(readlink -f "$0")")
mode=--cached

declare -A faces=(
  [QUEUED]='󰔟'
  [AWAITING_CHECKS]='󰦖'
  [MERGEABLE]='󰄬'
  [UNMERGEABLE]='󰀦'
  [LOCKED]='󰌾'
  [READY]='󰐕'
  [CONFLICT]='󰀩'
  [CHECKS_FAILING]='󰅙'
  [CHANGES_REQUESTED]='󰏫'
  [CHECKS_PENDING]='󰦖'
  [REVIEW_REQUIRED]='󰈈'
  [UNKNOWN]='󰋗'
  [DRAFT]='󰈤'
)

# What blocks my other pull requests, in a word
declare -A blockers=(
  [CONFLICT]=conflict [CHECKS_FAILING]=checks [CHANGES_REQUESTED]=changes
  [CHECKS_PENDING]=running [REVIEW_REQUIRED]=review [UNKNOWN]=unknown [DRAFT]=draft
)

# Compact durations: 42m, 3h, 2d (minutes rounded up, for ETAs)
duration() {
  if [ "$1" -lt 3600 ]; then echo "$((($1 + 59) / 60))m"
  elif [ "$1" -lt 86400 ]; then echo "$(($1 / 3600))h"
  else echo "$(($1 / 86400))d"; fi
}

escape() { sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g' <<<"$1"; }

while :; do
  queue=$("$assets/merge-queue" $mode 2>&1)
  status=$?
  mode=--cached

  if [ "$status" -eq 2 ]; then
    notify-send --app-name=merge-queue --urgency=critical "Merge queue not watched" "${queue#merge-queue: }"
    exit 1
  fi

  if [ -z "$queue" ]; then
    notify-send --app-name=merge-queue "Merge queue" "No open pull request"
    exit 0
  fi

  urls=()
  queues=()
  lines=()
  now=$(date +%s)
  while IFS=$'\t' read -r kind _ number position state time url queue_url title; do
    [ -n "$url" ] || continue # a GitHub failure message, past the (stale) queue
    case $kind in
      queued)
        where="#$position"
        if [ "$time" = - ]; then when='?'
        elif [ $(((time + 59) / 60)) -lt 60 ]; then when=$(duration "$time") # not "60m"
        else when=$(printf '%dh%02d' $((time / 3600)) $((time % 3600 / 60))); fi
        ;;
      ready) where='ready' when='' ;;
      *) where=${blockers[$state]:-$state} when=$(duration $((now - time))) ;; # since last update
    esac
    line=$(printf '%-2s %-8s %-6s  #%-7s %s' "${faces[$state]:-?}" "$where" "$when" "$number" "$(escape "$title")")
    # Blocked ones stay in the background: they're here for the overview
    [ "$kind" = other ] && line="<span fgalpha=\"60%\">$line</span>"
    urls+=("$url")
    queues+=("$queue_url")
    lines+=("$line")
  done <<<"$queue"

  choice=$(printf '%s\n' "${lines[@]}" | rofi -dmenu -i -markup-rows -p '' -format i \
    -kb-custom-1 'Alt+r' -kb-custom-2 'Alt+q' -mesg 'Enter: open  •  Alt+r: refresh  •  Alt+q: queue page')
  code=$?

  case $code in
    0) [ -n "$choice" ] && exec browser-kiosk "${urls[$choice]}"; exit 0 ;;
    10) mode='' ;;
    11) [ -n "$choice" ] && exec browser-kiosk "${queues[$choice]}"; exit 0 ;;
    *) exit 0 ;;
  esac
done
