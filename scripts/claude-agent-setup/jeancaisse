#!/usr/bin/env bash
# Prepares a jeancaisse worktree for a Claude agent, from within it, with
# TEST_ENV_NUMBER set to the agent's slot.
# Usage: jeancaisse <primary_checkout>

primary="$1"

# Shared local config and skills, the way the team does it
bin/wt-link "$primary"
[ -e "$primary/.env" ] && ln -sfn "$primary/.env" .env

ignored() { git -C "$primary" ls-files --others --ignored --exclude-standard --directory; }

# Node dependencies (2G+) are only tooling for specs, such as the OpenAPI
# generator: share the primary's
ignored | grep -E '(^|/)node_modules/$' | while read -r dir; do
  dir=${dir%/}
  [ -e "$dir" ] || ln -s "$primary/$dir" "$dir"
done

# Specs only regenerate stale generated files, so start from the primary's.
# Copies, not hard links: generators rewrite files in place. Not what
# wt-link shares (.cursor/plans): a copy would replace its link.
ignored |
  grep -vE '(^|/)node_modules/|^(tmp|log|storage|coverage|docker_data|public/assets)/' |
  grep -vE '^\.(yarn/cache|turbo|swc|ruby-lsp|crush|claude|explain_queries|cursor/plans)/|/\.swc/|^CLAUDE|^\.env$' |
  rsync -a -r --files-from=- "$primary/" ./

# Each slot has its own test databases (see config/database.yml), created on
# first use from the production structure, as AGENTS.md prescribes
database="jeancaisse_test$TEST_ENV_NUMBER"
exists=$(psql -X "$DATABASE_URL/postgres" -Atc "SELECT 1 FROM pg_database WHERE datname = '$database'")
if [ "$exists" != 1 ]; then
  echo "Creating the test databases of slot $TEST_ENV_NUMBER…"
  RAILS_ENV='test' bin/rails db:sync_structure && RAILS_ENV='test' bin/rails db:migrate
fi
