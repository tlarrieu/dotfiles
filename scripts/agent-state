#!/usr/bin/env bash
# Tracks an agent's state, as its harness tells it (from its hooks: Claude's
# go through harness/claude-hook), for the panel, rofi-github, the pickers.
# Usage: agent-state <idle|running|done|attention|end|subagent> --harness <name>
#          --session <id> [--transcript <path>] [--cwd <dir>] [--turn]
#          [--message <text>] [--subagent <id> [--subagent-done]]
#   idle        a session just started, resumed or cleared: tracked, but
#               nothing to tell
#   running     at work (a tool used, a prompt submitted: --turn, a new turn)
#   done        its turn is over (--message: what it said last, else its
#               harness's last_words)
#   attention   it waits on me (--message: for what)
#   end         the session is over
#   subagent    a subagent of its started (--subagent), or stopped
#               (--subagent-done)
# With --subagent, running and attention are a subagent's (it used a tool,
# it waits on me), told on its session.
# Run as a child of the harness's process (its hooks are): it finds its
# session's process up its parents (see alive).
# State files: $XDG_RUNTIME_DIR/agents/<session_id>, see
# lib/agents.sh for their fields (<since>: when the current turn
# started, i.e. the last prompt submission).
# A "done" session whose terminal is on screen is stored as "idle" (already seen);
# the panel turns the remaining "done" ones into "idle" once they get displayed.
# Live subagents are tracked as $XDG_RUNTIME_DIR/agents/<session_id>.subagents/<agent_id>
# markers (touched on each of their tool uses), so that a session whose main
# agent is done still shows as running while subagents work. Subagents needing
# us mark the session for attention, as the main agent does.

assets=$(dirname "$(readlink -f "$0")")

state=$1 harness='' session='' transcript='' cwd='' turn=false message='' agent='' agent_done=false
shift
while [ $# -gt 0 ]; do
  case $1 in
    --harness) harness=$2; shift ;;
    --session) session=$2; shift ;;
    --transcript) transcript=$2; shift ;;
    --cwd) cwd=$2; shift ;;
    --turn) turn=true ;;
    --message) message=$2; shift ;;
    --subagent) agent=$2; shift ;;
    --subagent-done) agent_done=true ;;
    *) echo "agent-state: unknown option $1" >&2; exit 2 ;;
  esac
  shift
done
[ -n "$session" ] && [ -n "$harness" ] || { echo "agent-state: --harness and --session are required" >&2; exit 2; }

# shellcheck source-path=SCRIPTDIR source=lib/agents.sh
. "$assets/lib/agents.sh"

file="$agents_dir/$session"
subagents="$file.subagents"
mkdir -p "$agents_dir"

refresh_panel() { awesome-client 'awesome.emit_signal("agents::update")' >/dev/null 2>&1 & }

# Subagents keep their session marked as running, and surface their requests
# for attention on it. A marker holding "attention" is a subagent waiting for us:
# its next tool use (or its end) puts the session back to running.
if [ -n "$agent" ]; then
  marker="$subagents/$agent"
  waiting=false
  [ "$(cat "$marker" 2>/dev/null)" = attention ] && waiting=true
  case "$state" in
  subagent)
    if $agent_done; then
      rm -f "$marker"
      rmdir "$subagents" 2>/dev/null
      $waiting || { refresh_panel; exit 0; }
      state=running
    else
      mkdir -p "$subagents" && touch "$marker"
      refresh_panel
      exit 0
    fi
    ;;
  running)
    [ -f "$marker" ] || exit 0
    : >"$marker" # empties it, and refreshes its mtime
    $waiting || exit 0
    ;;
  attention) mkdir -p "$subagents" && echo attention >"$marker" ;;
  *) exit 0 ;;
  esac
fi
[ "$state" = subagent ] && exit 0

if [ "$state" = end ]; then
  agent_unnotify "$session"
  rm -rf "$file" "$subagents"
  refresh_panel
  exit 0
fi

# Find the harness's process running this session, up our parents (used to
# prune crashed sessions)
pid=$PPID
while [ "$pid" -gt 1 ] && ! alive "$pid" "$harness"; do
  read_ppid "$pid" || ppid=1
  pid=$ppid
done
# None (its adapter's alive doesn't know it): agent-list would drop it at once
[ "$pid" -gt 1 ] || { echo "agent-state: no $harness process among my parents (see ${harness}_alive)" >&2; exit 1; }

# A background session has no terminal: what it inherited is the one it left
# (or the one that started it), not its
if harness_do "$harness" background "$pid"; then
  window=- listen_on=- kitty_window=-
else
  window=${WINDOWID:--} listen_on=${KITTY_LISTEN_ON:--} kitty_window=${KITTY_WINDOW_ID:--}
fi

displayed=false
case "$state" in
attention | done) agent_displayed "$harness" "$session" "$transcript" "$window" "$listen_on" "$kitty_window" && displayed=true ;;
esac
[ "$state" = "done" ] && $displayed && state=idle
# Its turn over, on a Monitor or a background shell still running: still at
# work (agent-list tells it monitoring), no "Done" to tell yet
watching=false
[ "$state" = "done" ] && harness_do "$harness" busy "$pid" && watching=true
# shellcheck disable=SC2034 # written by write_agent
if $watching; then untold=yes; else untold=-; fi
# Asking: the tools it runs the while, for agent-list to tell it granted
# what it asked (see tools in lib/agents.sh); as of its first ask (the same
# state again changes nothing, below)
tools=-
# shellcheck disable=SC2034 # written by write_agent
[ "$state" = attention ] && tools=$(harness_do "$harness" tools "$pid" | paste -sd,) && tools=${tools:--}

read_agent "$file" previous_
# shellcheck disable=SC2034 # these fields are written by name (write_agent)
started=${previous_started:-$(date +%s)} since=${previous_since:-$(date +%s)}
# A prompt starts a new turn, even when an interrupt (which fires no hook) left
# the session as running. And what it left running, once over, wakes it up
# with no prompt: a turn that may use no tool either, done as the last one,
# whose "Done" is still to tell (untold)
# shellcheck disable=SC2034,SC2154 # since is written by write_agent, previous_ fields set by read_agent
if $turn; then
  since=$(date +%s)
elif [ "$previous_state" = "$state" ] && { [ "$previous_untold" != yes ] || $watching; }; then
  exit 0 # nothing changed, avoid pinging awesome
fi

# Project: name of the git repository holding the session's cwd, else the cwd itself
cwd=${cwd:-$PWD}
root=$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null || echo "$cwd")
project=$(basename "$root")
project=${project//[[:space:]]/_}
[[ $root == *[[:space:]]* ]] && root=- # fields are space separated
# The pull request it works on, from what it is, at each hook (it may open
# one, or switch branches): see session_pr. Not from the environment:
# agents' windows inherit their kitty's, whichever agent started it (see
# agent-spawn)
# shellcheck disable=SC2034 # written by write_agent
pr=$(session_pr "$harness" "$transcript" "$root")
pr=${pr:--}
write_agent "$file"
# Its spawn's over, if any: it's up (see pr_spawning)
[ "$pr" = - ] || rm -f "$(pr_spawning "$pr")"
refresh_panel

# Its notification is outdated once it moves on (or got seen, as idle)
case "$state" in running | idle) agent_unnotify "$session" ;; esac

# Off screen, or wanting us: tell which agent, a click away (see agent_notify)
case "$state" in
attention)
  agent_notify "$session" "$harness" normal "$(agent_name "$project" "$pr" "$harness" "$transcript")" "${message:-Needs your attention}"
  ;;
done)
  $watching && exit 0
  # (a displayed one is idle by now: seen)
  [ -n "$message" ] || message=$(harness_do "$harness" last_words "$transcript")
  agent_notify "$session" "$harness" low "Done: $(agent_name "$project" "$pr" "$harness" "$transcript")" "${message:-Its turn is over}"
  ;;
esac

sound=$(harness_brand "$harness" sound)
case "$state" in
attention | done) $displayed || [ -z "$sound" ] || setsid -f paplay "$sound" >/dev/null 2>&1 ;;
esac

# A turn's end: what it left in its worktree, for local work (see local-work)
case "$state" in "done" | idle) setsid -f "$assets/local-work" >/dev/null 2>&1 ;; esac
