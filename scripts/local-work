#!/usr/bin/env bash
# Work lying on this machine, in the clones of the repositories listed in
# ~/.config/github/repos (see github_clone) and their worktrees (Claude
# agents' included, see claude-agent-worktree): what GitHub can't tell.
# Branches (but the default one) holding commits not pushed, worktrees holding
# uncommitted changes, detached worktrees holding commits on no branch, and
# the worktrees of stopped agents the sweep kept (see claude-agent-sweep).
# Branches pushed as they are, and clean, are in too, for rofi-github to show
# those no pull request of mine holds (its rows tell the rest), but for those
# merged into the default branch already (squashed too, see squashed). Those
# whose upstream is gone are left out (merged, likely: squashed, their commits
# are on no remote branch, so there's no telling what's left to push), unless
# checked out with changes, or kept.
# Local only (as of the last fetch), but not free: a git status takes a
# quarter of a second in a large worktree (finding untracked files), so they
# run side by side, and the result is cached for rofi-github to open at
# once. Refreshed in the background: by the panel (every minute), agents'
# hooks (a turn's end, see claude-agent-state), rofi-github as it opens (for
# the next time), Ctrl+r there. One at a time (a second waits for the
# first). Signals the panel once refreshed.
# Usage: local-work [--cached]  (--cached: print the cache, computing it only
# when there is none)
# Output: tab separated records (see lib/records.sh), most recent first:
#   repo      the repository (owner/repo)
#   clone     its clone (the primary worktree)
#   branch    the branch, or - (a detached worktree)
#   worktree  where it's checked out, or - (nowhere)
#   upstream  yes (pushed once, its remote branch is there), none (never
#             pushed) or gone (its remote branch was deleted)
#   ahead     commits to push: ahead of its upstream (yes), on no remote
#             branch (none), 0 (gone); for a detached worktree, its commits on
#             no branch at all (an agent's: past the commit it started at)
#   changes   uncommitted changes in its worktree (files), 0 when none
#   agent     the session of the live Claude agent working in its worktree,
#             or -
#   kept      yes: a stopped agent's worktree, kept for what it holds; else -
#   time      its last commit (epoch)
# Without repositories to watch, complains and exits 2, as the trackers do.

assets=$(dirname "$(readlink -f "$0")")
# shellcheck source-path=SCRIPTDIR source=lib/github.sh
. "$assets/lib/github.sh"

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/github/local-work"
slots="${XDG_STATE_HOME:-$HOME/.local/state}/claude-agents/slots"
cache="$state_dir/work.tsv"
verdicts="$state_dir/squashed" # see squashed
mkdir -p "$state_dir"
github_repos local-work local-work "Local work not watched" "$state_dir"

[ "$1" = --cached ] && [ -f "$cache" ] && { cat "$cache"; exit 0; }
exec 9>"$state_dir/.lock"
flock -w 30 9 || { cat "$cache" 2>/dev/null; exit 0; }

# Agents by the project they run in: a worktree's directory name (see
# claude-agent-list)
declare -A agent_in=() agent_state_in=()
# shellcheck disable=SC2154,SC2329 # record fields, set by each_record (which calls it)
note_agent() { agent_in[$project]=$session agent_state_in[$project]=$state; }
each_record note_agent < <("$assets/claude-agent-list")

# Agent worktrees' base commits (what claude-agent-worktree started them at:
# a pull request's latest commit, fetched into no ref, for a review), from
# their slot; and the kept ones (claude-agent-sweep marks their slot)
declare -A base_of=() kept=() agent_worktree=()
for slot in "$slots"/*/[0-9]*; do
  [ -f "$slot" ] || continue
  case $slot in
    *.kept) read -r worktree _ <"${slot%.kept}" && kept[$worktree]=yes ;;
    *) read -r worktree base _ <"$slot" && base_of[$worktree]=$base agent_worktree[$worktree]=yes ;;
  esac
done

# Whether <branch> was squash-merged into <default>: a commit there since they
# forked holds its whole change (same patch id). Its remote branch may well
# outlive the merge, as fetches here don't prune (agents fetch single refs),
# so its upstream doesn't read gone. Costs half a second or so (patch ids of
# all of the default branch's commits since), so verdicts are kept in
# $verdicts, one per line: <tip> merged (for good), or <tip> <default's tip>
# no (until the default branch moves); this run's only, rewritten at the end
# Usage: squashed <clone> <branch ref> <default branch ref>
declare -A known=() used=()
if [ -f "$verdicts" ]; then
  while read -r tip verdict; do known[$tip]=$verdict; done <"$verdicts"
fi
squashed() {
  local tip onto base mine verdict
  tip=$(git -C "$1" rev-parse "$2") onto=$(git -C "$1" rev-parse "$3")
  verdict=${known[$tip]}
  if [ "$verdict" != merged ] && [ "$verdict" != "$onto no" ]; then
    verdict="$onto no"
    if base=$(git -C "$1" merge-base "$onto" "$tip"); then
      mine=$(git -C "$1" diff "$base" "$tip" | git patch-id --stable | cut -d' ' -f1)
      [ -n "$mine" ] && git -C "$1" log -p --format='commit %H' "$base..$onto" | git patch-id --stable |
        cut -d' ' -f1 | grep -qxF "$mine" && verdict=merged
    fi
    known[$tip]=$verdict
  fi
  used[$tip]=$verdict
  [ "$verdict" = merged ]
}

rows=()
# Usage: add <repo> <clone> <branch> <worktree> <upstream> <ahead> <changes> <time>
add() {
  local agent=${agent_in[$(basename "$4")]:--}
  [ "$4" = - ] && agent=-
  rows+=("$8"$'\t'"$1"$'\t'"$2"$'\t'"$3"$'\t'"$4"$'\t'"$5"$'\t'"$6"$'\t'"$7"$'\t'"$agent"$'\t'"${kept[$4]:--}"$'\t'"$8")
}

# Uncommitted changes, by worktree: how many files. Counted side by side
# (see count_changes), then read (changes). No optional locks: an agent may
# be committing there, and a status refreshing the index would hold its lock.
# But in an agent worktree whose agent is gone, done or idle (not monitoring:
# what it left running may use git), nobody is: there the status writes the
# index it refreshed back (when its lock is free, else it skips that), lest
# every run pay the refresh again. A stale index takes seconds to refresh in
# a large worktree, and agents' edits leave theirs stale
counts=$(mktemp -d)
trap 'rm -rf "$counts"' EXIT
declare -A count_file=()
count_changes() { # <worktree>...
  local where locks=()
  for where; do
    count_file[$where]="$counts/${#count_file[@]}"
    locks=(--no-optional-locks)
    if [ -n "${agent_worktree[$where]}" ]; then
      case ${agent_state_in[$(basename "$where")]:-gone} in gone | done | idle) locks=() ;; esac
    fi
    git "${locks[@]}" -C "$where" status --porcelain 2>/dev/null | wc -l >"${count_file[$where]}" &
  done
  wait
}
changes() { cat "${count_file[$1]}" 2>/dev/null || echo 0; } # <worktree>

while read -r repo; do
  clone=$(github_clone "$repo") || continue
  default=$(git -C "$clone" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null)
  default=${default#origin/}
  default=${default:-master}

  # Where each branch is checked out; and the detached worktrees
  declare -A checked_out=()
  detached=()
  worktree=''
  while read -r key value; do
    case $key in
      worktree) worktree=$value ;;
      branch) checked_out[${value#refs/heads/}]=$worktree ;;
      detached) detached+=("$worktree") ;;
    esac
  done < <(git -C "$clone" worktree list --porcelain)
  # All but the default branch's (not ours to tell)
  wanted=("${detached[@]}")
  for branch in "${!checked_out[@]}"; do
    [ "$branch" = "$default" ] || wanted+=("${checked_out[$branch]}")
  done
  count_changes "${wanted[@]}"

  # Pushed as it is, and not merged into the default branch (as of the last
  # fetch): a pull request to open, or one rofi-github shows already
  pushed_unmerged() {
    [ "$state" = yes ] || return 1
    git -C "$clone" merge-base --is-ancestor "refs/heads/$branch" "refs/remotes/origin/$default" && return 1
    ! squashed "$clone" "refs/heads/$branch" "refs/remotes/origin/$default"
  }

  # (unit separators between fields: tabs are whitespace to read, which would
  # merge an empty upstream away)
  while IFS=$'\x1f' read -r branch upstream track time; do
    [ "$branch" = "$default" ] && continue
    where=${checked_out[$branch]:--}
    if [ -z "$upstream" ]; then state=none
    elif [ "$track" = '[gone]' ]; then state=gone
    else state=yes; fi
    if [ "$state" = yes ]; then
      ahead=$(git -C "$clone" rev-list --count "$upstream..refs/heads/$branch")
    elif [ "$state" = gone ]; then
      ahead=0 # merged (squashed: its commits on no remote branch), likely
    else
      ahead=$(git -C "$clone" rev-list --count "refs/heads/$branch" --not --remotes)
    fi
    count=0
    [ "$where" != - ] && count=$(changes "$where")
    [ "$ahead" -gt 0 ] || [ "$count" -gt 0 ] || [ -n "${kept[$where]}" ] || pushed_unmerged || continue
    add "$repo" "$clone" "$branch" "$where" "$state" "$ahead" "$count" "$time"
  done < <(git -C "$clone" for-each-ref refs/heads \
    --format='%(refname:short)%1f%(upstream)%1f%(upstream:track)%1f%(committerdate:unix)')

  # (not counting an agent's base commit: not the agent's, and on a remote
  # branch, likely, just not one we track)
  for where in "${detached[@]}"; do
    stray=$(git -C "$where" rev-list --count HEAD --not --branches --remotes ${base_of[$where]:+"${base_of[$where]}"})
    count=$(changes "$where")
    [ "$stray" -gt 0 ] || [ "$count" -gt 0 ] || [ -n "${kept[$where]}" ] || continue
    add "$repo" "$clone" - "$where" none "$stray" "$count" "$(git -C "$where" log -1 --format=%ct)"
  done
  unset checked_out
done < <(grep -vE '^\s*(#|$)' "$github_config")

{
  printf '#repo\tclone\tbranch\tworktree\tupstream\tahead\tchanges\tagent\tkept\ttime\n'
  if [ ${#rows[@]} -gt 0 ]; then printf '%s\n' "${rows[@]}" | sort -t $'\t' -k1,1nr | cut -f2-; fi
} >"$cache.tmp" && mv "$cache.tmp" "$cache"
for tip in "${!used[@]}"; do echo "$tip ${used[$tip]}"; done >"$verdicts.tmp" && mv "$verdicts.tmp" "$verdicts"
cat "$cache"
awesome-client 'awesome.emit_signal("local-work::changed")' >/dev/null 2>&1 9>&- &
exit 0
