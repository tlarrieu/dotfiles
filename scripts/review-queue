#!/usr/bin/env bash
# Pull requests waiting on my review, in the repositories listed in
# ~/.config/github/repos (direct requests only: team ones are left out).
# Refreshes the cache, notifies new requests (and re-requests), reminds once
# for those waiting more than a day, then prints the queue, oldest first.
# Usage: review-queue [--cached]  (--cached: print the cache, skip GitHub)
# Output: tab separated records under a header naming their fields (see
#   lib/github.sh and "header" below): requested at (epoch), repo, number,
#   author, additions, deletions, url, title, ci (the last commit's checks:
#   SUCCESS, FAILURE or PENDING), threads (unresolved review threads, out of
#   the first 100).
# On a GitHub failure, prints the cache (stale) and exits 1.
# Without repositories to watch, complains (notifying once, until fixed) and
# exits 2. That list is private, so it stays out of the dotfiles (gitignored).

assets=$(dirname "$(readlink -f "$0")")
# shellcheck source-path=SCRIPTDIR source=lib/github.sh
. "$assets/lib/github.sh"

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/github/reviews"
queue="$state_dir/queue.tsv"
seen="$state_dir/seen" # notified keys: <repo>#<number>@<requested at>[:stale]
remind_after=$((24 * 3600))

mkdir -p "$state_dir"
touch "$queue" "$seen"

github_repos review-queue reviews "Reviews not watched" "$state_dir"

[ "$1" = --cached ] && { cat "$queue"; exit 0; }

github_lock "$state_dir" "$queue"

read -r -d '' query <<'GRAPHQL'
query($q: String!) {
  viewer { login }
  search(type: ISSUE, first: 100, query: $q) {
    nodes {
      ... on PullRequest {
        number title url additions deletions createdAt
        repository { nameWithOwner }
        author { login }
        CI_FIELDS
        reviewThreads(first: 100) { nodes { isResolved } }
        timelineItems(itemTypes: [REVIEW_REQUESTED_EVENT, READY_FOR_REVIEW_EVENT], last: 50) {
          nodes {
            __typename
            ... on ReviewRequestedEvent { createdAt requestedReviewer { ... on User { login } } }
            ... on ReadyForReviewEvent { createdAt }
          }
        }
      }
    }
  }
}
GRAPHQL
query=${query//CI_FIELDS/$github_ci_query}

# Records, under this header (see lib/github.sh). Requested at (epoch): my
# latest (re-)request, so being added late or re-requested restarts the clock,
# or its latest exit from draft when later: the wait starts once it's ready
header=$'#at\trepo\tnumber\tauthor\tadditions\tdeletions\turl\ttitle\tci\tthreads'
# shellcheck disable=SC2016 # $me and $at are jq variables
fresh=$(timeout 60 gh api graphql -f query="$query" -f q="is:pr is:open draft:false user-review-requested:@me $repos" --jq "$github_ci_jq"'
  .data.viewer.login as $me
  | .data.search.nodes[]
  | ([.timelineItems.nodes[] | select(.requestedReviewer.login == $me) | .createdAt] | last // .createdAt) as $requested
  | ([.timelineItems.nodes[] | select(.__typename == "ReadyForReviewEvent") | .createdAt] | last) as $ready
  | ([$requested, $ready] | max) as $at
  | [($at | fromdateiso8601), .repository.nameWithOwner, .number, (.author.login // "ghost"),
     .additions, .deletions, .url, (.title | gsub("[\t\n]"; " ")),
     ci,
     ([.reviewThreads.nodes[] | select(.isResolved | not)] | length)]
  | @tsv
' 2>/dev/null) || { cat "$queue"; exit 1; }

fresh=$header$'\n'$(sort -n <<<"$fresh" | sed '/^$/d')

notify() { github_notify reviews "$@"; } # <urgency> <title> <body> <url>

first_run=''
[ -f "$state_dir/.initialized" ] || first_run=1
now=$(date +%s)
keys=()

# shellcheck disable=SC2154 # record fields, set by each_record
review() {
  key="$repo#$number@$at"
  keys+=("$key")
  waited=$((now - at))

  if ! grep -qxF "$key" "$seen"; then
    echo "$key" >>"$seen"
    # First run: no flood for the backlog, the summary below covers it
    [ -z "$first_run" ] && [ "$waited" -lt "$remind_after" ] \
      && notify normal "Review requested by $author" "$title"$'\n'"$repo#$number  +$additions −$deletions" "$url"
  fi

  if [ "$waited" -ge "$remind_after" ] && ! grep -qxF "$key:stale" "$seen"; then
    echo "$key:stale" >>"$seen"
    [ -z "$first_run" ] \
      && notify critical "Review waiting for $((waited / 3600))h" "$title"$'\n'"$repo#$number by $author" "$url"
  fi
}
each_record review <<<"$fresh"

if [ -n "$first_run" ]; then
  touch "$state_dir/.initialized"
  count=${#keys[@]}
  [ "$count" -gt 0 ] && notify normal "$count review(s) pending" "Click the panel icon to browse them" \
    "https://github.com/pulls/review-requested"
fi

# Forget what left the queue, so that a re-request notifies again
if [ ${#keys[@]} -gt 0 ]; then
  grep -E "^($(printf '%s\n' "${keys[@]}" | sed 's/[][\.*^$+?(){}|/]/\\&/g' | paste -sd'|'))(:stale)?$" "$seen" >"$seen.tmp"
else
  : >"$seen.tmp"
fi
mv "$seen.tmp" "$seen"

printf '%s\n' "$fresh" | sed '/^$/d' >"$queue.tmp" && mv "$queue.tmp" "$queue"
# Whoever refreshed, the panel follows (it rereads the cache)
awesome-client 'awesome.emit_signal("reviews::changed")' >/dev/null 2>&1
cat "$queue"
