#!/usr/bin/env bash
# Focuses the terminal of an agent: its awesome client, then its kitty tab
# (a background session: a terminal showing it, else a new one attached to
# it; see background and terminals in lib/agents.sh).
# Usage: agent-jump [session_id]
# Without a session, picks the agent that wants us the most: the first one
# needing attention (in agent-list's order), else the first done one,
# else the one we last focused (else the newest one). Fails (and says so) when
# there is no such agent. Not one without a transcript: nothing happened there,
# and some never will (the original of a session sent to the background as
# its first prompt, which lives on showing it; a spare its harness keeps
# ready for the next one)

assets=$(dirname "$(readlink -f "$0")")
# shellcheck source-path=SCRIPTDIR source=lib/agents.sh
. "$assets/lib/agents.sh"
# shellcheck source-path=SCRIPTDIR source=lib/records.sh
. "$assets/lib/records.sh"
target="$1"

if [ -z "$target" ]; then
  declare -A first=()   # session, by state
  declare -A windows=() # session, by window
  newest='' newest_started=0
  # shellcheck disable=SC2154 # record and state file fields, set by each_record and read_agent
  agent() {
    read_agent "$agents_dir/$session" agent_
    [ -f "$agent_transcript" ] || return 0
    [ -n "${first[$state]}" ] || first[$state]=$session
    if [ "$started" -gt "$newest_started" ]; then newest=$session newest_started=$started; fi
    local window _
    case "$agent_window" in
      "" | *[!0-9]*) ;;
      *) windows[$agent_window]=$session ;;
    esac
    # A background one's: those showing it
    [ "$agent_window" = - ] || return 0
    while read -r window _; do windows[$window]=$session; done < <(harness_do "$agent_harness" terminals "$session" "$agent_transcript")
  }
  each_record agent < <("$assets/agent-list")
  target=${first[attention]:-${first[done]:-}}

  if [ -z "$target" ] && [ ${#windows[@]} -gt 0 ]; then
    known=$(printf '[%s]=true,' "${!windows[@]}")
    window=$(awesome-client "
      local agents = { $known }
      for _, c in ipairs(require('awful').client.focus.history.list) do
        if c.valid and agents[c.window] then return tostring(c.window) end
      end
    " 2>/dev/null | awk -F'"' '{ print $2 }')
    [ -n "$window" ] && target=${windows[$window]:-}
  fi
  target=${target:-$newest}
fi

fail() { agents_notify "$1"; exit 1; }

if [ -z "$target" ]; then fail "No agent to jump to (spawn one with 'cl' in rofi-search)"; fi
[ -f "$agents_dir/$target" ] || fail "This agent is gone"
read_agent "$agents_dir/$target"

# Focuses X window <window> (giving it a tag, if it has none); fails when it
# is gone
focus() {
  awesome-client "
    for _, c in ipairs(client.get()) do
      if c.window == $1 then
        if #c:tags() == 0 then require('helpers').create_tag_and_attach_to(c, false) end
        c:jump_to()
        return true
      end
    end
    return false
  " 2>/dev/null | grep -q true
}

# Focuses kitty window <id> of the kitty listening on <socket> (after its X
# window: background agents' must have a tag by the time it asks awesome to
# activate it, see signals.lua)
# Usage: kitty_focus <socket> <id>
kitty_focus() { kitty @ --to "$1" focus-window --match "id:$2" 2>/dev/null; }

# A background session (see background in lib/agents.sh): a terminal
# showing it (see terminals), else a new one attaching to it (see attach), in
# the agents' kitty (see agent-spawn)
# shellcheck disable=SC2154 # set by read_agent
if [ "$window" = - ] && harness_do "$harness" background "$pid"; then
  # Focuses a terminal showing it (exits), if any
  focus_shown() {
    local shown_window shown_socket shown_id
    # shellcheck disable=SC2154 # set by read_agent
    while read -r shown_window shown_socket shown_id; do
      focus "$shown_window" || continue
      [ "$shown_socket" != - ] && [ "$shown_id" != - ] && kitty_focus "$shown_socket" "$shown_id"
      exit 0
    done < <(harness_do "$harness" terminals "$target" "$transcript")
  }
  focus_shown
  attach=$(harness_do "$harness" attach "$target") || fail "Can't open a terminal on this agent: its harness doesn't tell how"
  directory=$HOME
  # shellcheck disable=SC2154 # set by read_agent
  [ -d "$root" ] && directory=$root # (its worktree may be gone)
  setsid -f kitty --single-instance --instance-group agents --name agent \
    --directory "$directory" fish -c "$attach" >/dev/null 2>&1 || fail "Could not open a terminal on this agent"
  # Hidden, without a tag, as all agent windows (see rules.lua): shown
  # once there (awesome manages it), as an attached one
  for _ in {1..50}; do
    sleep 0.1
    focus_shown
  done
  fail "The terminal on this agent didn't show up"
fi

case "$window" in "" | *[!0-9]*) fail "Can't find this agent's terminal" ;; esac
focus "$window" || fail "This agent's terminal is gone"

# Kitty comes second (see kitty_focus)
# shellcheck disable=SC2154 # set by read_agent
[ "$listen_on" != - ] && [ "$kitty_window" != - ] && kitty_focus "$listen_on" "$kitty_window"

# The panel turns the done agent we just displayed into an idle one
awesome-client 'awesome.emit_signal("agents::update")' >/dev/null 2>&1
