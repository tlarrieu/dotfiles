#!/usr/bin/env bash
# Spawns a Claude agent for the current project (~/.project), in a kitty window
# kept in the background (see the claude-agent rule in awesome), with a neovim
# tab next to the agent to inspect what it produces.
# In a git repository, the agent works in its own worktree, with its
# own TEST_ENV_NUMBER (see claude-agent-worktree), so neither its changes nor
# its specs get in the way of ours. claude-agent-setup/<repository> prepares
# the worktree when it exists (<repository>: the name of its origin, else of
# its folder).
# Usage: claude-agent-spawn [prompt...]  (no prompt: interactive session)
# Environment, for scripts spawning agents (see claude-agent-pr):
#   CLAUDE_AGENT_DIR      where to spawn it, instead of the current project
#   CLAUDE_AGENT_AT       the commit its worktree starts at, instead of the
#                         current one (the agent then gets no branch rule)
#   CLAUDE_AGENT_CONTEXT  more instructions, appended to its system prompt
#   CLAUDE_AGENT_PR       the pull request it works on (<owner/repo>#<number>),
#                         passed on to the agent: its state (see
#                         claude-agent-state) records it, for rofi-github

assets=$(dirname "$(readlink -f "$0")")
fail() { notify-send --app-name=claude --icon="$assets/claude.png" Claude "$1"; exit 1; }

# The agent tab removes the files passing it the prompt and context: until it
# is launched, they're ours to clean up
files='' launched=''
trap '[ -n "$launched" ] || rm -f $files' EXIT

# Same current project as awesome's dev window (it may hold a ~)
project=${CLAUDE_AGENT_DIR:-$(cat ~/.project 2>/dev/null)}
project=${project/#\~/$HOME}
[ -d "$project" ] || fail "No project to spawn an agent in (see ~/.project)"

prompt="$*"

# The prompt and the agent's context go through files to dodge session
# quoting: the agent tab reads them, then removes them along with the session
# file, before anything else
spawn_dir="${XDG_RUNTIME_DIR:-/tmp}/claude-agents-spawn"
mkdir -p "$spawn_dir"
session_file=$(mktemp "$spawn_dir/session.XXXXXX")
files=$session_file reads='' setup='' claude_args='' env='' directory=$project

if [ -n "$prompt" ]; then
  prompt_file=$(mktemp "$spawn_dir/prompt.XXXXXX")
  printf '%s' "$prompt" >"$prompt_file"
  reads+="set -l prompt (string collect < $prompt_file); "
  files+=" $prompt_file"
fi

if primary=$(git -C "$project" rev-parse --show-toplevel 2>/dev/null); then
  error_file=$(mktemp "$spawn_dir/error.XXXXXX")
  files+=" $error_file"
  read -r slot directory < <("$assets/claude-agent-worktree" "$primary" ${CLAUDE_AGENT_AT:+"$CLAUDE_AGENT_AT"} 2>"$error_file")
  error=$(cat "$error_file")
  rm -f "$error_file"
  [ -n "$slot" ] || fail "Could not create the agent's worktree: $error"
  base=$(git -C "$primary" branch --show-current)
  base="${base:+$base, }$(git -C "$directory" rev-parse --short HEAD)"
  env="--env TEST_ENV_NUMBER=$slot"

  origin=$(git -C "$primary" remote get-url origin 2>/dev/null)
  hook="$assets/claude-agent-setup/$(basename "${origin:-$primary}" .git)"
  [ -x "$hook" ] || hook="$assets/claude-agent-setup/$(basename "$primary")"
  [ -x "$hook" ] && setup="$hook $primary; or echo \"Worktree setup failed, carrying on\"; "

  head="It sits on a detached HEAD, at the user's current commit ($base): before
your first commit, create a branch named after your work (git switch -c
<name>), and never commit on the detached HEAD."
  [ -n "$CLAUDE_AGENT_AT" ] && head="It sits on a detached HEAD, at $(git -C "$directory" rev-parse --short HEAD)."
  context_file=$(mktemp "$spawn_dir/context.XXXXXX")
  cat >"$context_file" <<CONTEXT
You work in a git worktree of your own, $directory, apart from the user's
checkout ($primary), which you must leave alone: make your changes and run your
commands here. $head TEST_ENV_NUMBER=$slot gives your specs their own
test databases and Redis: keep it as is.
CONTEXT
  [ -n "$CLAUDE_AGENT_CONTEXT" ] && printf '\n%s\n' "$CLAUDE_AGENT_CONTEXT" >>"$context_file"
  reads+="set -l context (string collect < $context_file); "
  files+=" $context_file"
  claude_args="--append-system-prompt \$context "
fi

# The agent's pull request goes in its environment, for its hooks
agent_env=$env
[ -n "$CLAUDE_AGENT_PR" ] && agent_env+=" --env 'CLAUDE_AGENT_PR=$CLAUDE_AGENT_PR'" # quoted: kitty may read # as a comment

# Fish loads the claude function, which brings the settings from my dotfiles.
# Once the agent stops, its whole window goes (see claude-agent-sweep for its
# worktree), unless claude failed: then it waits, so that we can read why.
# "--" ends claude's options: a prompt may start with a dash.
agent="${reads}rm -f $files; ${setup}claude $claude_args"
[ -n "$prompt" ] && agent+="-- \$prompt"
agent+="; set -l code \$status"
agent+="; if test \$code -ne 0; echo; echo \"claude exited with status \$code: press Enter to close\"; read; end"
agent+="; $assets/claude-agent-close-window"

cat >"$session_file" <<SESSION
new_tab
cd $directory
launch $agent_env fish -c '$agent'
new_tab
cd $directory
launch $env fish -c nvim
SESSION

# A kitty of their own: opening an agent window in ours would make it draw
# its focused window as unfocused (kitty deems the new one focused)
setsid -f kitty --single-instance --instance-group claude-agents --name claude-agent \
  --session "$session_file" >/dev/null 2>&1
launched=1
