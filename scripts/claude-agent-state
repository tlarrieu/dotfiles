#!/usr/bin/env bash
# Claude Code hook: tracks agent state for the awesome panel widget.
# Usage (from hooks): claude-agent-state <running|done|attention|end>
# State files: $XDG_RUNTIME_DIR/claude-agents/<session_id> =>
#   "<state> <pid> <started> <x_window> <kitty_listen_on> <kitty_window> <project> <transcript> <since>"
# where <since> is when the current turn started (last prompt submission).
# A "done" session whose terminal is on screen is stored as "idle" (already seen);
# the panel turns the remaining "done" ones into "idle" once they get displayed.

state="$1"
input=$(cat)

# Skip subagents: only the main agent matters
[ -n "$(jq -r '.agent_id // empty' <<<"$input")" ] && exit 0

# Only idle reminders and auth notices do not require attention
if [ "$state" = attention ]; then
  case "$(jq -r '.notification_type // empty' <<<"$input")" in
    idle_prompt | auth_success) exit 0 ;;
  esac
fi

session=$(jq -r '.session_id // empty' <<<"$input")
[ -n "$session" ] || exit 0

dir="${XDG_RUNTIME_DIR:-/tmp}/claude-agents"
file="$dir/$session"
mkdir -p "$dir"

refresh_panel() { awesome-client 'awesome.emit_signal("claude::update")' >/dev/null 2>&1 & }

if [ "$state" = end ]; then
  rm -f "$file"
  refresh_panel
  exit 0
fi

# Find the claude process owning this hook (used to prune crashed sessions)
pid=$PPID
while [ "$pid" -gt 1 ] && [ "$(cat /proc/"$pid"/comm 2>/dev/null)" != claude ]; do
  pid=$(awk '{ print $4 }' /proc/"$pid"/stat 2>/dev/null || echo 1)
done

assets=$(dirname "$(readlink -f "$0")")
window=${WINDOWID:--} listen_on=${KITTY_LISTEN_ON:--} kitty_window=${KITTY_WINDOW_ID:--}

displayed=false
case "$state" in
attention | done) "$assets/claude-agent-displayed" "$window" "$listen_on" "$kitty_window" && displayed=true ;;
esac
[ "$state" = "done" ] && $displayed && state=idle

read -r previous _ started _ _ _ _ _ since 2>/dev/null <"$file"
# A prompt starts a new turn, even when an interrupt (which fires no hook) left
# the session as running
if [ "$(jq -r '.hook_event_name // empty' <<<"$input")" = UserPromptSubmit ]; then
  since=$(date +%s)
elif [ "$previous" = "$state" ]; then
  exit 0 # nothing changed, avoid pinging awesome
fi

transcript=$(jq -r '.transcript_path // empty' <<<"$input")
# Project: name of the git repository holding the session's cwd, else the cwd itself
cwd=$(jq -r '.cwd // empty' <<<"$input")
cwd=${cwd:-$PWD}
root=$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null || echo "$cwd")
project=$(basename "$root")
project=${project//[[:space:]]/_}
echo "$state $pid ${started:-$(date +%s)} $window $listen_on $kitty_window $project ${transcript:--} ${since:-$(date +%s)}" >"$file"
refresh_panel

if [ "$state" = attention ]; then
  message=$(jq -r '
    .message // .tool_input.questions[0].question //
    (.tool_name | select(.) | "Wants to use \(.)") // "Needs your attention"
  ' <<<"$input")
  notify-send --app-name=claude --icon="$assets/claude.png" Claude "$message"
fi

case "$state" in
attention | done) $displayed || setsid -f paplay "$assets/claude.ogg" >/dev/null 2>&1 ;;
esac
