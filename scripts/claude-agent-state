#!/usr/bin/env bash
# Claude Code hook: tracks agent state for the awesome panel widget.
# Usage (from hooks): claude-agent-state <idle|running|done|attention|end|subagent>
# (idle: a session just started, resumed or cleared: tracked, but nothing to tell)
# State files: $XDG_RUNTIME_DIR/claude-agents/<session_id>, see
# lib/claude-agents.sh for their fields (<since>: when the current turn
# started, i.e. the last prompt submission).
# A "done" session whose terminal is on screen is stored as "idle" (already seen);
# the panel turns the remaining "done" ones into "idle" once they get displayed.
# Live subagents are tracked as $XDG_RUNTIME_DIR/claude-agents/<session_id>.subagents/<agent_id>
# markers (touched on each of their tool uses), so that a session whose main
# agent is done still shows as running while subagents work. Subagents needing
# us mark the session for attention, as the main agent does.

state="$1"
input=$(cat)

session=$(jq -r '.session_id // empty' <<<"$input")
[ -n "$session" ] || exit 0

assets=$(dirname "$(readlink -f "$0")")
# shellcheck source-path=SCRIPTDIR source=lib/claude-agents.sh
. "$assets/lib/claude-agents.sh"

file="$agents_dir/$session"
subagents="$file.subagents"
mkdir -p "$agents_dir"

refresh_panel() { awesome-client 'awesome.emit_signal("claude::update")' >/dev/null 2>&1 & }

# Only idle reminders and auth notices do not require attention
if [ "$state" = attention ]; then
  case "$(jq -r '.notification_type // empty' <<<"$input")" in
    idle_prompt | auth_success) exit 0 ;;
  esac
fi

# Subagents keep their session marked as running, and surface their requests
# for attention on it. A marker holding "attention" is a subagent waiting for us:
# its next tool use (or its end) puts the session back to running.
agent=$(jq -r '.agent_id // empty' <<<"$input")
if [ -n "$agent" ]; then
  marker="$subagents/$agent"
  waiting=false
  [ "$(cat "$marker" 2>/dev/null)" = attention ] && waiting=true
  case "$state" in
  subagent)
    if [ "$(jq -r '.hook_event_name // empty' <<<"$input")" = SubagentStop ]; then
      rm -f "$marker"
      rmdir "$subagents" 2>/dev/null
      $waiting || { refresh_panel; exit 0; }
      state=running
    else
      mkdir -p "$subagents" && touch "$marker"
      refresh_panel
      exit 0
    fi
    ;;
  running)
    [ -f "$marker" ] || exit 0
    : >"$marker" # empties it, and refreshes its mtime
    $waiting || exit 0
    ;;
  attention) mkdir -p "$subagents" && echo attention >"$marker" ;;
  *) exit 0 ;;
  esac
fi
[ "$state" = subagent ] && exit 0

if [ "$state" = end ]; then
  rm -rf "$file" "$subagents"
  refresh_panel
  exit 0
fi

# Find the claude process owning this hook (used to prune crashed sessions)
pid=$PPID
while [ "$pid" -gt 1 ] && [ "$(cat /proc/"$pid"/comm 2>/dev/null)" != claude ]; do
  pid=$(awk '{ print $4 }' /proc/"$pid"/stat 2>/dev/null || echo 1)
done

window=${WINDOWID:--} listen_on=${KITTY_LISTEN_ON:--} kitty_window=${KITTY_WINDOW_ID:--}

displayed=false
case "$state" in
attention | done) "$assets/claude-agent-displayed" "$window" "$listen_on" "$kitty_window" && displayed=true ;;
esac
[ "$state" = "done" ] && $displayed && state=idle

read_agent "$file" previous_
# shellcheck disable=SC2034 # these fields are written by name (write_agent)
started=${previous_started:-$(date +%s)} since=${previous_since:-$(date +%s)}
# A prompt starts a new turn, even when an interrupt (which fires no hook) left
# the session as running
# shellcheck disable=SC2034,SC2154 # since is written by write_agent, previous_state set by read_agent
if [ "$(jq -r '.hook_event_name // empty' <<<"$input")" = UserPromptSubmit ]; then
  since=$(date +%s)
elif [ "$previous_state" = "$state" ]; then
  exit 0 # nothing changed, avoid pinging awesome
fi

# shellcheck disable=SC2034 # written by write_agent
transcript=$(jq -r '.transcript_path // empty' <<<"$input")
# Project: name of the git repository holding the session's cwd, else the cwd itself
cwd=$(jq -r '.cwd // empty' <<<"$input")
cwd=${cwd:-$PWD}
root=$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null || echo "$cwd")
project=$(basename "$root")
project=${project//[[:space:]]/_}
# The pull request it works on: set by claude-agent-spawn for
# claude-agent-pr's agents, else (started before it was) found once from the
# transcript
# shellcheck disable=SC2034,SC2154 # written by write_agent; previous_pr set by read_agent
pr=${CLAUDE_AGENT_PR:-${previous_pr:--}}
[ "$pr" = - ] && pr=$(agent_pr "$transcript") && pr=${pr:--}
write_agent "$file"
refresh_panel

if [ "$state" = attention ]; then
  message=$(jq -r '
    .message // .tool_input.questions[0].question //
    (.tool_name | select(.) | "Wants to use \(.)") // "Needs your attention"
  ' <<<"$input")
  notify-send --app-name=claude --icon="$assets/claude.png" Claude "$message"
fi

case "$state" in
attention | done) $displayed || setsid -f paplay "$assets/claude.ogg" >/dev/null 2>&1 ;;
esac
