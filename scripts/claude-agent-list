#!/usr/bin/env bash
# Lists live Claude agents (fed by claude-agent-state hooks):
#   <started> <state> <since> <session> <project>
# Ordered by project (main jeancaisse, main dotfiles, jeancaisse agent worktrees
# by slot, then the others by name), then by start time.
# <since> is when the current turn started ("-" when unknown).
# Prunes sessions whose process died.
# Interrupts (rejected question/permission, Esc) fire no hook, so a busy
# session whose transcript ends with an interrupt marker is reported as idle.
# Done sessions become idle (and stay so) once their terminal gets displayed.
# Sessions with live subagents are reported as running. Subagents silent for
# 10 minutes are deemed gone (in case their SubagentStop hook never fired),
# unless they wait for us.

assets=$(dirname "$(readlink -f "$0")")

interrupted() {
  [ -f "$1" ] && tail -n 50 "$1" | jq -se '
    [.[] | select(.type == "user" or .type == "assistant")] | last | .message.content
    | (if type == "array" then .[0].text // "" else . end)
    | startswith("[Request interrupted by user")
  ' >/dev/null 2>&1
}

for f in "${XDG_RUNTIME_DIR:-/tmp}"/claude-agents/*; do
  if [ -d "$f" ]; then
    [ -f "${f%.subagents}" ] || rm -rf "$f" # session gone
    continue
  fi
  [ -f "$f" ] || continue
  read -r state pid started window listen_on kitty_window project transcript since <"$f"
  if ! kill -0 "$pid" 2>/dev/null; then rm -rf "$f" "$f.subagents"; continue; fi
  case "$state" in
  running | attention) interrupted "$transcript" && state=idle ;;
  done)
    if "$assets/claude-agent-displayed" "$window" "$listen_on" "$kitty_window"; then
      state=idle
      sed -i '1s/^done /idle /' "$f"
    fi
    ;;
  esac
  if [ -d "$f.subagents" ]; then
    find "$f.subagents" -type f -empty -mmin +10 -delete
    rmdir "$f.subagents" 2>/dev/null
    case "$state" in done | idle) [ -d "$f.subagents" ] && state=running ;; esac
  fi
  echo "$started $state ${since:--} $(basename "$f") $project"
done | awk '{
  rank = 3; slot = 0
  if ($5 == "jeancaisse") rank = 0
  else if ($5 == "dotfiles") rank = 1
  else if ($5 ~ /^jeancaisse-[0-9]+$/) { rank = 2; slot = substr($5, 12) }
  print rank, slot, $5, $0
}' | sort -k1,1n -k2,2n -k3,3 -k4,4n | cut -d' ' -f4-
