#!/usr/bin/env bash
# Focuses the terminal of a Claude agent: its awesome client, then its kitty tab.
# Usage: claude-agent-jump [session_id]
# Without a session, picks the agent that wants us the most: the oldest one
# needing attention, else the oldest done one, else the one we last focused
# (else the newest one). Fails when there is no agent.

assets=$(dirname "$(readlink -f "$0")")
dir="${XDG_RUNTIME_DIR:-/tmp}/claude-agents"
session="$1"

if [ -z "$session" ]; then
  agents=$("$assets/claude-agent-list")
  for wanted in "attention" "done"; do
    session=$(awk -v s="$wanted" '$2 == s { print $4; exit }' <<<"$agents")
    [ -n "$session" ] && break
  done
fi

if [ -z "$session" ]; then
  declare -A sessions=() # by window
  while read -r _ _ _ id _; do
    read -r _ _ _ window _ <"$dir/$id"
    case "$window" in "" | *[!0-9]*) ;; *) sessions[$window]=$id ;; esac
  done <<<"$agents"
  if [ ${#sessions[@]} -gt 0 ]; then
    windows=$(printf '[%s]=true,' "${!sessions[@]}")
    window=$(awesome-client "
      local agents = { $windows }
      for _, c in ipairs(require('awful').client.focus.history.list) do
        if c.valid and agents[c.window] then return tostring(c.window) end
      end
    " 2>/dev/null | awk -F'"' '{ print $2 }')
    session=${sessions[$window]:-}
  fi
  [ -n "$session" ] || session=$(awk '{ print $1, $4 }' <<<"$agents" | sort -n | awk 'END { print $2 }')
fi

[ -n "$session" ] && [ -f "$dir/$session" ] || exit 1
read -r _ _ _ window listen_on kitty_window _ <"$dir/$session"

case "$window" in "" | *[!0-9]*) exit 1 ;; esac
awesome-client "
  for _, c in ipairs(client.get()) do
    if c.window == $window then
      if #c:tags() == 0 then require('helpers').create_tag_and_attach_to(c, false) end
      c:jump_to()
      return
    end
  end
" >/dev/null

# Kitty comes second: background agents must have a tag by the time it asks
# awesome to activate their window (see signals.lua)
if [ "$listen_on" != - ] && [ "$kitty_window" != - ]; then
  kitty @ --to "$listen_on" focus-window --match "id:$kitty_window" 2>/dev/null
fi

# The panel turns the done agent we just displayed into an idle one
awesome-client 'awesome.emit_signal("claude::update")' >/dev/null 2>&1
