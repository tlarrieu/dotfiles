#!/usr/bin/env bash
# Focuses the terminal of a Claude agent: its awesome client, then its kitty tab.
# Usage: claude-agent-jump [session_id]
# Without a session, picks the agent that wants us the most: the first one
# needing attention (in claude-agent-list's order), else the first done one,
# else the one we last focused (else the newest one). Fails when there is no
# agent.

assets=$(dirname "$(readlink -f "$0")")
# shellcheck source-path=SCRIPTDIR source=lib/claude-agents.sh
. "$assets/lib/claude-agents.sh"
# shellcheck source-path=SCRIPTDIR source=lib/records.sh
. "$assets/lib/records.sh"
target="$1"

if [ -z "$target" ]; then
  declare -A first=()   # session, by state
  declare -A windows=() # session, by window
  newest='' newest_started=0
  # shellcheck disable=SC2154 # record and state file fields, set by each_record and read_agent
  agent() {
    [ -n "${first[$state]}" ] || first[$state]=$session
    if [ "$started" -gt "$newest_started" ]; then newest=$session newest_started=$started; fi
    read_agent "$agents_dir/$session" agent_
    case "$agent_window" in "" | *[!0-9]*) ;; *) windows[$agent_window]=$session ;; esac
  }
  each_record agent < <("$assets/claude-agent-list")
  target=${first[attention]:-${first[done]:-}}

  if [ -z "$target" ] && [ ${#windows[@]} -gt 0 ]; then
    known=$(printf '[%s]=true,' "${!windows[@]}")
    window=$(awesome-client "
      local agents = { $known }
      for _, c in ipairs(require('awful').client.focus.history.list) do
        if c.valid and agents[c.window] then return tostring(c.window) end
      end
    " 2>/dev/null | awk -F'"' '{ print $2 }')
    [ -n "$window" ] && target=${windows[$window]:-}
  fi
  target=${target:-$newest}
fi

[ -n "$target" ] && [ -f "$agents_dir/$target" ] || exit 1
read_agent "$agents_dir/$target"

case "$window" in "" | *[!0-9]*) exit 1 ;; esac
awesome-client "
  for _, c in ipairs(client.get()) do
    if c.window == $window then
      if #c:tags() == 0 then require('helpers').create_tag_and_attach_to(c, false) end
      c:jump_to()
      return
    end
  end
" >/dev/null

# Kitty comes second: background agents must have a tag by the time it asks
# awesome to activate their window (see signals.lua)
# shellcheck disable=SC2154 # set by read_agent
if [ "$listen_on" != - ] && [ "$kitty_window" != - ]; then
  kitty @ --to "$listen_on" focus-window --match "id:$kitty_window" 2>/dev/null
fi

# The panel turns the done agent we just displayed into an idle one
awesome-client 'awesome.emit_signal("claude::update")' >/dev/null 2>&1
