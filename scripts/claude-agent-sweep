#!/usr/bin/env bash
# Drops the worktrees of stopped Claude agents (see claude-agent-worktree), the
# ones no claude runs in anymore (whatever else does, left behind by them or
# us, a rubocop server, an nvim, is stopped with them). Those holding uncommitted changes are kept
# (we get told once), as are the branches the agent committed on, the one its
# worktree started on (see claude-agent-worktree), and the worktrees holding
# commits on no branch (made on the detached HEAD).
# Usage: claude-agent-sweep [--wait <seconds>]
# --wait gives processes time to exit, e.g. right after closing an agent window.

wait=0
[ "$1" = --wait ] && wait=$2
deadline=$(($(date +%s) + wait))
slots="${XDG_STATE_HOME:-$HOME/.local/state}/claude-agents/slots"
assets=$(dirname "$(readlink -f "$0")")

# This sweep and what runs it (a shell within a worktree, say): not ours to stop
ours=" $$ " pid=$PPID
while [ "${pid:-1}" -gt 1 ]; do
  ours+="$pid "
  pid=$(ps -o ppid= -p "$pid" | tr -d ' ')
done

# The processes running within the worktree $1, one pid a line, but ours (one
# find for all of them: a readlink each took over half a second)
processes() {
  local pid
  for pid in $(find /proc/[0-9]*/cwd -maxdepth 0 \( -lname "$1" -o -lname "$1/*" \) 2>/dev/null \
    | sed 's|^/proc/\([0-9]*\)/cwd$|\1|'); do
    [[ $ours == *" $pid "* ]] || echo "$pid"
  done
}

# Whether a claude runs within the worktree $1, working or waiting
busy() {
  local pid comm
  for pid in $(processes "$1"); do
    read -r comm 2>/dev/null </proc/"$pid"/comm && [ "$comm" = claude ] && return 0
  done
  return 1
}

# Stops what else runs within the worktree $1 (killed if still there after
# 2 seconds)
stop() {
  local pids ours="$ours$BASHPID " # run from a subshell: that one's ours too
  pids=$(processes "$1")
  [ -n "$pids" ] || return 0
  # shellcheck disable=SC2086 # one pid a word
  kill $pids 2>/dev/null
  for _ in 1 2 3 4; do
    [ -n "$(processes "$1")" ] || return 0
    sleep 0.5
  done
  # shellcheck disable=SC2046 # one pid a word
  kill -9 $(processes "$1") 2>/dev/null
}

# Whether slot file $1 was written within the last minute: its agent may not
# run in the worktree yet (kitty takes a moment to start in it)
fresh() { [ -n "$(find "$1" -mmin -1 -print -quit 2>/dev/null)" ]; }

idle() {
  while busy "$1"; do
    [ "$(date +%s)" -lt "$deadline" ] || return 1
    sleep 0.5
  done
}

for repository in "$slots"/*/; do
  [ -d "$repository" ] || continue
  for slot_file in "$repository"[0-9]*; do
    [[ $(basename "$slot_file") =~ ^[0-9]+$ ]] || continue # not the .kept markers
    read -r worktree base started <"$slot_file"
    if [ ! -d "$worktree" ]; then
      rm -f "$slot_file" "$slot_file.kept"
      continue
    fi
    fresh "$slot_file" && continue
    idle "$worktree" || continue

    primary=$(dirname "$(git -C "$worktree" rev-parse --path-format=absolute --git-common-dir)")
    kept=''
    if [ -n "$(git -C "$worktree" status --porcelain)" ]; then
      kept='uncommitted changes'
    elif [ -z "$(git -C "$worktree" branch --show-current)" ] &&
      [ "$(git -C "$worktree" rev-list --count HEAD ${base:+"^$base"} --not --branches)" != 0 ]; then
      kept='commits on no branch'
    fi
    if [ -n "$kept" ]; then
      if [ ! -e "$slot_file.kept" ]; then
        notify-send --app-name=claude --icon="$assets/claude.png" Claude \
          "Kept the worktree of a stopped agent, as it holds $kept: $worktree"
        touch "$slot_file.kept"
      fi
      continue
    fi

    # Spawns must not grab the slot while we free it
    (
      flock 9
      fresh "$slot_file" && exit # taken again while we waited
      busy "$worktree" && exit
      branch=$(git -C "$worktree" branch --show-current)
      stop "$worktree"
      git -C "$primary" worktree remove "$worktree" || exit
      rm -f "$slot_file" "$slot_file.kept"
      # Slots older than the base recording: compare to the primary's HEAD
      base=${base:-$(git -C "$primary" rev-parse HEAD)}
      if [ -n "$branch" ] && [ "$branch" != "$started" ] && [ "$(git -C "$primary" rev-list --count "$base..$branch")" = 0 ]; then
        git -C "$primary" branch --quiet -D "$branch"
      fi
    ) 9>"$repository/.lock"
  done
done
