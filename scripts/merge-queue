#!/usr/bin/env bash
# My pull requests in the merge queue, those ready to join it (approved,
# checks green, mergeable, not queued yet) and my other open ones (with what
# blocks them), in the repositories listed in
# ~/.config/github/repos. Refreshes the cache and notifies, once each: checks
# started on an entry, merge expected within 15 minutes, merged, kicked out of
# the queue (with GitHub's reason), ready to enqueue (unless auto-merge is
# on). Then prints the cache.
# Usage: merge-queue [--cached]  (--cached: print the cache, skip GitHub)
# Output: tab separated records under a header naming their fields (see
#   lib/github.sh, and "header" below for what they hold): kind (queued,
#   ready or other), repo, number, position, state, time, additions,
#   deletions, auto, url, queue_url, title, enqueued_at (- when not
#   applicable).
# On a GitHub failure, prints the cache (stale) and exits 1.
# Without repositories to watch, complains (notifying once, until fixed) and
# exits 2.

assets=$(dirname "$(readlink -f "$0")")
# shellcheck source-path=SCRIPTDIR source=lib/github.sh
. "$assets/lib/github.sh"

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/github/merge-queue"
cache="$state_dir/queue.tsv"
queued="$state_dir/queued" # entries seen in the queue last time: <repo> <number> <enqueued at>
seen="$state_dir/seen"     # notified keys: <repo>#<number>@<enqueued at>:<event>, <repo>#<number>:ready
near=$((15 * 60))

mkdir -p "$state_dir"
touch "$cache" "$queued" "$seen"

github_repos merge-queue merge-queue "Merge queue not watched" "$state_dir"

[ "$1" = --cached ] && { cat "$cache"; exit 0; }

github_lock "$state_dir" "$cache"

read -r -d '' query <<'GRAPHQL'
query($q: String!) {
  search(type: ISSUE, first: 100, query: $q) {
    nodes {
      ... on PullRequest {
        number title url baseRefName isDraft updatedAt reviewDecision mergeable additions deletions
        autoMergeRequest { enabledAt }
        repository { nameWithOwner }
        mergeQueueEntry { position state estimatedTimeToMerge enqueuedAt }
        commits(last: 1) { nodes { commit { statusCheckRollup { state } } } }
      }
    }
  }
}
GRAPHQL

# Records, under this header (see lib/github.sh), in lifecycle order: drafts, other PRs that can't join the queue yet (by
# blocker), ready, then queued (by position). An other PR's state is its
# first blocker: DRAFT, CONFLICT, CHECKS_FAILING, CHANGES_REQUESTED,
# CHECKS_PENDING, REVIEW_REQUIRED, or UNKNOWN (mergeable is UNKNOWN until
# GitHub computes it: not ready yet, next time maybe).
# Time: estimated seconds to merge (queued), last update epoch (other), or -.
# Auto: auto when auto-merge is on, else -.
header=$'#kind\trepo\tnumber\tposition\tstate\ttime\tadditions\tdeletions\tauto\turl\tqueue_url\ttitle\tenqueued_at'
# shellcheck disable=SC2016 # $e, $c, $auto, $title, $queue and $blocker are jq variables
fresh=$(timeout 60 gh api graphql -f query="$query" -f q="is:pr is:open author:@me $repos" --jq '
  ["DRAFT", "CONFLICT", "CHECKS_FAILING", "CHANGES_REQUESTED", "CHECKS_PENDING", "REVIEW_REQUIRED", "UNKNOWN"] as $blockers
  | [ .data.search.nodes[]
      | (.title | gsub("[\t\n]"; " ")) as $title
      | "https://github.com/\(.repository.nameWithOwner)/queue/\(.baseRefName)" as $queue
      | (.commits.nodes[0].commit.statusCheckRollup.state // "SUCCESS") as $c
      | (if .autoMergeRequest then "auto" else "-" end) as $auto
      | if .mergeQueueEntry then
          .mergeQueueEntry as $e
          | { rank: [2, $e.position],
              row: ["queued", .repository.nameWithOwner, .number, $e.position, $e.state,
                    ($e.estimatedTimeToMerge // "-"), .additions, .deletions, $auto, .url, $queue, $title, $e.enqueuedAt] }
        else
          (if .isDraft then "DRAFT"
           elif .mergeable == "CONFLICTING" then "CONFLICT"
           elif $c == "FAILURE" or $c == "ERROR" then "CHECKS_FAILING"
           elif .reviewDecision == "CHANGES_REQUESTED" then "CHANGES_REQUESTED"
           elif $c != "SUCCESS" then "CHECKS_PENDING"
           elif .reviewDecision != "APPROVED" then "REVIEW_REQUIRED"
           elif .mergeable != "MERGEABLE" then "UNKNOWN"
           else "READY" end) as $blocker
          | if $blocker == "READY" then
              { rank: [1, .number],
                row: ["ready", .repository.nameWithOwner, .number, "-", "READY", "-", .additions, .deletions, $auto, .url, $queue, $title, "-"] }
            else
              { rank: [0, ($blockers | index($blocker)), -(.updatedAt | fromdateiso8601)],
                row: ["other", .repository.nameWithOwner, .number, "-", $blocker,
                      (.updatedAt | fromdateiso8601), .additions, .deletions, $auto, .url, $queue, $title, "-"] }
            end
        end ]
  | sort_by(.rank) | .[].row
  | @tsv
' 2>/dev/null) || { cat "$cache"; exit 1; }

fresh=$header$'\n'$(sed '/^$/d' <<<"$fresh")

notify() { github_notify merge-queue "$@"; } # <urgency> <title> <body> <url>

once() { # <key>: true the first time a key is seen (and remembers it)
  grep -qxF "$1" "$seen" && return 1
  echo "$1" >>"$seen"
  # First run: remember silently, no flood for what's already there
  [ -f "$state_dir/.initialized" ]
}

keys=()
current=''

# shellcheck disable=SC2154 # record fields, set by each_record
pull_request() {
  [ "$kind" = other ] && return # nothing to tell until it's ready

  if [ "$kind" = ready ]; then
    [ "$auto" = auto ] && return # GitHub enqueues it by itself
    keys+=("$repo#$number:ready")
    once "$repo#$number:ready" && notify normal "Ready to enqueue" "$title"$'\n'"$repo#$number" "$url"
    return
  fi

  current+="$repo"$'\t'"$number"$'\t'"$enqueued_at"$'\n'
  entry="$repo#$number@$enqueued_at"
  keys+=("$entry:checks" "$entry:near")

  # Being tested in a merge group (MERGEABLE: already passed, between polls)
  if [ "$state" = AWAITING_CHECKS ] || [ "$state" = MERGEABLE ]; then
    once "$entry:checks" && notify normal "Merge queue checks started" "$title"$'\n'"$repo#$number, position $position" "$url"
  fi

  if [ "$time" != - ] && [ "$time" -le "$near" ]; then
    once "$entry:near" && notify normal "Merging in about $(((time + 59) / 60)) min" "$title"$'\n'"$repo#$number, position $position" "$url"
  fi
}
each_record pull_request <<<"$fresh"

# Entries gone from the queue: merged, or kicked out (GitHub tells us why)
read -r -d '' left_query <<'GRAPHQL'
query($owner: String!, $name: String!, $number: Int!) {
  repository(owner: $owner, name: $name) {
    pullRequest(number: $number) {
      merged state title url
      timelineItems(itemTypes: [REMOVED_FROM_MERGE_QUEUE_EVENT], last: 1) {
        nodes { ... on RemovedFromMergeQueueEvent { reason } }
      }
    }
  }
}
GRAPHQL

while IFS=$'\t' read -r repo number enqueued; do
  [ -n "$repo" ] || continue
  grep -qxF "$repo"$'\t'"$number"$'\t'"$enqueued" <<<"$current" && continue

  left=$(timeout 60 gh api graphql -f query="$left_query" -f owner="${repo%/*}" -f name="${repo#*/}" -F number="$number" --jq '
    .data.repository.pullRequest
    | [(if .merged then "merged" else (.timelineItems.nodes[0].reason // (.state | ascii_downcase)) end),
       .url, (.title | gsub("[\t\n]"; " "))]
    | @tsv
  ' 2>/dev/null) || { current+="$repo"$'\t'"$number"$'\t'"$enqueued"$'\n'; continue; } # retry next time
  IFS=$'\t' read -r reason url title <<<"$left"

  [ -f "$state_dir/.initialized" ] || continue
  case $reason in
    merged) notify normal "Merged" "$title"$'\n'"$repo#$number" "$url" ;;
    manual) notify normal "Removed from the merge queue" "$title"$'\n'"$repo#$number" "$url" ;;
    *) notify critical "Kicked out of the merge queue: ${reason//_/ }" "$title"$'\n'"$repo#$number" "$url/checks" ;;
  esac
done <"$queued"

printf '%s' "$current" >"$queued"

# Forget what's gone, so that a new entry (or readiness) notifies again
if [ ${#keys[@]} -gt 0 ]; then
  grep -xF -f <(printf '%s\n' "${keys[@]}") "$seen" >"$seen.tmp"
else
  : >"$seen.tmp"
fi
mv "$seen.tmp" "$seen"
touch "$state_dir/.initialized"

printf '%s\n' "$fresh" >"$cache.tmp" && mv "$cache.tmp" "$cache"
# Whoever refreshed, the panel follows (it rereads the cache)
awesome-client 'awesome.emit_signal("merge-queue::changed")' >/dev/null 2>&1
cat "$cache"
