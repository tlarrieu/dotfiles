#!/usr/bin/env bash
# My pull requests in the merge queue, those ready to join it (approved,
# checks green, mergeable, not queued yet) and my other open ones (with what
# blocks them), in the repositories listed in
# ~/.config/github/repos. Refreshes the cache and notifies, once each: checks
# started on an entry, merge expected within 15 minutes, merged, kicked out of
# the queue (with GitHub's reason), ready to enqueue (unless auto-merge is
# on), being deployed to production, deployed. Then prints the cache. Once
# deployed, a pull request stays listed for $recent_window seconds.
# Deploys: a repository's latest GitHub release is what production runs (its
# deploy workflow publishes one once deployed). While a run of
# $deploy_workflow is in progress, it deploys the last commit of master
# $tested_workflow had passed when it started (as the workflow itself picks
# it). Repositories without releases aren't tracked; without those
# workflows, they only tell deployed.
# Usage: merge-queue [--cached]  (--cached: print the cache, skip GitHub)
# Output: tab separated records under a header naming their fields (see
#   lib/github.sh, and "fields" below for what they hold): kind (queued,
#   ready, other, deploying or deployed), repo, number, position, state, label, time, additions,
#   deletions, auto, url, queue_url, title, enqueued_at, ci, review, threads,
#   verdicts (- when not applicable).
# On a GitHub failure, prints the cache (stale) and exits 1.
# Without repositories to watch, complains (notifying once, until fixed) and
# exits 2.

assets=$(dirname "$(readlink -f "$0")")
# shellcheck source-path=SCRIPTDIR source=lib/github.sh
. "$assets/lib/github.sh"

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/github/merge-queue"
cache="$state_dir/queue.tsv"
queued="$state_dir/queued" # entries seen in the queue last time: <repo> <number> <enqueued at>
seen="$state_dir/seen"     # notified keys: <repo>#<number>@<enqueued at>:<event>, <repo>#<number>:ready,
                           # <repo>#<number>:deploying@<run id>, <repo>#<number>:deployed
near=$((15 * 60))
deploy_workflow=eks_deployment.yml tested_workflow=specs.yml
deploy_window=7 # days after merging to see it deployed (weekends, freezes): older ones are dropped
recent_window=$((2 * 3600)) # seconds a deployed one stays listed, once in production
deployed_at="$state_dir/deployed" # deployed ones, while listed: <repo>#<number> <epoch it reached production>

mkdir -p "$state_dir"
touch "$cache" "$queued" "$seen" "$deployed_at"

github_repos merge-queue merge-queue "Merge queue not watched" "$state_dir"

[ "$1" = --cached ] && { cat "$cache"; exit 0; }

github_lock "$state_dir" "$cache"

# What we read of each pull request (see github_search_prs)
read -r -d '' selection <<'GRAPHQL'
number title url baseRefName isDraft updatedAt reviewDecision mergeable additions deletions
repository { nameWithOwner }
autoMergeRequest { enabledAt }
mergeQueueEntry { position state estimatedTimeToMerge enqueuedAt }
CI_FIELDS
reviewThreads(first: 100) { nodes { isResolved } }
latestReviews(first: 20) { nodes { state body author { login } } }
GRAPHQL

# Records, under this header (see lib/github.sh), in lifecycle order: drafts, other PRs that can't join the queue yet (by
# blocker), ready, then queued (by position). An other PR's state is its
# first blocker: DRAFT, CONFLICT, CHECKS_FAILING, CHANGES_REQUESTED,
# CHECKS_PENDING, REVIEW_REQUIRED, or UNKNOWN (mergeable is UNKNOWN until
# GitHub computes it: not ready yet, next time maybe).
# Deploying ones (merged, not in production yet), last, by merge: state
# MERGED, or DEPLOYING while a deploy run ships it. Then deployed ones, in
# production for less than $recent_window seconds: state DEPLOYED.
# Time: estimated seconds to merge (queued), last update epoch (other), merge
# epoch (deploying), when it reached production (deployed), or -.
# Auto: auto when auto-merge is on, else -.
# Label: the state in a word or two, for the picker and the panel.
# CI: the last commit's checks, SUCCESS, FAILURE or PENDING (see github_ci_jq).
# Review: the first of CONFLICT, DRAFT, CHANGES_REQUESTED, APPROVED or
# REVIEW_REQUIRED.
# Threads: how many review threads are unresolved (out of the first 100).
# Verdicts: the approvals and change requests that came with a message, each
# reviewer's latest: <login> US <APPROVED or CHANGES_REQUESTED> US <its first
# line, … when more follow>, separated by GS (US and GS: the ASCII unit and
# group separators), or - without any.
selection=${selection//CI_FIELDS/$github_ci_query}
fields=(kind repo number position state label time additions deletions auto url queue_url title enqueued_at ci review threads verdicts)
header="#$(IFS=$'\t'; echo "${fields[*]}")"
# A pull request's verdicts (see above), from its latestReviews
# shellcheck disable=SC2016 # jq variables
verdicts_jq='
  def verdicts:
    [.latestReviews.nodes[]
     | select(.state == "APPROVED" or .state == "CHANGES_REQUESTED")
     | [.body | gsub("\t"; " ") | split("\n")[] | gsub("^\\s+|\\s+$"; "") | select(length > 0)] as $lines
     | select($lines | length > 0)
     | "\(.author.login // "ghost")\u001f\(.state)\u001f\($lines[0])\(if ($lines | length) > 1 then " …" else "" end)"]
    | if length > 0 then join("\u001d") else "-" end;
'
# Rows are objects, printed in the order of $fields (- for what they lack)
# shellcheck disable=SC2016 # $e, $c, $pr, $blocker… are jq variables
program='
  FIELDS as $fields
  | {QUEUED: "queued", AWAITING_CHECKS: "checks running", MERGEABLE: "checks passed",
     UNMERGEABLE: "checks failed", LOCKED: "merging"} as $queue_labels
  | {DRAFT: "draft", CONFLICT: "conflict", CHECKS_FAILING: "checks", CHANGES_REQUESTED: "changes",
     CHECKS_PENDING: "running", REVIEW_REQUIRED: "needs review", UNKNOWN: "unknown"} as $labels
  | ["DRAFT", "CONFLICT", "CHECKS_FAILING", "CHANGES_REQUESTED", "CHECKS_PENDING", "REVIEW_REQUIRED", "UNKNOWN"] as $blockers
  | [ .data.search.nodes[]
      | ci as $c
      | { repo: .repository.nameWithOwner, number, additions, deletions, url,
          ci: $c,
          threads: ([.reviewThreads.nodes[] | select(.isResolved | not)] | length),
          verdicts: verdicts,
          review: (if .mergeable == "CONFLICTING" then "CONFLICT"
                   elif .isDraft then "DRAFT"
                   elif .reviewDecision == "CHANGES_REQUESTED" then "CHANGES_REQUESTED"
                   elif .reviewDecision == "APPROVED" then "APPROVED"
                   else "REVIEW_REQUIRED" end),
          auto: (if .autoMergeRequest then "auto" else "-" end),
          queue_url: "https://github.com/\(.repository.nameWithOwner)/queue/\(.baseRefName)",
          title: (.title | gsub("[\t\n]"; " ")) } as $pr
      | if .mergeQueueEntry then
          .mergeQueueEntry as $e
          | { rank: [2, $e.position],
              row: ($pr + { kind: "queued", position: $e.position, state: $e.state,
                            label: ($queue_labels[$e.state] // ($e.state | ascii_downcase)),
                            time: $e.estimatedTimeToMerge, enqueued_at: $e.enqueuedAt }) }
        else
          (if .isDraft then "DRAFT"
           elif .mergeable == "CONFLICTING" then "CONFLICT"
           elif $c == "FAILURE" then "CHECKS_FAILING"
           elif .reviewDecision == "CHANGES_REQUESTED" then "CHANGES_REQUESTED"
           elif $c != "SUCCESS" then "CHECKS_PENDING"
           elif .reviewDecision != "APPROVED" then "REVIEW_REQUIRED"
           elif .mergeable != "MERGEABLE" then "UNKNOWN"
           else "READY" end) as $blocker
          | if $blocker == "READY" then
              { rank: [1, .number], row: ($pr + { kind: "ready", state: "READY", label: "ready" }) }
            else
              { rank: [0, ($blockers | index($blocker)), -(.updatedAt | fromdateiso8601)],
                row: ($pr + { kind: "other", state: $blocker, label: $labels[$blocker],
                              time: (.updatedAt | fromdateiso8601) }) }
            end
        end ]
  | sort_by(.rank) | .[].row
  | [$fields[] as $f | .[$f] // "-"]
  | @tsv
'
program=${program//FIELDS/$(printf '%s\n' "${fields[@]}" | jq -R . | jq -sc .)}
answer=$(github_search_prs "is:pr is:open author:@me $repos" "$selection") || { cat "$cache"; exit 1; }
fresh=$(jq -r "$github_ci_jq$verdicts_jq$program" <<<"$answer") || { cat "$cache"; exit 1; }

fresh=$header$'\n'$(sed '/^$/d' <<<"$fresh")

notify() { github_notify merge-queue "$@"; } # <urgency> <title> <body> <url>

once() { # <key>: true the first time a key is seen (and remembers it)
  grep -qxF "$1" "$seen" && return 1
  echo "$1" >>"$seen"
  # First run: remember silently, no flood for what's already there
  [ -f "$state_dir/.initialized" ]
}

keys=()
current=''

# shellcheck disable=SC2154 # record fields, set by each_record
pull_request() {
  [ "$kind" = other ] && return # nothing to tell until it's ready

  if [ "$kind" = ready ]; then
    [ "$auto" = auto ] && return # GitHub enqueues it by itself
    keys+=("$repo#$number:ready")
    once "$repo#$number:ready" && notify normal "Ready to enqueue" "$title"$'\n'"$repo#$number" "$url"
    return
  fi

  current+="$repo"$'\t'"$number"$'\t'"$enqueued_at"$'\n'
  entry="$repo#$number@$enqueued_at"
  keys+=("$entry:checks" "$entry:near")

  # Being tested in a merge group (MERGEABLE: already passed, between polls)
  if [ "$state" = AWAITING_CHECKS ] || [ "$state" = MERGEABLE ]; then
    once "$entry:checks" && notify normal "Merge queue checks started" "$title"$'\n'"$repo#$number, position $position" "$url"
  fi

  if [ "$time" != - ] && [ "$time" -le "$near" ]; then
    once "$entry:near" && notify normal "Merging in about $(((time + 59) / 60)) min" "$title"$'\n'"$repo#$number, position $position" "$url"
  fi
}
each_record pull_request <<<"$fresh"

# Entries gone from the queue: merged, or kicked out (GitHub tells us why)
read -r -d '' left_query <<'GRAPHQL'
query($owner: String!, $name: String!, $number: Int!) {
  repository(owner: $owner, name: $name) {
    pullRequest(number: $number) {
      merged state title url
      timelineItems(itemTypes: [REMOVED_FROM_MERGE_QUEUE_EVENT], last: 1) {
        nodes { ... on RemovedFromMergeQueueEvent { reason } }
      }
    }
  }
}
GRAPHQL

while IFS=$'\t' read -r repo number enqueued; do
  [ -n "$repo" ] || continue
  grep -qxF "$repo"$'\t'"$number"$'\t'"$enqueued" <<<"$current" && continue

  left=$(timeout 60 gh api graphql -f query="$left_query" -f owner="${repo%/*}" -f name="${repo#*/}" -F number="$number" --jq '
    .data.repository.pullRequest
    | [(if .merged then "merged" else (.timelineItems.nodes[0].reason // (.state | ascii_downcase)) end),
       .url, (.title | gsub("[\t\n]"; " "))]
    | @tsv
  ' 2>/dev/null) || { current+="$repo"$'\t'"$number"$'\t'"$enqueued"$'\n'; continue; } # retry next time
  IFS=$'\t' read -r reason url title <<<"$left"

  [ -f "$state_dir/.initialized" ] || continue
  case $reason in
    merged) notify normal "Merged" "$title"$'\n'"$repo#$number" "$url" ;;
    manual) notify normal "Removed from the merge queue" "$title"$'\n'"$repo#$number" "$url" ;;
    *) notify critical "Kicked out of the merge queue: ${reason//_/ }" "$title"$'\n'"$repo#$number" "$url/checks" ;;
  esac
done <"$queued"

printf '%s' "$current" >"$queued"

# Deploys: my pull requests merged lately, until production runs them
read -r -d '' merged_query <<'GRAPHQL'
query($q: String!) {
  search(type: ISSUE, first: 100, query: $q) {
    nodes {
      ... on PullRequest {
        number title url additions deletions mergedAt
        mergeCommit { oid }
        repository { nameWithOwner }
      }
    }
  }
}
GRAPHQL

# The first time: remember what's deployed already, silently
deploy_once() { # <key>: once, but quiet until deploys were tracked once
  grep -qxF "$1" "$seen" && return 1
  echo "$1" >>"$seen"
  [ -f "$state_dir/.deploys_initialized" ]
}

# Records of the deploying and deployed ones (see fields)
deploying='' deployed=''
deploying_row() { # <state> <label> <repo> <number> <merged at> <additions> <deletions> <url> <title>
  deploying+=$(printf 'deploying\t%s\t%s\t-\t%s\t%s\t%s\t%s\t%s\t-\t%s\t-\t%s\t-\t-\t-\t-\t-' \
    "$3" "$4" "$1" "$2" "$5" "$6" "$7" "$8" "$9")$'\n'
}
# A deployed one, while it reached production less than $recent_window seconds ago
deployed_row() { # <repo> <number> <reached production at> <additions> <deletions> <url> <title>
  [ $((now - $3)) -lt "$recent_window" ] || return 0
  deployed+=$(printf 'deployed\t%s\t%s\t-\tDEPLOYED\tdeployed\t%s\t%s\t%s\t-\t%s\t-\t%s\t-\t-\t-\t-\t-' \
    "$1" "$2" "$3" "$4" "$5" "$6" "$7")$'\n'
}
now=$(date +%s)

# A repository's deploying ones: <number> <merge commit> <merged at> <additions> <deletions> <url> <title> on stdin
# shellcheck disable=SC2016 # GraphQL variables
track_deploys() { # <repo>
  local repo=$1 run run_id='' run_at deploy_sha='' prs=() i aliases='' answer
  mapfile -t prs
  [ ${#prs[@]} -gt 0 ] || return 0

  # A deploy run in progress: what it ships (none: not this repository's way)
  run=$(timeout 30 gh api "repos/$repo/actions/workflows/$deploy_workflow/runs?status=in_progress&per_page=1" \
    --jq '.workflow_runs[0] // empty | [.id, .created_at] | @tsv' 2>/dev/null)
  if [ -n "$run" ]; then
    IFS=$'\t' read -r run_id run_at <<<"$run"
    # Passed by then: a run may succeed after it started (it then lists them)
    deploy_sha=$(timeout 30 gh api "repos/$repo/actions/workflows/$tested_workflow/runs?branch=master&status=success&per_page=30&created=%3C%3D$run_at" \
      --jq "[.workflow_runs[] | select(.updated_at <= \"$run_at\")] | max_by(.created_at) | .head_sha // empty" 2>/dev/null)
  fi

  # In the release: the merge commit behind (or at) its tag. Being deployed:
  # at least as far behind master as what's deployed (both are on master's
  # line, so the further behind is the older one)
  for i in "${!prs[@]}"; do
    IFS=$'\t' read -r _ sha _ <<<"${prs[$i]}"
    aliases+="p$i: compare(headRef: \"$sha\") { status behindBy } "
  done
  local deploy_alias=''
  [ -n "$deploy_sha" ] && deploy_alias="deploy: compare(headRef: \"$deploy_sha\") { status behindBy }"
  answer=$(timeout 60 gh api graphql -f owner="${repo%/*}" -f name="${repo#*/}" -f query='
    query($owner: String!, $name: String!) { repository(owner: $owner, name: $name) {
      latestRelease { publishedAt tag { '"$aliases"' } }
      master: ref(qualifiedName: "refs/heads/master") { '"$aliases $deploy_alias"' }
    } }' --jq '
    .data.repository
    | if .latestRelease.tag == null then empty else
        . as $r
        | ["BEHIND", "IDENTICAL"] as $in
        | ($r.master.deploy // null) as $deploy
        | ($r.latestRelease.publishedAt | fromdateiso8601) as $published
        | ($r.latestRelease.tag | keys[]) as $key
        | [($key | ltrimstr("p")),
           (if ($r.latestRelease.tag[$key].status | IN($in[])) then "deployed"
            elif $deploy != null and ($deploy.status | IN($in[])) and ($r.master[$key].status | IN($in[]))
                 and $deploy.behindBy <= $r.master[$key].behindBy then "deploying"
            else "merged" end),
           $published]
        | @tsv
      end' 2>/dev/null) || answer='' # GitHub unreachable: as before, next time maybe

  local index status published number sha at additions deletions url title
  while IFS=$'\t' read -r index status published; do
    IFS=$'\t' read -r number sha at additions deletions url title <<<"${prs[$index]}"
    case $status in
      deployed)
        keys+=("$repo#$number:deployed")
        # Seen in production just now: in the latest release (one per poll or
        # so, while it waits). Not those already there the first time
        if deploy_once "$repo#$number:deployed"; then
          notify normal "Deployed to production" "$title"$'\n'"$repo#$number" "$url"
          printf '%s\t%s\n' "$repo#$number" "$published" >>"$deployed_at"
          deployed_row "$repo" "$number" "$published" "$additions" "$deletions" "$url" "$title"
        fi ;;
      deploying)
        keys+=("$repo#$number:deploying@$run_id")
        deploy_once "$repo#$number:deploying@$run_id" && notify normal "Deploying to production" "$title"$'\n'"$repo#$number" "$url"
        deploying_row DEPLOYING deploying "$repo" "$number" "$at" "$additions" "$deletions" "$url" "$title" ;;
      *) deploying_row MERGED merged "$repo" "$number" "$at" "$additions" "$deletions" "$url" "$title" ;;
    esac
  done <<<"$answer"
}

if merged=$(timeout 60 gh api graphql -f query="$merged_query" \
  -f q="is:pr is:merged author:@me merged:>=$(date -d "$deploy_window days ago" +%F) $repos" --jq '
    [.data.search.nodes[] | select(.mergeCommit)
     | [.repository.nameWithOwner, .number, .mergeCommit.oid, (.mergedAt | fromdateiso8601),
        .additions, .deletions, .url, (.title | gsub("[\t\n]"; " "))]]
    | sort_by(.[3]) | .[] | @tsv' 2>/dev/null); then
  # Deployed already: nothing more to tell (keep remembering it, while merged
  # lately), listed while recent
  pending=''
  while IFS=$'\t' read -r repo number rest; do
    [ -n "$repo" ] || continue
    if grep -qxF "$repo#$number:deployed" "$seen"; then
      keys+=("$repo#$number:deployed")
      reached=$(awk -F'\t' -v pr="$repo#$number" '$1 == pr { print $2 }' "$deployed_at")
      if [ -n "$reached" ]; then
        IFS=$'\t' read -r _ _ additions deletions url title <<<"$rest"
        deployed_row "$repo" "$number" "$reached" "$additions" "$deletions" "$url" "$title"
      fi
      continue
    fi
    mapfile -t -O "${#keys[@]}" keys < <(grep -F "$repo#$number:deploying@" "$seen") # told already
    pending+="$repo"$'\t'"$number"$'\t'"$rest"$'\n'
  done <<<"$merged"
  # Not in a pipeline: it adds to keys and deploying
  while read -r repo; do
    [ -n "$repo" ] && track_deploys "$repo" < <(awk -F'\t' -v repo="$repo" '$1 == repo' <<<"$pending" | cut -f2-)
  done < <(cut -f1 <<<"$pending" | sort -u)
  touch "$state_dir/.deploys_initialized"
  [ -n "$deploying" ] && fresh+=$'\n'${deploying%$'\n'}
  [ -n "$deployed" ] && fresh+=$'\n'${deployed%$'\n'}
  # No longer listed: forgotten
  awk -F'\t' -v now="$now" -v window="$recent_window" 'now - $2 < window' "$deployed_at" >"$deployed_at.tmp" \
    && mv "$deployed_at.tmp" "$deployed_at"
else
  # GitHub unreachable: keep what we told, and the deploying (and deployed)
  # ones we knew of
  mapfile -t -O "${#keys[@]}" keys < <(grep -E ':deploy(ed|ing@)' "$seen")
  stale=$(grep -P '^deploy(ing|ed)\t' "$cache")
  [ -n "$stale" ] && fresh+=$'\n'$stale
fi

# Forget what's gone, so that a new entry (or readiness) notifies again
if [ ${#keys[@]} -gt 0 ]; then
  grep -xF -f <(printf '%s\n' "${keys[@]}") "$seen" >"$seen.tmp"
else
  : >"$seen.tmp"
fi
mv "$seen.tmp" "$seen"
touch "$state_dir/.initialized"

printf '%s\n' "$fresh" >"$cache.tmp" && mv "$cache.tmp" "$cache"
# Whoever refreshed, the panel follows (it rereads the cache)
awesome-client 'awesome.emit_signal("merge-queue::changed")' >/dev/null 2>&1
cat "$cache"
