#!/usr/bin/env bash
# Drops the worktrees of stopped agents (see agent-worktree), the
# ones no agent runs in anymore (whatever else does, left behind by them or
# us, a rubocop server, an nvim, is stopped with them). Those holding uncommitted changes are kept
# (we get told once), as are the branches the agent committed on, those
# there before it (its worktree's, the ones it switched to: see
# agent-worktree), and the worktrees holding commits on no branch (made on
# the detached HEAD).
# Usage: agent-sweep [--wait <seconds>]
# --wait gives processes time to exit, e.g. right after closing an agent window.

wait=0
[ "$1" = --wait ] && wait=$2
deadline=$(($(date +%s) + wait))
slots="${XDG_STATE_HOME:-$HOME/.local/state}/agents/slots"
assets=$(dirname "$(readlink -f "$0")")
# shellcheck source-path=SCRIPTDIR source=lib/agents.sh
. "$assets/lib/agents.sh" # alive

# This sweep and what runs it (a shell within a worktree, say): not ours to stop
ours=" $$ " pid=$PPID
while [ "${pid:-1}" -gt 1 ]; do
  ours+="$pid "
  pid=$(ps -o ppid= -p "$pid" | tr -d ' ')
done

# The processes running within the worktree $1, one pid a line, but ours (one
# find for all of them: a readlink each took over half a second)
processes() {
  local pid
  for pid in $(find /proc/[0-9]*/cwd -maxdepth 0 \( -lname "$1" -o -lname "$1/*" \) 2>/dev/null \
    | sed 's|^/proc/\([0-9]*\)/cwd$|\1|'); do
    [[ $ours == *" $pid "* ]] || echo "$pid"
  done
}

# Whether an agent runs within the worktree $1, working or waiting (in a
# terminal or in the background), whatever its harness (see alive)
busy() {
  local pid
  for pid in $(processes "$1"); do
    alive "$pid" && return 0
  done
  return 1
}

# Stops what else runs within the worktree $1 (killed if still there after
# 2 seconds)
stop() {
  local pids ours="$ours$BASHPID " # run from a subshell: that one's ours too
  pids=$(processes "$1")
  [ -n "$pids" ] || return 0
  # shellcheck disable=SC2086 # one pid a word
  kill $pids 2>/dev/null
  for _ in 1 2 3 4; do
    [ -n "$(processes "$1")" ] || return 0
    sleep 0.5
  done
  # shellcheck disable=SC2046 # one pid a word
  kill -9 $(processes "$1") 2>/dev/null
}

# Whether slot file $1 was written within the last minute: its agent may not
# run in the worktree yet (kitty takes a moment to start in it)
fresh() { [ -n "$(find "$1" -mmin -1 -print -quit 2>/dev/null)" ]; }

# Whether the worktree $1 is being set up for its agent, the agent not started
# yet (it can take minutes: agent-spawn holds this lock the while)
setting_up() {
  local lock
  lock="$(git -C "$1" rev-parse --absolute-git-dir 2>/dev/null)/agent-setup.lock"
  [ -e "$lock" ] && ! flock -n "$lock" true
}

idle() {
  while busy "$1"; do
    [ "$(date +%s)" -lt "$deadline" ] || return 1
    sleep 0.5
  done
}

for repository in "$slots"/*/; do
  [ -d "$repository" ] || continue
  for slot_file in "$repository"[0-9]*; do
    [[ $(basename "$slot_file") =~ ^[0-9]+$ ]] || continue # not the .kept markers
    read -r worktree base _ <"$slot_file"
    if [ ! -d "$worktree" ]; then
      rm -f "$slot_file" "$slot_file.kept"
      continue
    fi
    fresh "$slot_file" && continue
    setting_up "$worktree" && continue
    idle "$worktree" || continue

    primary=$(dirname "$(git -C "$worktree" rev-parse --path-format=absolute --git-common-dir)")
    kept=''
    if [ -n "$(git -C "$worktree" status --porcelain)" ]; then
      kept='uncommitted changes'
    elif [ -z "$(git -C "$worktree" branch --show-current)" ] &&
      [ "$(git -C "$worktree" rev-list --count HEAD "^$base" --not --branches)" != 0 ]; then
      kept='commits on no branch'
    fi
    if [ -n "$kept" ]; then
      if [ ! -e "$slot_file.kept" ]; then
        agents_notify "Kept the worktree of a stopped agent, as it holds $kept: $worktree"
        touch "$slot_file.kept"
      fi
      continue
    fi

    # Spawns must not grab the slot while we free it
    (
      flock 9
      fresh "$slot_file" && exit # taken again while we waited
      setting_up "$worktree" && exit
      busy "$worktree" && exit
      branch=$(git -C "$worktree" branch --show-current)
      stop "$worktree"
      git -C "$primary" worktree remove "$worktree" || exit
      # Its own branch (made after its slot), left with nothing on it. Not
      # one there before it, its worktree's included: its slot lists them
      # (slots older than that list tell none: kept)
      if [ -n "$branch" ] && [ "$(wc -l <"$slot_file")" -gt 1 ] &&
        ! tail -n +2 "$slot_file" | grep -qxF -- "$branch" &&
        [ "$(git -C "$primary" rev-list --count "$base..$branch")" = 0 ]; then
        git -C "$primary" branch --quiet -D "$branch"
      fi
      rm -f "$slot_file" "$slot_file.kept"
      # What it held is gone: local work's cache too (see local-work)
      setsid -f "$assets/local-work" >/dev/null 2>&1 9>&-
    ) 9>"$repository/.lock"
  done
done
