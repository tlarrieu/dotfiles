#!/usr/bin/env bash
# Rofi hub for my GitHub pull requests (see merge-queue: drafts, blocked, ready),
# those waiting on my review (see review-queue), then mine with auto-merge on,
# mine in the merge queue, mine merged but not in production yet, and mine
# in production lately (see merge-queue's recent_window).
# Usage: rofi-github [filter]  (prefilled search; each row also matches an
# invisible tag: :open, :queued, :deploying, :deployed or :review)
# Columns: CI (the last commit's checks), then review (conflict, draft,
# changes requested, approved, or waiting for one; in the merge queue
# instead, for queued ones; merged, or being deployed, for deploying ones),
# then time: since the last update, waiting on my review for how long, for
# queued ones the position and when it should merge (#37 (1h14)), for
# deploying ones since the merge, for deployed ones since they reached
# production. A merge glyph before the number: auto-merge is on (it
# joins the queue once ready). A speech bubble before the title: unresolved
# review threads, how many. All red: GitHub can't tell whether it's
# mergeable, see on GitHub why. Before the title, an agent's face (as in
# rofi-agents): one works on it (see Ctrl+s), in its state.
# Enter: open in the browser. Ctrl+r: refresh from GitHub. Ctrl+q: open the merge
# queue page of the selected pull request's repository (mine only). Ctrl+s:
# back to the agent working on it (the one wanting me the most), else spawn
# one (see claude-agent-pr): fixing its conflicts, unresolved review threads
# and failing CI (mine), or reviewing it (others'). Ctrl+m: the merge queue
# (mine): add a ready one to it (asking first when something looks off, see
# queue_concerns), remove a queued one, then refresh; for the others, open
# their page at the merge box, to use "Merge when ready" there. (GitHub's API
# can't: it only queues ready ones, and a repository forbidding auto-merge,
# as the button sets it when checks still run, refuses it to the API.)

assets=$(dirname "$(readlink -f "$0")")
# shellcheck source-path=SCRIPTDIR source=lib/github.sh
. "$assets/lib/github.sh"
# shellcheck source-path=SCRIPTDIR source=lib/rofi.sh
. "$assets/lib/rofi.sh"
# shellcheck source-path=SCRIPTDIR source=lib/claude-agents.sh
. "$assets/lib/claude-agents.sh" # agent_faces
mode=--cached
filter=$1

# Pango attributes for each face's glyph (see lib/rofi.sh for $dim)
declare -A styles=(
  [SUCCESS]="color=\"$green\"" [FAILURE]="color=\"$red\"" [PENDING]="color=\"$blue\""
  [CONFLICT]="color=\"$red\"" [CHANGES_REQUESTED]="color=\"$yellow\""
  [APPROVED]="color=\"$green\"" [REVIEW_REQUIRED]=$dim [QUEUED]=$dim
  [MERGED]="color=\"$magenta\"" [DEPLOYING]="color=\"$blue\"" [DEPLOYED]="color=\"$green\""
)

declare -A faces=(
  # CI
  [SUCCESS]='󰗠'
  [FAILURE]='󰅙'
  [PENDING]='󰦖'
  # Review
  [CONFLICT]='󰀩'
  [DRAFT]=''
  [CHANGES_REQUESTED]='󰏫'
  [APPROVED]='󰔓'
  [REVIEW_REQUIRED]='󰈈'
  # Merge queue
  [QUEUED]=''
  # Deploy
  [MERGED]=''
  [DEPLOYING]='󱓞'
  [DEPLOYED]='󰅠'
)

# The window's widest, in characters (then its padding): half of my main
# monitor (3440 px) at theme.rasi's font. In characters rather than a share of
# the monitor, as rofi's default half of the screen leaves too little on
# a narrower one (the laptop's 1920 px)
max_width=152
auto_glyph='󰘬' # auto-merge on
prompt='' # rofi's, for the list and the dialogs
# Titles followed by an author (see row) share this many characters with
# it (and the two spaces between): the title gets what the longest author
# leaves, at least min_title_width
title_and_author=92 min_title_width=70

# Sets title_width from the review-queue records on stdin
# shellcheck disable=SC2154 # record fields, set by each_record
measure_authors() {
  local longest=0
  longest_author() { [ ${#author} -gt "$longest" ] && longest=${#author}; }
  each_record longest_author
  title_width=$((title_and_author - 2 - longest))
  [ "$title_width" -ge "$min_title_width" ] || title_width=$min_title_width
}
thread_glyph='󰵅' # unresolved review threads


# A row, from named cells (<name>=<value> arguments, all optional):
#   ci, review     faces keys (unknown ones show as ?, missing ones as blank)
#   time, number, additions, deletions, title
#   author         goes last, after the title (which then gets a fixed width)
#   tint           the review face's color, instead of its style (reviews
#                  waiting on me)
#   auto           auto: auto-merge is on
#   diff           plain: the additions and deletions uncolored
#   threads        how many review threads are unresolved
#   color          the whole row's color, overriding every other
#   verdicts       as merge-queue prints them, under the title (see
#                  verdict_lines)
#   agent          the state of the agent working on it (see find_agents)
# Pad before adding markup, which would otherwise count towards the widths
row() {
  local -A c=()
  local arg
  for arg; do
    case ${arg%%=*} in
      ci | review | time | number | additions | deletions | title | author | tint | auto | diff | threads | color | verdicts | agent)
        c[${arg%%=*}]=${arg#*=} ;;
      *) echo "row: unknown cell ${arg%%=*}" >&2 ;;
    esac
  done
  local ci review plus minus who='' title=${c[title]} threads auto=' ' line # the glyph takes one cell, like a space
  [ "${c[auto]}" = auto ] && auto=$auto_glyph
  # Faces are 3 cells wide: the glyph (one cell, blank when missing), then two
  # spaces. Style the glyphs only (a tint wins over the review face's own
  # style), unless the row's color does it all
  local style
  ci=${c[ci]:+${faces[${c[ci]}]:-?}} review=${c[review]:+${faces[${c[review]}]:-?}}
  if [ -z "${c[color]}" ]; then
    [ -n "${c[ci]}" ] && style=${styles[${c[ci]}]} && [ -n "$style" ] && ci="<span $style>$ci</span>"
    style=''
    [ -n "${c[review]}" ] && style=${styles[${c[review]}]}
    [ -n "${c[tint]}" ] && style="color=\"${c[tint]}\""
    [ -n "$style" ] && [ -n "$review" ] && review="<span $style>$review</span>"
  fi
  ci="${ci:- }  " review="${review:- }  "
  # As wide as the widest shown (see measure_columns): additions to the
  # right, deletions to the left, around a space. Padded by hand, as printf
  # counts the minus sign's bytes
  plus=$(printf '%*s' "$plus_width" "+${c[additions]}") minus="−${c[deletions]}"
  minus+=$(printf '%*s' $((minus_width - ${#minus})) '')
  # Last, fainter than dim. The title before it gets a fixed width (in
  # characters, as they are cells), so that a long one can't push it out of
  # the window
  if [ -n "${c[author]}" ]; then
    who="  <span fgalpha=\"40%\">$(escape "${c[author]}")</span>"
    [ ${#title} -gt "$title_width" ] && title="${title:0:title_width-1}…"
    title+=$(printf '%*s' $((title_width - ${#title})) '')
  fi
  # Glyph, space, count, dim (blank without any unresolved), as wide as the
  # widest shown (see measure_columns), then two spaces; none at all when no
  # row has any
  threads=''
  if [ "$threads_width" -gt 0 ]; then
    if [ "${c[threads]:-0}" -gt 0 ] 2>/dev/null; then
      threads="<span $dim>$thread_glyph ${c[threads]}</span>$(printf '%*s' $((threads_width - 2 - ${#c[threads]})) '')"
    else
      threads=$(printf '%*s' "$threads_width" '')
    fi
    threads+='  '
  fi
  if [ "${c[diff]}" != plain ] && [ -z "${c[color]}" ]; then
    plus="<span color=\"$green\">$plus</span>" minus="<span color=\"$red\">$minus</span>"
  fi
  # The agent's face, then two spaces; none at all when no row has one
  local agent=''
  if [ "$agents_width" -gt 0 ]; then
    agent='   '
    [ -n "${c[agent]}" ] && agent="<span ${agent_styles[${c[agent]}]:-$agent_fallback_style}>${agent_faces[${c[agent]}]:-󰚩}</span>  "
  fi
  # Time and number: as wide as the widest shown (see measure_columns)
  local before
  before=$(printf '%s%s%-*s %s #%-*s %s %s  %s%s' \
    "$ci" "$review" "$time_width" "${c[time]}" "$auto" "$number_width" "${c[number]}" "$plus" "$minus" "$threads" "$agent")
  line="$before$(escape "$title")$who"
  [ -n "${c[color]}" ] && line="<span color=\"${c[color]}\">$line</span>"
  printf '%s%s' "$line" "$(verdict_lines "$(shown_width "$before")" "${c[verdicts]}")"
}

# The lines under a title (from a column <indent> cells in) telling the
# verdicts reviewers left a message with: the face of their verdict, then
# who, and the message's first line, in italics, dim, cut to fit max_width
# Usage: verdict_lines <indent> <verdicts, as merge-queue prints them>
verdict_lines() {
  local indent=$1 login state message room out=''
  [ -n "$2" ] && [ "$2" != - ] || return 0
  while IFS=$'\x1f' read -r -d $'\x1d' login state message; do
    room=$((max_width - indent - ${#login} - 4)) # glyph, space, colon, space
    [ ${#message} -gt "$room" ] && message="${message:0:room-1}…"
    out+=$'\n'"$(printf '%*s' "$indent" '')<span ${styles[$state]}>${faces[$state]}</span> "
    out+="<span $dim><i>$(escape "$login"): $(escape "$message")</i></span>"
  done <<<"$2"$'\x1d'
  printf '%s' "$out"
}

# Adds a pull request to the merge queue (GitHub's "Merge when ready": it
# waits there for its checks), printing where it stands, or removes it
# Usage: toggle_queue <owner/repo> <number> <out (add it) or in (remove it)>
# shellcheck disable=SC2016 # GraphQL variables
toggle_queue() {
  local id
  id=$(timeout 30 gh pr view "$2" -R "$1" --json id --jq .id) || return 1
  if [ "$3" = in ]; then
    timeout 30 gh api graphql -f id="$id" --jq 'empty' -f query='
      mutation($id: ID!) { dequeuePullRequest(input: {id: $id}) { clientMutationId } }'
  else
    timeout 30 gh api graphql -f id="$id" -f query='
      mutation($id: ID!) { enqueuePullRequest(input: {pullRequestId: $id}) { mergeQueueEntry { position state } } }' \
      --jq '.data.enqueuePullRequest.mergeQueueEntry | "In the merge queue, position \(.position) (\(.state | ascii_downcase | gsub("_"; " ")))"'
  fi
}

# What to check before queueing one of my pull requests, one per line
# (nothing: go ahead). Running checks are fine: the queue waits for them
# Usage: queue_concerns <CI> <review> <state> <unresolved threads>
queue_concerns() {
  [ "$1" = FAILURE ] && echo "Its CI fails"
  case $2 in
    CONFLICT) echo "It conflicts with its base branch" ;;
    DRAFT) echo "It's a draft" ;;
    CHANGES_REQUESTED) echo "Changes were requested" ;;
    REVIEW_REQUIRED) echo "It isn't approved yet" ;;
  esac
  [ "$3" = UNKNOWN ] && echo "GitHub can't tell whether it's mergeable"
  [ "${4:-0}" -gt 0 ] 2>/dev/null && echo "$4 review thread$([ "$4" -gt 1 ] && echo s) unresolved"
  return 0
}

# Whether to queue it anyway, given its concerns (a rofi dialog: Escape, or
# Cancel, says no; Cancel comes first, so that a quick Enter doesn't queue it)
# Usage: confirm_queue <owner/repo>#<number> <concerns>
confirm_queue() {
  local mesg
  mesg="<b>$(escape "$1")</b>"$'\n'"$(escape "$2")"
  [ "$(printf '%s\n' Cancel 'Add to the merge queue anyway' |
    rofi -dmenu -i -no-custom -p "$prompt" -format i -theme-str "$layout window { width: calc(48ch + 2em min 100%); }" \
      -mesg "$mesg")" = 1 ]
}

# Sets agents and agent_sessions: the state and session of the agent working
# on each pull request (<owner/repo>#<number>, see claude-agent-pr), the one
# wanting me the most when there are several
# shellcheck disable=SC2154 # record fields, set by each_record
find_agents() {
  declare -gA agents=() agent_sessions=()
  local -A rank=([attention]=4 [done]=3 [running]=2 [idle]=1)
  rank_agent() {
    [ "$pr" != - ] && [ -n "$pr" ] || return 0
    local current=${agents[$pr]:-none}
    [ "${rank[$state]:-0}" -gt "${rank[$current]:-0}" ] && agents[$pr]=$state agent_sessions[$pr]=$session
    return 0
  }
  each_record rank_agent < <("$assets/claude-agent-list")
}

# Key hints: <key>=<what it does>…, the keys dimmer than what they do, the
# separators dimmer still
hints() {
  local hint out='' separator=' <span fgalpha="35%">•</span> '
  for hint; do
    out+="${out:+$separator}<span $dim>$(escape "<${hint%%=*}>")</span> $(escape "${hint#*=}")"
  done
  printf '%s' "$out"
}
# The message bar goes under the list, centered (theme.rasi puts it above:
# its gutter flips with it), in a smaller font (see -mesg)
layout='content { children: [inputbar, listview, message]; }
  message { margin: 0.5em 1em 1em 1em; }
  textbox { horizontal-align: 0.5; }'
mesg=$(hints enter=open ctrl+r=refresh ctrl+q='queue page' ctrl+s=agent ctrl+m='merge queue')

# The time column of one of my pull requests (a merge-queue record): its
# position and when it should merge (queued), nothing (ready), else since the
# merge (deploying), since it reached production (deployed), or the last
# update
# shellcheck disable=SC2154 # record fields, set by each_record
mine_when() {
  case $kind in
    queued) printf '#%s' "$position"; [ "$time" = - ] || printf ' (%s)' "$(eta "$time")" ;;
    ready) ;;
    *) ago $((now - time)) ;;
  esac
}

# The time column of a pull request waiting on my review: for how long
# shellcheck disable=SC2154 # record fields, set by each_record
review_when() { ago $((now - at)); }

# Sets time_width, number_width, plus_width, minus_width and threads_width:
# the widest time, pull request number, additions and deletions (their sign
# included) and unresolved threads (glyph, space and count; 0 when none has
# any) of the merge-queue records ($1) and the review-queue ones ($2), so that
# columns line up without padding them all for the widest possible (a queued
# one's "#37 (1h14)"). And agents_width: 3 when an agent works on one (see
# agents), else 0
# shellcheck disable=SC2154 # record fields, set by each_record
measure_columns() {
  local when
  time_width=0 number_width=0 plus_width=0 minus_width=0 threads_width=0 agents_width=0
  widest() { # <time>
    [ ${#1} -gt "$time_width" ] && time_width=${#1}
    [ ${#number} -gt "$number_width" ] && number_width=${#number}
    [ $((${#additions} + 1)) -gt "$plus_width" ] && plus_width=$((${#additions} + 1))
    [ $((${#deletions} + 1)) -gt "$minus_width" ] && minus_width=$((${#deletions} + 1))
    if [ "${threads:-0}" -gt 0 ] 2>/dev/null && [ $((${#threads} + 2)) -gt "$threads_width" ]; then
      threads_width=$((${#threads} + 2))
    fi
    [ -n "${agents[$repo#$number]}" ] && agents_width=3
  }
  widest_mine() { when=$(mine_when); widest "$when"; }
  widest_review() { when=$(review_when); widest "$when"; }
  each_record widest_mine <<<"$1"
  each_record widest_review <<<"$2"
}

# Adds one of my pull requests (a merge-queue record, see each_record) if it
# belongs to $group: open (needs me, or someone else), auto (auto-merge on:
# on its way to the queue), queued, deploying (merged, not in production
# yet) or deployed (in production lately)
# shellcheck disable=SC2154 # record fields, set by each_record
mine() {
  local in=open when tag=:open diff='' color='' line
  case $kind in queued | deploying | deployed) in=$kind ;; *) [ "$auto" = auto ] && in=auto ;; esac
  [ "$in" = "$group" ] || return 0
  case $kind in queued | deploying | deployed) tag=:$kind ;; esac
  when=$(mine_when)
  # On their way (auto-merge on), in the queue or merged: the diff in the
  # fade too
  [ "$in" = open ] || diff=plain
  # In the queue, its required checks passed: a failing one is optional (and
  # the queue's own run is the one that matters now)
  [ "$in" = queued ] && review=QUEUED ci=SUCCESS
  # MERGED, DEPLOYING or DEPLOYED; no queue to open, nothing for an agent to
  # fix (Ctrl+s)
  case $in in deploying | deployed) review=$state ci='' queue_url='' threads=0 ;; esac
  # Reviewers' messages: on those about to join the queue (Ctrl+m), to check
  # before. Not once they're in it, or merged
  local shown_verdicts=''
  case $in in open | auto) shown_verdicts=$verdicts ;; esac
  # GitHub can't tell whether it's mergeable (the icons alone would read ready)
  [ "$state" = UNKNOWN ] && color=$red
  line=$(row ci="$ci" review="$review" time="$when" number="$number" additions="$additions" deletions="$deletions" \
    title="$title" auto="$auto" diff="$diff" threads="$threads" color="$color" verdicts="$shown_verdicts" \
    agent="${agents[$repo#$number]}")
  # Queued and merged ones stay in the background: they move on their own;
  # those with auto-merge on, a bit less (they will join the queue by
  # themselves)
  case $in in
    open) ;;
    auto) line="<span fgalpha=\"80%\">$line</span>" ;;
    *) line="<span fgalpha=\"60%\">$line</span>" ;;
  esac
  # The merge queue: can join it (ready ones; and what Ctrl+m checks first),
  # waits for GitHub's page (other open ones), can leave it (queued), or
  # neither (merged)
  local merge=''
  case $in in
    open | auto)
      if [ "$kind" = ready ]; then merge="$repo $number out ${ci:--} ${review:--} ${state:--} ${threads:-0}"
      else merge="$repo $number page"; fi ;;
    queued) merge="$repo $number in" ;;
  esac
  urls+=("$url") queues+=("$queue_url") prs+=("fix $repo $number ${threads:-0} ${ci:--} ${review:--}") merges+=("$merge")
  tags+=("$tag") lines+=("$line")
}

# Adds a pull request waiting on my review (a review-queue record)
# shellcheck disable=SC2154 # record fields, set by each_record
review() {
  local waited=$((now - at)) tint=''
  # The review face, warmer as the wait grows: 4h, then a day
  if [ "$waited" -ge 86400 ]; then tint=$red
  elif [ "$waited" -ge 14400 ]; then tint=$yellow; fi
  urls+=("$url") queues+=('') prs+=("review $repo $number") merges+=('') tags+=(:review)
  lines+=("$(row ci="$ci" review=REVIEW_REQUIRED time="$(review_when)" number="$number" additions="$additions" \
    deletions="$deletions" author="$author" title="$title" tint="$tint" threads="$threads" \
    agent="${agents[$repo#$number]}")")
}

while :; do
  # The trackers side by side (their output in files meanwhile: gone before
  # anything else, as we may exec away)
  outputs=$(mktemp -d)
  "$assets/merge-queue" $mode >"$outputs/mine" 2>&1 &
  mine_pid=$!
  "$assets/review-queue" $mode >"$outputs/reviews" 2>&1 &
  reviews_pid=$!
  wait "$mine_pid"; mine_status=$?
  wait "$reviews_pid"; reviews_status=$?
  mine=$(<"$outputs/mine") reviews=$(<"$outputs/reviews")
  rm -r "$outputs"
  mode=--cached

  # Both read the same repository list: one complaint is enough
  if [ "$mine_status" -eq 2 ] || [ "$reviews_status" -eq 2 ]; then
    [ "$mine_status" -eq 2 ] && message=${mine#merge-queue: } || message=${reviews#review-queue: }
    notify-send --app-name=github --urgency=critical "GitHub not watched" "$message"
    exit 1
  fi

  urls=()
  queues=()
  merges=() # <repo> <number> <in (the merge queue), out (ready to join it) or page (not ready)> [<CI> <review> <state> <threads>] (mine, unless merged)
  prs=() # <agent task> <repo> <number> [<unresolved threads> <CI> <review>] (the last three: mine)
  tags=()
  lines=()
  now=$(date +%s)
  find_agents
  measure_authors <<<"$reviews"
  threads='' measure_columns "$mine" "$reviews" # threads blank, as below

  # ci, review, threads and verdicts blank: a cache from before these fields
  # keeps them so
  ci='' review='' threads='' verdicts='' group=open each_record mine <<<"$mine"
  ci='' threads='' each_record review <<<"$reviews"
  # Last, as they need nothing from me: on their way to the queue, in it,
  # merged, then in production
  ci='' review='' threads='' verdicts='' group=auto each_record mine <<<"$mine"
  ci='' review='' threads='' verdicts='' group=queued each_record mine <<<"$mine"
  ci='' review='' threads='' verdicts='' group=deploying each_record mine <<<"$mine"
  ci='' review='' threads='' verdicts='' group=deployed each_record mine <<<"$mine"

  if [ ${#lines[@]} -eq 0 ]; then
    notify-send --app-name=github GitHub "No open pull request, nothing waiting on your review 🎉"
    exit 0
  fi

  # GitHub unreachable (exit 1): the trackers printed what they last knew
  status_line=''
  if [ "$mine_status" -eq 1 ] || [ "$reviews_status" -eq 1 ]; then
    status_line=$'\n'"<span color=\"$red\">Could not reach GitHub: showing the last known state</span>"
  fi

  # The window: as wide as the widest row, or the message bar (in its 90%
  # font), with their padding (theme.rasi's elem-gutter, the message's
  # margin: 1em on each side), up to max_width, and the monitor
  widest=$(( ($(shown_width "$mesg$status_line") * 9 + 9) / 10 ))
  for line in "${lines[@]}"; do
    width=$(shown_width "$line")
    [ "$width" -gt "$widest" ] && widest=$width
  done
  [ "$widest" -gt "$max_width" ] && widest=$max_width
  window="window { width: calc(${widest}ch + 2em min 100%); }"

  # Rows are as tall as the tallest (verdicts under a title make them so):
  # rofi can't size them each
  height=1
  for line in "${lines[@]}"; do
    rows=${line//[!$'\n']/}
    [ $((${#rows} + 1)) -gt "$height" ] && height=$((${#rows} + 1))
  done

  # Tags go in each row's invisible search terms (meta). Rows end with a
  # record separator: they may hold several lines
  selection=$(for i in "${!lines[@]}"; do printf '%s\0meta\x1f%s\x1e' "${lines[$i]}" "${tags[$i]}"; done |
    rofi -dmenu -i -markup-rows -sep $'\x1e' -eh "$height" -p "$prompt" -format 'i f' -filter "$filter" \
      -kb-custom-1 'Control+r' -kb-custom-2 'Control+q' -kb-custom-3 'Control+s' -kb-custom-4 'Control+m' \
      -kb-accept-entry 'Control+j,Return,KP_Enter' -theme-str "$layout $window" -mesg "<span size=\"90%\">$mesg$status_line</span>")
  code=$?
  read -r choice filter <<<"$selection" # keep the search across refreshes
  [ "$choice" -ge 0 ] 2>/dev/null || choice=''

  case $code in
    0) [ -n "$choice" ] && exec browser-kiosk "${urls[$choice]}"; exit 0 ;;
    10) mode='' ;;
    11) [ -n "$choice" ] && [ -n "${queues[$choice]}" ] && exec browser-kiosk "${queues[$choice]}" ;; # reviews: stay
    12)
      if [ -n "$choice" ]; then
        read -r pr_task pr_repo pr_number pr_threads pr_ci pr_review <<<"${prs[$choice]}"
        # An agent on it already: back to it, rather than another one
        pr_session=${agent_sessions[$pr_repo#$pr_number]}
        [ -n "$pr_session" ] && exec "$assets/claude-agent-jump" "$pr_session"
        # The cache may lag: Ctrl+r first when threads came in (CI failed, or
        # a conflict arose) since
        if [ "$pr_task" = fix ] && [ "$pr_threads" -eq 0 ] 2>/dev/null && [ "$pr_ci" != FAILURE ] && [ "$pr_review" != CONFLICT ]; then
          notify-send --app-name=github GitHub "Nothing to fix on $pr_repo#$pr_number: no conflict, no unresolved review thread, no failing CI"
        else
          exec "$assets/claude-agent-pr" "$pr_task" "$pr_repo" "$pr_number"
        fi
      fi ;;
    13)
      if [ -n "$choice" ]; then
        read -r merge_repo merge_number merge_queue merge_ci merge_review merge_state merge_threads <<<"${merges[$choice]}"
        concerns=''
        [ "$merge_queue" = out ] && concerns=$(queue_concerns "$merge_ci" "$merge_review" "$merge_state" "$merge_threads")
        if [ -z "$merge_repo" ]; then
          notify-send --app-name=github GitHub "The merge queue is for my open pull requests"
        elif [ "$merge_queue" = page ]; then
          # "Merge when ready" there: the merge box sits right above the
          # comment box (it has no anchor of its own showing logged out)
          exec browser-kiosk "${urls[$choice]}#issue-comment-box"
        elif [ -n "$concerns" ] && ! confirm_queue "$merge_repo#$merge_number" "$concerns"; then
          : # back to the list
        elif result=$(toggle_queue "$merge_repo" "$merge_number" "$merge_queue" 2>&1); then
          # Leaving it: merge-queue tells, refreshing
          [ "$merge_queue" = out ] && notify-send --app-name=github "Merge when ready" "$merge_repo#$merge_number"$'\n'"$result"
          mode='' # show where it stands
        else
          notify-send --app-name=github --urgency=critical \
            "$([ "$merge_queue" = out ] && echo "Not added to" || echo "Not removed from") the merge queue" \
            "$merge_repo#$merge_number"$'\n'"$result"
        fi
      fi ;;
    *) exit 0 ;;
  esac
done
