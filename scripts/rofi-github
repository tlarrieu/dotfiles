#!/usr/bin/env bash
# Rofi hub for my Claude agents and GitHub pull requests, in this order:
# agents on none of the rows below (find_loose_agents), my open pull requests
# (merge-queue), local work none of them holds (local-work), those waiting on
# my review (review-queue), then my teams', then mine with auto-merge on, queued, deploying,
# deployed. Columns: see row (and faces for the glyphs).
# Usage: rofi-github [filter]  (prefilled search; rows also match invisible
# tags: :open, :queued, :deploying, :deployed, :review, :team, :local, :unpushed,
# :agent)
# Enter: open (browser; an agent's row: jump to it; local work: neovim in its
# worktree). Ctrl+r: refresh from GitHub. Ctrl+q: the repository's merge queue
# page. Ctrl+s: the agent on it, else spawn one (claude-agent-pr). Ctrl+m:
# enqueue a ready one of mine (asking first, see queue_concerns) or dequeue
# it; for the others, their page at the merge box: GitHub's API only queues
# ready ones, and a repository forbidding auto-merge refuses "Merge when
# ready" to it. Ctrl+o: push the row's branch, asking first.

assets=$(dirname "$(readlink -f "$0")")
# shellcheck source-path=SCRIPTDIR source=lib/github.sh
. "$assets/lib/github.sh"
# shellcheck source-path=SCRIPTDIR source=lib/rofi.sh
. "$assets/lib/rofi.sh"
# shellcheck source-path=SCRIPTDIR source=lib/claude-agents.sh
. "$assets/lib/claude-agents.sh" # agent_faces, agent_wants
mode=--cached
filter=$1

# Pango attributes for each face's glyph (see lib/rofi.sh for $dim)
declare -A styles=(
  [SUCCESS]="color=\"$green\"" [FAILURE]="color=\"$red\"" [PENDING]="color=\"$blue\""
  [CONFLICT]="color=\"$red\"" [CHANGES_REQUESTED]="color=\"$yellow\""
  [APPROVED]="color=\"$green\"" [BOT_REVIEWING]="color=\"$blue\"" [BOT_REVIEW_FAILED]="color=\"$red\"" [REVIEW_REQUIRED]=$dim [UNKNOWN]="color=\"$blue\"" [QUEUED]=$dim
  [MERGED]="color=\"$magenta\"" [DEPLOYING]="color=\"$blue\"" [DEPLOYED]="color=\"$green\""
)

declare -A faces=(
  # CI
  [SUCCESS]='󰗠'
  [FAILURE]='󰅙'
  [PENDING]='󰦖'
  # Review
  [CONFLICT]='󰀩'
  [DRAFT]=''
  [CHANGES_REQUESTED]='󰏫'
  [BOT_REVIEWING]=''
  [BOT_REVIEW_FAILED]=''
  [APPROVED]='󰔓'
  [REVIEW_REQUIRED]='󰈈'
  [UNKNOWN]='󰔟' # mergeability: GitHub hasn't worked it out yet
  # Merge queue
  [QUEUED]=''
  # Deploy
  [MERGED]=''
  [DEPLOYING]='󱓞'
  [DEPLOYED]='󰅠'
)

# The window's widest, in characters (then its padding): half of my main
# monitor (3440 px) at theme.rasi's font. In characters rather than a share of
# the monitor, as rofi's default half of the screen leaves too little on
# a narrower one (the laptop's 1920 px)
max_width=152
auto_glyph='󰘬' # auto-merge on
prompt='' # rofi's, for the list and the dialogs
# Titles followed by an author (see row) share this many characters with
# it (and the two spaces between): the title gets what the longest author
# leaves, at least min_title_width
title_and_author=92 min_title_width=70

# Sets title_width from the review-queue records on stdin
# shellcheck disable=SC2154 # record fields, set by each_record
measure_authors() {
  local longest=0
  longest_author() { [ ${#author} -gt "$longest" ] && longest=${#author}; }
  each_record longest_author
  title_width=$((title_and_author - 2 - longest))
  [ "$title_width" -ge "$min_title_width" ] || title_width=$min_title_width
}
thread_glyph='' comment_glyph='' # unresolved review threads, open review comments
unpushed_glyph='󰄝' changes_glyph='󰴓' # local work: commits to push, uncommitted changes


# Local work, unstyled: <glyph> <commits to push>, <glyph> <changed files>,
# each when there are any (see row)
# Usage: work_text <commits to push> <changed files>
work_text() {
  local out=''
  [ "${1:-0}" -gt 0 ] 2>/dev/null && out="$unpushed_glyph $1"
  [ "${2:-0}" -gt 0 ] 2>/dev/null && out+="${out:+ }$changes_glyph $2"
  printf '%s' "$out"
}

# A count column of row (threads, comments): glyph, space, count, dim (blank
# without any), as wide as the widest shown (see measure_columns), then two
# spaces; none at all when no row has any (width 0)
# Usage: count_cell <glyph> <count> <width>
count_cell() {
  [ "$3" -gt 0 ] || return 0
  if [ "${2:-0}" -gt 0 ] 2>/dev/null; then
    printf '<span %s>%s %s</span>%*s  ' "$dim" "$1" "$2" $(($3 - 2 - ${#2})) ''
  else
    printf '%*s  ' "$3" ''
  fi
}

# A row, from named cells (<name>=<value> arguments, all optional):
#   ci, review     faces keys (unknown ones show as ?, missing ones as blank)
#   time, number, additions, deletions, title
#   project        an agent's project, instead of the number and the diff
#   author         goes last, after the title (which then gets a fixed width)
#   tint           the review face's color, instead of its style (reviews
#                  waiting on me)
#   auto           auto: auto-merge is on
#   diff           plain: the additions and deletions uncolored
#   threads        how many review threads are unresolved
#   comments       how many review comments are open (see github_comments_jq)
#   approvals      <approvals>/<required>, as merge-queue prints them (- or
#                  missing: blank)
#   work           local work (see local-work): <commits to push> <changed
#                  files> <yes when an agent works in its worktree, else ->
#   italic         italic: the whole row in italics
#   agent          the state of the agent working on it (see find_agents)
# Pad before adding markup, which would otherwise count towards the widths
row() {
  local -A c=()
  local arg
  for arg; do
    case ${arg%%=*} in
      ci | review | time | number | additions | deletions | title | author | tint | auto | diff | threads | comments | approvals | work | italic | agent | project)
        c[${arg%%=*}]=${arg#*=} ;;
      *) echo "row: unknown cell ${arg%%=*}" >&2 ;;
    esac
  done
  local ci review plus minus who='' title=${c[title]} threads comments auto=' ' line # the glyph takes one cell, like a space
  [ "${c[auto]}" = auto ] && auto=$auto_glyph
  # Faces are 3 cells wide: the glyph (one cell, blank when missing), then two
  # spaces. Style the glyphs only (a tint wins over the review face's own
  # style)
  local style
  ci=${c[ci]:+${faces[${c[ci]}]:-?}} review=${c[review]:+${faces[${c[review]}]:-?}}
  [ -n "${c[ci]}" ] && style=${styles[${c[ci]}]} && [ -n "$style" ] && ci="<span $style>$ci</span>"
  style=''
  [ -n "${c[review]}" ] && style=${styles[${c[review]}]}
  [ -n "${c[tint]}" ] && style="color=\"${c[tint]}\""
  [ -n "$style" ] && [ -n "$review" ] && review="<span $style>$review</span>"
  ci="${ci:- }  " review="${review:- }  "
  # Approvals, dimmer than dim, as wide as the widest shown (see
  # measure_columns), then a space; none at all when no row has any
  local approvals=''
  if [ "$approvals_width" -gt 0 ]; then
    local count=${c[approvals]#-}
    approvals="${count:+<span $dimmer>$count</span>}$(printf '%*s' $((approvals_width - ${#count})) '') "
  fi
  # As wide as the widest shown (see measure_columns): additions to the
  # right, deletions to the left, around a space. Padded by hand, as printf
  # counts the minus sign's bytes
  plus=$(printf '%*s' "$plus_width" "+${c[additions]}") minus="−${c[deletions]}"
  minus+=$(printf '%*s' $((minus_width - ${#minus})) '')
  # Last, fainter than dim. The title before it gets a fixed width (in
  # characters, as they are cells), so that a long one can't push it out of
  # the window
  if [ -n "${c[author]}" ]; then
    who="  <span fgalpha=\"40%\">$(escape "${c[author]}")</span>"
    [ ${#title} -gt "$title_width" ] && title="${title:0:title_width-1}…"
    title+=$(printf '%*s' $((title_width - ${#title})) '')
  fi
  threads=$(count_cell "$thread_glyph" "${c[threads]}" "$threads_width")
  comments=$(count_cell "$comment_glyph" "${c[comments]}" "$comments_width")
  # Local work, as wide as the widest shown (see measure_columns), then two
  # spaces; none at all when no row has any
  local work=''
  if [ "$work_width" -gt 0 ]; then
    local ahead changed tended shown
    read -r ahead changed tended <<<"${c[work]:-0 0 -}"
    work=$(work_text "$ahead" "$changed")
    shown=${#work}
    [ "${ahead:-0}" -gt 0 ] && work=${work/"$unpushed_glyph $ahead"/"<span color=\"$yellow\">$unpushed_glyph $ahead</span>"}
    if [ "${changed:-0}" -gt 0 ]; then
      local tone=$dim
      [ "$tended" = yes ] || tone="color=\"$yellow\""
      work=${work/"$changes_glyph $changed"/"<span $tone>$changes_glyph $changed</span>"}
    fi
    work+="$(printf '%*s' $((work_width - shown)) '')  "
  fi
  if [ "${c[diff]}" != plain ]; then
    plus="<span color=\"$green\">$plus</span>" minus="<span color=\"$red\">$minus</span>"
  fi
  # The agent's face, then two spaces; none at all when no row has one
  local agent=''
  if [ "$agents_width" -gt 0 ]; then
    agent='   '
    [ -n "${c[agent]}" ] && agent="<span ${agent_styles[${c[agent]}]:-$agent_fallback_style}>${agent_faces[${c[agent]}]:-󰚩}</span>  "
  fi
  # Time and number: as wide as the widest shown (see measure_columns). The
  # project takes the number's and the diff's place (measure_columns
  # widens the number for the longest)
  local middle
  if [ -n "${c[project]}" ]; then
    middle=$(escape "$(printf '%-*s' $((number_width + plus_width + minus_width + 3)) "${c[project]}")")
  else
    middle=$(printf '#%-*s %s %s' "$number_width" "${c[number]}" "$plus" "$minus")
  fi
  local before
  before=$(printf '%s%s%s%-*s %s %s  %s%s%s%s' "$ci" "$review" "$approvals" "$time_width" "${c[time]}" "$auto" "$middle" "$threads" "$comments" "$work" "$agent")
  line="$before$(escape "$title")$who"
  [ "${c[italic]}" = italic ] && line="<span style=\"italic\">$line</span>"
  printf '%s' "$line"
}

# Adds a pull request to the merge queue (GitHub's "Merge when ready": it
# waits there for its checks), printing where it stands, or removes it
# Usage: toggle_queue <owner/repo> <number> <out (add it) or in (remove it)>
# shellcheck disable=SC2016 # GraphQL variables
toggle_queue() {
  local id
  id=$(timeout 30 gh pr view "$2" -R "$1" --json id --jq .id) || return 1
  if [ "$3" = in ]; then
    timeout 30 gh api graphql -f id="$id" --jq 'empty' -f query='
      mutation($id: ID!) { dequeuePullRequest(input: {id: $id}) { clientMutationId } }'
  else
    timeout 30 gh api graphql -f id="$id" -f query='
      mutation($id: ID!) { enqueuePullRequest(input: {pullRequestId: $id}) { mergeQueueEntry { position state } } }' \
      --jq '.data.enqueuePullRequest.mergeQueueEntry | "In the merge queue, position \(.position) (\(.state | ascii_downcase | gsub("_"; " ")))"'
  fi
}

# The open review comments of a pull request (see github_comments_jq), one
# oldest first: its author, then, on the next line, its start (markdown
# stripped) cut to fit the dialog (see confirm_queue). Nothing when GitHub can't tell
# Usage: comment_excerpts <owner/repo> <number>
# shellcheck disable=SC2016 # GraphQL and jq variables
comment_excerpts() {
  timeout 30 gh api graphql -f owner="${1%%/*}" -f name="${1#*/}" -F number="$2" -f query='
    query($owner: String!, $name: String!, $number: Int!) {
      repository(owner: $owner, name: $name) { pullRequest(number: $number) { '"$github_comments_query"' } }
    }' 2>/dev/null | jq -r "$github_comments_jq"'
    .data.repository.pullRequest | open_comment_nodes[]
    | "  \((.author.login // "ghost") | sub("\\[bot\\]$"; ""))",
      ("    " + (.body | gsub("<[^>]*>|-{3,}|[*`#_>~]"; "") | gsub("\\s+"; " ") | ltrimstr(" ") | ltrimstr("- "))
       | if length > 46 then .[:45] + "…" else . end)' 2>/dev/null
  return 0
}

# What to check before queueing one of my pull requests, one per line
# (nothing: go ahead). Running checks are fine: the queue waits for them
# Usage: queue_concerns <CI> <review> <state> <unresolved threads> <open comments> <owner/repo> <number>
queue_concerns() {
  [ "$1" = FAILURE ] && echo "Its CI fails"
  case $2 in
    CONFLICT) echo "It conflicts with its base branch" ;;
    DRAFT) echo "It's a draft" ;;
    CHANGES_REQUESTED) echo "Changes were requested" ;;
    BOT_REVIEWING) echo "A bot is still reviewing it" ;;
    BOT_REVIEW_FAILED) echo "A bot's review failed" ;;
    REVIEW_REQUIRED) echo "It isn't approved yet" ;;
  esac
  [ "$3" = UNKNOWN ] && echo "GitHub can't tell whether it's mergeable"
  [ "${4:-0}" -gt 0 ] 2>/dev/null && echo "$4 review thread$([ "$4" -gt 1 ] && echo s) unresolved"
  if [ "${5:-0}" -gt 0 ] 2>/dev/null; then
    echo "$5 review comment$([ "$5" -gt 1 ] && echo s) not hidden"
    comment_excerpts "$6" "$7"
  fi
  return 0
}

# Whether to queue it anyway, given its concerns (a rofi dialog: Escape, or
# Cancel, says no; Cancel comes first, so that a quick Enter doesn't queue it)
# Usage: confirm_queue <owner/repo>#<number> <concerns>
confirm_queue() {
  local mesg
  mesg="<b>$(escape "$1")</b>"$'\n'"$(escape "$2")"
  [ "$(printf '%s\n' Cancel 'Add to the merge queue anyway' |
    rofi -dmenu -i -no-custom -p "$prompt" -format i -theme-str "$layout window { width: calc(48ch + 2em min 100%); }" \
      -mesg "$mesg")" = 1 ]
}

# Sets agents: the state of the agent working on each pull request
# (<owner/repo>#<number>, see claude-agent-pr), the one wanting me the most
# when there are several; agent_states: each agent's
# state, by session; agent_prs: the pull request each works on, by session.
# And agent_list: all of them (claude-agent-list's records)
# shellcheck disable=SC2154 # record fields, set by each_record
find_agents() {
  declare -gA agents=() agent_states=() agent_prs=()
  agent_list=$("$assets/claude-agent-list")
  rank_agent() {
    agent_states[$session]=$state
    [ "$pr" != - ] && [ -n "$pr" ] || return 0
    agent_prs[$session]=$pr
    local current=${agents[$pr]:-none}
    [ "${agent_wants[$state]:-0}" -gt "${agent_wants[$current]:-0}" ] && agents[$pr]=$state
    return 0
  }
  each_record rank_agent <<<"$agent_list"
}

# Sets loose_agents: claude-agent-list's records ($agent_list) of the agents
# working on no pull request among the merge-queue records ($1) and the
# review-queue ones ($2) (one gone from them: merged long ago, reviewed; or
# none, in an agent worktree, <project>-<slot>), so that they get a row. Not
# those on none in a main checkout: the sessions I keep open there
# (super+u, or the panel, reach them). Nor those working where some local
# work lies (find_local_work's records, $3): its row tells their state
# shellcheck disable=SC2154 # record fields, set by each_record
find_loose_agents() {
  local -A listed=()
  list_pr() { listed[$repo#$number]=1; }
  each_record list_pr <<<"$1"
  each_record list_pr <<<"$2"
  local -A on_work=()
  list_work() { [ "$agent" != - ] && on_work[$agent]=1; return 0; }
  each_record list_work <<<"$3"
  loose_agents=$(head -n1 <<<"$agent_list")
  keep_loose() {
    [ -n "${on_work[$session]}" ] && return 0
    if [ "$pr" != - ] && [ -n "$pr" ]; then
      [ -n "${listed[$pr]}" ] && return 0
    else
      [[ $project =~ -[0-9]+$ ]] || return 0
    fi
    loose_agents+=$'\n'"$started"$'\t'"$state"$'\t'"$since"$'\t'"$session"$'\t'"$project"$'\t'"$pr"
  }
  each_record keep_loose <<<"$agent_list"
}

# Sets work_of and push_of, for the local work (local-work's records, $1) on
# the head branch of one of my pull requests (merge-queue's records, $2), by
# <owner/repo>#<branch>: its row's work cell (see row), and what Ctrl+o
# pushes (see pushes, when there's something to). And pr_work, for the local
# work of an agent on one of those pull requests, or on one waiting on my
# review (review-queue's records, $3), elsewhere than on its head branch (a
# detached worktree, as claude-agent-pr falls back to), by
# <owner/repo>#<number>: its row's work cell. For a review, its uncommitted
# changes only (the commits it sits on are the pull request's, fetched by
# ref: on no branch here). And local_work: the other records, which get rows
# of their own
# shellcheck disable=SC2154 # record fields, set by each_record
find_local_work() {
  declare -gA work_of=() push_of=() pr_work=()
  local -A heads=() owned=() reviewed=()
  list_head() {
    owned[$repo#$number]=1
    [ -n "$branch" ] && [ "$branch" != - ] && heads[$repo#$branch]=1
    return 0
  }
  each_record list_head <<<"$2"
  list_reviewed() { reviewed[$repo#$number]=1; }
  each_record list_reviewed <<<"$3"
  local_work=$(head -n1 <<<"$1")
  sort_work() {
    local pr=${agent_prs[$agent]}
    if [ "$branch" != - ] && [ -n "${heads[$repo#$branch]}" ]; then
      work_of[$repo#$branch]="$ahead $changes $([ "$agent" != - ] && echo yes || echo -)"
      [ "$ahead" -gt 0 ] && push_of[$repo#$branch]="$clone $branch $upstream $ahead"
    elif [ "$agent" != - ] && [ -n "$pr" ] && [ -n "${owned[$pr]}" ]; then
      pr_work[$pr]="$ahead $changes yes"
    elif [ "$agent" != - ] && [ -n "$pr" ] && [ -n "${reviewed[$pr]}" ]; then
      [ "$changes" -gt 0 ] && pr_work[$pr]="0 $changes yes"
    else
      local_work+=$'\n'"$repo"$'\t'"$clone"$'\t'"$branch"$'\t'"$worktree"$'\t'"$upstream"$'\t'"$ahead"$'\t'"$changes"$'\t'"$agent"$'\t'"$kept"$'\t'"$time"
    fi
    return 0
  }
  each_record sort_work <<<"$1"
}

# A local work row's name (a local-work record): its worktree's directory,
# else its clone's
# shellcheck disable=SC2154 # record fields, set by each_record
local_name() { if [ "$worktree" != - ]; then basename "$worktree"; else basename "$clone"; fi; }

# Asks before pushing (a rofi dialog, as confirm_queue)
# Usage: confirm_push <branch> <commits> <upstream: yes, none or gone>
confirm_push() {
  local mesg what="Push"
  mesg="<b>$(escape "$1")</b>"$'\n'"$2 commit$([ "$2" -gt 1 ] && echo s) to push"
  [ "$3" = yes ] || mesg+=", on a new remote branch"
  [ "$(printf '%s\n' Cancel "$what to origin" |
    rofi -dmenu -i -no-custom -p "$prompt" -format i -theme-str "$layout window { width: calc(48ch + 2em min 100%); }" \
      -mesg "$mesg")" = 1 ]
}

# Pushes <branch> of <clone> to origin, under the same name (tracking it
# when it never was). Prints git's complaint when it refuses
# Usage: push_branch <clone> <branch> <upstream: yes, none or gone>
push_branch() {
  local track=()
  [ "$2" = yes ] || track=(--set-upstream)
  timeout 60 git -C "$1" push --quiet "${track[@]}" origin "refs/heads/$2:refs/heads/$2" 2>&1
}

# Key hints: <key>=<what it does>…, the keys dimmer than what they do, the
# separators dimmer still
hints() {
  local hint out='' separator=' <span fgalpha="35%">•</span> '
  for hint; do
    out+="${out:+$separator}<span $dim>$(escape "<${hint%%=*}>")</span> $(escape "${hint#*=}")"
  done
  printf '%s' "$out"
}
# The message bar goes under the list, centered (theme.rasi puts it above:
# its gutter flips with it), in a smaller font (see -mesg)
layout='content { children: [inputbar, listview, message]; }
  message { margin: 0.5em 1em 1em 1em; }
  textbox { horizontal-align: 0.5; }'
mesg=$(hints enter=open ctrl+r=refresh ctrl+q='queue page' ctrl+s=agent ctrl+m='merge queue' ctrl+o=push)

# The time column of one of my pull requests (a merge-queue record): its
# position and when it should merge (queued), nothing (ready), else since the
# merge (deploying), since it reached production (deployed), or the last
# update
# shellcheck disable=SC2154 # record fields, set by each_record
mine_when() {
  case $kind in
    queued) printf '#%s' "$position"; [ "$time" = - ] || printf ' (%s)' "$(eta "$time")" ;;
    ready) ;;
    *) ago $((now - time)) ;;
  esac
}

# The time column of a pull request waiting on my review: for how long
# shellcheck disable=SC2154 # record fields, set by each_record
review_when() { ago $((now - at)); }

# Sets time_width, number_width, plus_width, minus_width, threads_width,
# comments_width and approvals_width (0 when none has any):
# the widest time, pull request number, additions and deletions (their sign
# included), unresolved threads and open comments (glyph, space and count; 0
# when none has any) of the merge-queue records ($1) and the review-queue ones ($2), so that
# columns line up without padding them all for the widest possible (a queued
# one's "#37 (1h14)"). And agents_width: 3 when an agent works on one (see
# agents), else 0; work_width: the widest local work (see row), 0 when none.
# The loose agents' rows too ($3, see find_loose_agents): their turn's
# duration, their face, their project (the number widened for the longest).
# And the local work's rows ($4, see find_local_work): alike, their name
# (see local_name) as the project
# shellcheck disable=SC2154 # record fields, set by each_record
measure_columns() {
  local when
  time_width=0 number_width=0 plus_width=0 minus_width=0 threads_width=0 comments_width=0 approvals_width=0 agents_width=0 work_width=0
  widest() { # <time>
    [ ${#1} -gt "$time_width" ] && time_width=${#1}
    [ ${#number} -gt "$number_width" ] && number_width=${#number}
    [ $((${#additions} + 1)) -gt "$plus_width" ] && plus_width=$((${#additions} + 1))
    [ $((${#deletions} + 1)) -gt "$minus_width" ] && minus_width=$((${#deletions} + 1))
    if [ "${threads:-0}" -gt 0 ] 2>/dev/null && [ $((${#threads} + 2)) -gt "$threads_width" ]; then
      threads_width=$((${#threads} + 2))
    fi
    if [ "${comments:-0}" -gt 0 ] 2>/dev/null && [ $((${#comments} + 2)) -gt "$comments_width" ]; then
      comments_width=$((${#comments} + 2))
    fi
    [ "${approvals:--}" != - ] && [ ${#approvals} -gt "$approvals_width" ] && approvals_width=${#approvals}
    [ -n "${agents[$repo#$number]}" ] && agents_width=3
    widest_work "${work_of[$repo#$branch]:-${pr_work[$repo#$number]}}"
  }
  widest_work() { # <work cell>
    local ahead changed text
    read -r ahead changed _ <<<"$1"
    text=$(work_text "$ahead" "$changed")
    [ ${#text} -gt "$work_width" ] && work_width=${#text}
    return 0
  }
  widest_mine() { when=$(mine_when); widest "$when"; }
  widest_review() { local branch='' approvals=''; when=$(review_when); widest "$when"; } # (no branch field)
  each_record widest_mine <<<"$1"
  each_record widest_review <<<"$2"
  local project_width=0
  widest_agent() {
    agents_width=3
    when=$(agent_when); [ ${#when} -gt "$time_width" ] && time_width=${#when}
    [ ${#project} -gt "$project_width" ] && project_width=${#project}
  }
  each_record widest_agent <<<"$3"
  widest_local() {
    when=$(ago $((now - time))); [ ${#when} -gt "$time_width" ] && time_width=${#when}
    [ ${#name} -gt "$project_width" ] && project_width=${#name}
    widest_work "$ahead $changes"
    [ "$agent" != - ] && agents_width=3
    return 0
  }
  local name
  each_local() { name=$(local_name); widest_local; }
  each_record each_local <<<"$4"
  local room=$((number_width + plus_width + minus_width + 3))
  [ "$project_width" -gt "$room" ] && number_width=$((number_width + project_width - room))
  return 0
}

# The time column of an agent (a claude-agent-list record): how long its turn
# has run, when running (or monitoring)
# shellcheck disable=SC2154 # record fields, set by each_record
agent_when() { case $state in running | monitoring) [ "$since" != - ] && elapsed "$since" ;; esac; return 0; }

# Adds an agent (a claude-agent-list record): Enter and Ctrl+s go back to it
# shellcheck disable=SC2154 # record fields, set by each_record
agent() {
  local transcript
  transcript=$(read_agent "$agents_dir/$session" agent_; echo "$agent_transcript")
  urls+=('') queues+=('') prs+=('') merges+=('') sessions+=("$session") dirs+=('') pushes+=('') tags+=(:agent)
  lines+=("$(row time="$(agent_when)" project="$project" title="$(agent_title "$transcript")" agent="$state")")
}

# Adds one of my pull requests (a merge-queue record, see each_record) if it
# belongs to $group: open (needs me, or someone else), auto (auto-merge on:
# on its way to the queue), queued, deploying (merged, not in production
# yet) or deployed (in production lately)
# shellcheck disable=SC2154 # record fields, set by each_record
mine() {
  local in=open when tag=:open diff='' face italic='' line
  case $kind in queued | deploying | deployed) in=$kind ;; *) [ "$auto" = auto ] && in=auto ;; esac
  [ "$in" = "$group" ] || return 0
  case $kind in queued | deploying | deployed) tag=:$kind ;; esac
  when=$(mine_when)
  # On their way (auto-merge on), in the queue or merged: the diff in the
  # fade too
  [ "$in" = open ] || diff=plain
  # In the queue, its required checks passed (a failing one is optional): the
  # CI face tells its merge group's instead, the run that matters now
  # (passed, before GitHub builds one)
  if [ "$in" = queued ]; then
    review=QUEUED approvals=- ci=SUCCESS
    case $queue_ci in FAILURE | PENDING) ci=$queue_ci ;; esac
  fi
  # MERGED, DEPLOYING or DEPLOYED; no queue to open, nothing for an agent to
  # fix (Ctrl+s)
  case $in in deploying | deployed) review=$state ci='' queue_url='' threads=0 comments=0 ;; esac
  # GitHub hasn't worked out whether it's mergeable yet (the approved face
  # would read ready): the review face says so, the row too. In the face
  # only, as the merge and the agent want the review itself
  face=$review
  [ "$state" = UNKNOWN ] && face=UNKNOWN italic=italic
  line=$(row ci="$ci" review="$face" time="$when" number="$number" additions="$additions" deletions="$deletions" \
    title="$title" auto="$auto" diff="$diff" threads="$threads" comments="$comments" approvals="$approvals" italic="$italic" \
    work="${work_of[$repo#$branch]:-${pr_work[$repo#$number]}}" agent="${agents[$repo#$number]}")
  # Queued and merged ones stay in the background: they move on their own;
  # those with auto-merge on, a bit less (they will join the queue by
  # themselves)
  case $in in
    open) ;;
    auto) line="<span fgalpha=\"80%\">$line</span>" ;;
    *) line="<span fgalpha=\"60%\">$line</span>" ;;
  esac
  # The merge queue: can join it (ready ones; and what Ctrl+m checks first),
  # waits for GitHub's page (other open ones), can leave it (queued), or
  # neither (merged)
  local merge=''
  case $in in
    open | auto)
      if [ "$kind" = ready ]; then merge="$repo $number out ${ci:--} ${review:--} ${state:--} ${threads:-0} ${comments:-0}"
      else merge="$repo $number page"; fi ;;
    queued) merge="$repo $number in" ;;
  esac
  # Deployed: nothing left to push (squashed, its commits are on no remote
  # branch)
  local push=${push_of[$repo#$branch]}
  case $in in deploying | deployed) push='' ;; esac
  urls+=("$url") queues+=("$queue_url") prs+=("fix $repo $number") merges+=("$merge")
  tags+=("$tag${agents[$repo#$number]:+ :agent}${work_of[$repo#$branch]:+ :local}${pr_work[$repo#$number]:+ :local}${push:+ :unpushed}") sessions+=('') dirs+=('') pushes+=("$push") lines+=("$line")
}

# Adds local work no pull request of mine holds (a local-work record, see
# find_local_work): Enter goes to the agent working there, else neovim in its
# worktree, else GitHub's page to open a pull request for it (pushed)
# shellcheck disable=SC2154 # record fields, set by each_record
local_row() {
  local title state='' url='' push='' tended=-
  if [ "$branch" = - ]; then title='detached HEAD'; else title=$branch; fi
  [ "$branch" != - ] && [ "$upstream" = none ] && title+=' (never pushed)'
  [ "$kept" = yes ] && title+=" (a stopped agent's, kept)"
  if [ "$agent" != - ]; then state=${agent_states[$agent]} tended=yes; fi
  [ "$branch" != - ] && [ "$upstream" = yes ] && url="https://github.com/$repo/compare/$branch?expand=1"
  [ "$branch" != - ] && [ "$ahead" -gt 0 ] && push="$clone $branch $upstream $ahead"
  urls+=("$url") queues+=('') prs+=('') merges+=('') sessions+=("$([ "$agent" != - ] && echo "$agent")")
  dirs+=("$([ "$worktree" != - ] && echo "$worktree")") pushes+=("$push")
  tags+=(":local${push:+ :unpushed}${state:+ :agent}")
  lines+=("$(row time="$(ago $((now - time)))" project="$(local_name)" title="$title" \
    work="$ahead $changes $tended" agent="$state")")
}

# Adds a pull request waiting on my review (a review-queue record) if it
# belongs to $group: mine (requested from me) or team (from one of my teams
# only)
# shellcheck disable=SC2154 # record fields, set by each_record
review() {
  local in=mine waited=$((now - at)) tint='' line
  [ "${team:--}" = - ] || in=team
  [ "$in" = "$group" ] || return 0
  # The review face, warmer as the wait grows: 4h, then a day (mine only)
  if [ "$in" = team ]; then :
  elif [ "$waited" -ge 86400 ]; then tint=$red
  elif [ "$waited" -ge 14400 ]; then tint=$yellow; fi
  line=$(row ci="$ci" review=REVIEW_REQUIRED time="$(review_when)" number="$number" additions="$additions" \
    deletions="$deletions" author="$author" title="$title" tint="$tint" threads="$threads" comments="$comments" \
    work="${pr_work[$repo#$number]}" agent="${agents[$repo#$number]}")
  # My teams': in the background, as those with auto-merge on
  [ "$in" = team ] && line="<span fgalpha=\"80%\">$line</span>"
  urls+=("$url") queues+=('') prs+=("review $repo $number") merges+=('') sessions+=('') dirs+=('') pushes+=('')
  tags+=(":$([ "$in" = team ] && echo team || echo review)${agents[$repo#$number]:+ :agent}${pr_work[$repo#$number]:+ :local}")
  lines+=("$line")
}

while :; do
  # The trackers side by side (their output in files meanwhile: gone before
  # anything else, as we may exec away)
  outputs=$(mktemp -d)
  "$assets/merge-queue" $mode >"$outputs/mine" 2>&1 &
  mine_pid=$!
  "$assets/review-queue" $mode >"$outputs/reviews" 2>&1 &
  reviews_pid=$!
  # Local work: its cache, refreshed behind us for the next time (computing
  # it takes a while, see local-work), unless asked for now (Ctrl+r, a push)
  work_mode=$mode
  [ -n "$work_now" ] && work_mode='' work_now=''
  "$assets/local-work" $work_mode >"$outputs/local" 2>/dev/null & # the same list: they complain
  local_pid=$!
  [ "$work_mode" = --cached ] && setsid -f "$assets/local-work" >/dev/null 2>&1
  wait "$mine_pid"; mine_status=$?
  wait "$reviews_pid"; reviews_status=$?
  wait "$local_pid"
  mine=$(<"$outputs/mine") reviews=$(<"$outputs/reviews") work=$(<"$outputs/local")
  rm -r "$outputs"
  mode=--cached

  # Both read the same repository list: one complaint is enough
  if [ "$mine_status" -eq 2 ] || [ "$reviews_status" -eq 2 ]; then
    [ "$mine_status" -eq 2 ] && message=${mine#merge-queue: } || message=${reviews#review-queue: }
    notify-send --app-name=github --urgency=critical "GitHub not watched" "$message"
    exit 1
  fi

  urls=()
  queues=()
  merges=() # <repo> <number> <in (the merge queue), out (ready to join it) or page (not ready)> [<CI> <review> <state> <threads> <comments>] (mine, unless merged)
  prs=() # <agent task> <repo> <number>
  sessions=() # the agent (an agent's row), else empty
  dirs=() # the worktree to open (local work, without an agent), else empty
  pushes=() # <clone> <branch> <upstream> <commits> to push (Ctrl+o), else empty
  tags=()
  lines=()
  now=$(date +%s)
  find_agents
  find_local_work "$work" "$mine" "$reviews"
  find_loose_agents "$mine" "$reviews" "$local_work"
  measure_authors <<<"$reviews"
  measure_columns "$mine" "$reviews" "$loose_agents" "$local_work"

  # First, the agents: one waiting on me is the most urgent
  each_record agent <<<"$loose_agents"
  group=open each_record mine <<<"$mine"
  # Then what lies here, unpublished, or left behind
  each_record local_row <<<"$local_work"
  group=mine each_record review <<<"$reviews"
  group=team each_record review <<<"$reviews"
  # Last, as they need nothing from me: on their way to the queue, in it,
  # merged, then in production
  group=auto each_record mine <<<"$mine"
  group=queued each_record mine <<<"$mine"
  group=deploying each_record mine <<<"$mine"
  group=deployed each_record mine <<<"$mine"

  if [ ${#lines[@]} -eq 0 ]; then
    notify-send --app-name=github GitHub "No agent, no open pull request, nothing lying here, nothing waiting on your review 🎉"
    exit 0
  fi

  # GitHub unreachable (exit 1): the trackers printed what they last knew
  status_line=''
  if [ "$mine_status" -eq 1 ] || [ "$reviews_status" -eq 1 ]; then
    status_line=$'\n'"<span color=\"$red\">Could not reach GitHub: showing the last known state</span>"
  fi

  # The window: as wide as the widest row, or the message bar (in its 90%
  # font), with their padding (theme.rasi's elem-gutter, the message's
  # margin: 1em on each side), up to max_width, and the monitor
  widest=$(( ($(shown_width "$mesg$status_line") * 9 + 9) / 10 ))
  for line in "${lines[@]}"; do
    width=$(shown_width "$line")
    [ "$width" -gt "$widest" ] && widest=$width
  done
  [ "$widest" -gt "$max_width" ] && widest=$max_width
  window="window { width: calc(${widest}ch + 2em min 100%); }"

  # Tags go in each row's invisible search terms (meta)
  selection=$(for i in "${!lines[@]}"; do printf '%s\0meta\x1f%s\n' "${lines[$i]}" "${tags[$i]}"; done |
    rofi -dmenu -i -markup-rows -p "$prompt" -format 'i f' -filter "$filter" \
      -kb-custom-1 'Control+r' -kb-custom-2 'Control+q' -kb-custom-3 'Control+s' -kb-custom-4 'Control+m' -kb-custom-5 'Control+o' \
      -kb-accept-entry 'Control+j,Return,KP_Enter' -theme-str "$layout $window" -mesg "<span size=\"90%\">$mesg$status_line</span>")
  code=$?
  read -r choice filter <<<"$selection" # keep the search across refreshes
  [ "$choice" -ge 0 ] 2>/dev/null || choice=''

  case $code in
    0)
      [ -n "$choice" ] || exit 0
      [ -n "${sessions[$choice]}" ] && exec "$assets/claude-agent-jump" "${sessions[$choice]}"
      [ -n "${dirs[$choice]}" ] && exec setsid -f kitty --directory "${dirs[$choice]}" nvim >/dev/null 2>&1
      [ -n "${urls[$choice]}" ] && exec browser-kiosk "${urls[$choice]}"
      notify-send --app-name=github GitHub "Nothing to open yet: push it first (Ctrl+o)"
      exit 0 ;;
    10) mode='' ;;
    11) [ -n "$choice" ] && [ -n "${queues[$choice]}" ] && exec browser-kiosk "${queues[$choice]}" ;; # reviews: stay
    12)
      if [ -n "$choice" ] && [ -n "${sessions[$choice]}" ]; then
        exec "$assets/claude-agent-jump" "${sessions[$choice]}"
      elif [ -n "$choice" ]; then
        # Back to the agent on it, if any; nothing to fix: says so (see
        # claude-agent-pr)
        read -r pr_task pr_repo pr_number <<<"${prs[$choice]}"
        [ -n "$pr_task" ] && exec "$assets/claude-agent-pr" "$pr_task" "$pr_repo" "$pr_number"
      fi ;;
    13)
      if [ -n "$choice" ]; then
        read -r merge_repo merge_number merge_queue merge_ci merge_review merge_state merge_threads merge_comments <<<"${merges[$choice]}"
        concerns=''
        [ "$merge_queue" = out ] && concerns=$(queue_concerns "$merge_ci" "$merge_review" "$merge_state" "$merge_threads" "$merge_comments" "$merge_repo" "$merge_number")
        if [ -z "$merge_repo" ]; then
          notify-send --app-name=github GitHub "The merge queue is for my open pull requests"
        elif [ "$merge_queue" = page ]; then
          # "Merge when ready" there: the merge box sits right above the
          # comment box (it has no anchor of its own showing logged out)
          exec browser-kiosk "${urls[$choice]}#issue-comment-box"
        elif [ -n "$concerns" ] && ! confirm_queue "$merge_repo#$merge_number" "$concerns"; then
          : # back to the list
        elif result=$(toggle_queue "$merge_repo" "$merge_number" "$merge_queue" 2>&1); then
          # Leaving it: merge-queue tells, refreshing
          [ "$merge_queue" = out ] && notify-send --app-name=github "Merge when ready" "$merge_repo#$merge_number"$'\n'"$result"
          mode='' # show where it stands
        else
          notify-send --app-name=github --urgency=critical \
            "$([ "$merge_queue" = out ] && echo "Not added to" || echo "Not removed from") the merge queue" \
            "$merge_repo#$merge_number"$'\n'"$result"
        fi
      fi ;;
    14)
      if [ -n "$choice" ] && [ -n "${pushes[$choice]}" ]; then
        read -r push_clone push_branch push_upstream push_commits <<<"${pushes[$choice]}"
        if confirm_push "$push_branch" "$push_commits" "$push_upstream"; then
          if result=$(push_branch "$push_clone" "$push_branch" "$push_upstream"); then
            work_now=yes # its row goes
            notify-send --app-name=github "Pushed" "$push_branch ($(basename "$push_clone"))"
          else
            notify-send --app-name=github --urgency=critical "Not pushed" "$push_branch ($(basename "$push_clone"))"$'\n'"$result"
          fi
        fi
      elif [ -n "$choice" ]; then
        notify-send --app-name=github GitHub "Nothing to push there"
      fi ;;
    *) exit 0 ;;
  esac
done
