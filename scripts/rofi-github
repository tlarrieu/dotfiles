#!/usr/bin/env bash
# Rofi hub for my GitHub pull requests (see merge-queue: drafts, blocked, ready),
# those waiting on my review (see review-queue), then mine with auto-merge on,
# mine in the merge queue, and mine merged but not in production yet.
# Usage: rofi-github [filter]  (prefilled search; each row also matches an
# invisible tag: :open, :queued, :deploying or :review)
# Columns: CI (the last commit's checks), then review (conflict, draft,
# changes requested, approved, or waiting for one; in the merge queue
# instead, for queued ones; merged, or being deployed, for deploying ones),
# then time: since the last update, waiting on my review for how long, for
# queued ones the position and when it should merge (#37 (1h14)), for
# deploying ones since the merge. A merge glyph before the number: auto-merge is on (it
# joins the queue once ready). A speech bubble before the title: unresolved
# review threads, how many. All red: GitHub can't tell whether it's
# mergeable, see on GitHub why.
# Enter: open in the browser. Ctrl+r: refresh from GitHub. Ctrl+q: open the merge
# queue page of the selected pull request's repository (mine only). Ctrl+s:
# spawn an agent on it (see claude-agent-pr): fixing its unresolved review
# threads and failing CI (mine), or reviewing it (others').

assets=$(dirname "$(readlink -f "$0")")
# shellcheck source-path=SCRIPTDIR source=lib/github.sh
. "$assets/lib/github.sh"
# shellcheck source-path=SCRIPTDIR source=lib/rofi.sh
. "$assets/lib/rofi.sh"
mode=--cached
filter=$1

# Pango attributes for each face's glyph (see lib/rofi.sh for $dim)
declare -A styles=(
  [SUCCESS]="color=\"$green\"" [FAILURE]="color=\"$red\"" [PENDING]="color=\"$blue\""
  [CONFLICT]="color=\"$red\"" [CHANGES_REQUESTED]="color=\"$yellow\""
  [APPROVED]="color=\"$green\"" [REVIEW_REQUIRED]=$dim [QUEUED]=$dim
  [MERGED]=$dim [DEPLOYING]="color=\"$blue\""
)

declare -A faces=(
  # CI
  [SUCCESS]='󰗠'
  [FAILURE]='󰅙'
  [PENDING]='󰦖'
  # Review
  [CONFLICT]='󰀩'
  [DRAFT]=''
  [CHANGES_REQUESTED]='󰏫'
  [APPROVED]='󰔓'
  [REVIEW_REQUIRED]='󰈈'
  # Merge queue
  [QUEUED]=''
  # Deploy
  [MERGED]=''
  [DEPLOYING]='󱓞'
)

auto_glyph='󰘬' # auto-merge on
# Titles followed by an author (see row) share this many characters with
# it (and the two spaces between): the title gets what the longest author
# leaves, at least min_title_width
title_and_author=92 min_title_width=70

# Sets title_width from the review-queue records on stdin
# shellcheck disable=SC2154 # record fields, set by each_record
measure_authors() {
  local longest=0
  longest_author() { [ ${#author} -gt "$longest" ] && longest=${#author}; }
  each_record longest_author
  title_width=$((title_and_author - 2 - longest))
  [ "$title_width" -ge "$min_title_width" ] || title_width=$min_title_width
}
thread_glyph='󰵅' # unresolved review threads


# Rows: <CI> <review> <time> <number> <+> <−> <author> <title>
#   (shown in another order: the author goes last)
#   [<review color>] [<auto merge: auto>] [<diff: plain>] [<unresolved threads>]
#   [<line color>]
# (the review color, for reviews waiting on me: overrides the review style;
# the line color overrides every color in the row)
# CI and review are faces keys (unknown ones show as ?, missing ones as blank)
# Pad before adding markup, which would otherwise count towards the widths
row() {
  local ci review plus minus who='' title=$8 threads auto=' ' line # the glyph takes one cell, like a space
  [ "${10}" = auto ] && auto=$auto_glyph
  # Faces are 3 cells wide: the glyph (one cell, blank when missing), then two
  # spaces. Style the glyphs only (a review color wins over the review face's
  # own style), unless the line color does it all
  local style
  ci=${1:+${faces[$1]:-?}} review=${2:+${faces[$2]:-?}}
  if [ -z "${13}" ]; then
    [ -n "$1" ] && style=${styles[$1]} && [ -n "$style" ] && ci="<span $style>$ci</span>"
    style=''
    [ -n "$2" ] && style=${styles[$2]}
    [ -n "$9" ] && style="color=\"$9\""
    [ -n "$style" ] && [ -n "$review" ] && review="<span $style>$review</span>"
  fi
  ci="${ci:- }  " review="${review:- }  "
  plus=$(printf '%7s' "+$5") minus=$(printf '%-7s' "−$6")
  # Last, fainter than dim. The title before it gets a fixed width (in
  # characters, as they are cells), so that a long one can't push it out of
  # the window
  if [ -n "$7" ]; then
    who="  <span fgalpha=\"40%\">$(escape "$7")</span>"
    [ ${#title} -gt "$title_width" ] && title="${title:0:title_width-1}…"
    title+=$(printf '%*s' $((title_width - ${#title})) '')
  fi
  # 4 cells: glyph, space, count, dim (blank without any unresolved)
  threads='    '
  if [ "${12:-0}" -gt 0 ] 2>/dev/null; then
    threads="<span $dim>$thread_glyph ${12}</span>"
    [ ${#12} -lt 2 ] && threads+=' ' # wider counts push the title instead
  fi
  if [ "${11}" != plain ] && [ -z "${13}" ]; then
    plus="<span color=\"$green\">$plus</span>" minus="<span color=\"$red\">$minus</span>"
  fi
  # Time: 10 cells, as a queued one's "#37 (1h14)"
  line=$(printf '%s%s%-10s %s #%-7s %s %s  %s  %s%s' \
    "$ci" "$review" "$3" "$auto" "$4" "$plus" "$minus" "$threads" "$(escape "$title")" "$who")
  [ -n "${13}" ] && line="<span color=\"${13}\">$line</span>"
  printf '%s' "$line"
}

# Key hints: <key>=<what it does>…, the keys dimmer than what they do, the
# separators dimmer still
hints() {
  local hint out='' separator=' <span fgalpha="35%">•</span> '
  for hint; do
    out+="${out:+$separator}<span $dim>$(escape "<${hint%%=*}>")</span> $(escape "${hint#*=}")"
  done
  printf '%s' "$out"
}
# The message bar goes under the list, centered (theme.rasi puts it above:
# its gutter flips with it), in a smaller font (see -mesg)
layout='content { children: [inputbar, listview, message]; }
  message { margin: 0.5em 1em 1em 1em; }
  textbox { horizontal-align: 0.5; }'
mesg=$(hints enter=open ctrl+r=refresh ctrl+q='queue page' ctrl+s=agent)

# Adds one of my pull requests (a merge-queue record, see each_record) if it
# belongs to $group: open (needs me, or someone else), auto (auto-merge on:
# on its way to the queue), queued or deploying (merged, not in production
# yet)
# shellcheck disable=SC2154 # record fields, set by each_record
mine() {
  local in=open when tag diff='' color='' line
  if [ "$kind" = queued ] || [ "$kind" = deploying ]; then in=$kind; elif [ "$auto" = auto ]; then in=auto; fi
  [ "$in" = "$group" ] || return 0
  case $kind in
    queued) when="#$position" tag=:queued; [ "$time" = - ] || when+=" ($(eta "$time"))" ;;
    ready) when='' tag=:open ;;
    deploying) when=$(ago $((now - time))) tag=:deploying ;; # since the merge
    *) when=$(ago $((now - time))) tag=:open ;; # since last update
  esac
  # On their way (auto-merge on) or in the queue: the diff in the fade too
  [ "$in" = open ] || diff=plain
  [ "$in" = queued ] && review=QUEUED
  # MERGED or DEPLOYING; no queue to open, nothing for an agent to fix (Ctrl+s)
  [ "$in" = deploying ] && review=$state ci='' queue_url='' threads=0
  # GitHub can't tell whether it's mergeable (the icons alone would read ready)
  [ "$state" = UNKNOWN ] && color=$red
  line=$(row "$ci" "$review" "$when" "$number" "$additions" "$deletions" '' "$title" '' "$auto" "$diff" "$threads" "$color")
  # Queued and deploying ones stay in the background: they move on their
  # own; those with auto-merge on, a bit less (they will join the queue by
  # themselves)
  case $in in
    queued | deploying) line="<span fgalpha=\"60%\">$line</span>" ;;
    auto) line="<span fgalpha=\"80%\">$line</span>" ;;
  esac
  urls+=("$url") queues+=("$queue_url") prs+=("fix $repo $number ${threads:-0} ${ci:--}") tags+=("$tag") lines+=("$line")
}

# Adds a pull request waiting on my review (a review-queue record)
# shellcheck disable=SC2154 # record fields, set by each_record
review() {
  local waited=$((now - at)) tint=''
  # The review face, warmer as the wait grows: 4h, then a day
  if [ "$waited" -ge 86400 ]; then tint=$red
  elif [ "$waited" -ge 14400 ]; then tint=$yellow; fi
  urls+=("$url") queues+=('') prs+=("review $repo $number") tags+=(:review)
  lines+=("$(row "$ci" REVIEW_REQUIRED "$(ago "$waited")" "$number" "$additions" "$deletions" "$author" "$title" "$tint" '' '' "$threads")")
}

while :; do
  mine=$("$assets/merge-queue" $mode 2>&1)
  mine_status=$?
  reviews=$("$assets/review-queue" $mode 2>&1)
  reviews_status=$?
  mode=--cached

  # Both read the same repository list: one complaint is enough
  if [ "$mine_status" -eq 2 ] || [ "$reviews_status" -eq 2 ]; then
    [ "$mine_status" -eq 2 ] && message=${mine#merge-queue: } || message=${reviews#review-queue: }
    notify-send --app-name=github --urgency=critical "GitHub not watched" "$message"
    exit 1
  fi

  urls=()
  queues=()
  prs=() # <agent task> <repo> <number> [<unresolved threads> <CI>] (the last two: mine)
  tags=()
  lines=()
  now=$(date +%s)
  measure_authors <<<"$reviews"

  # ci, review and threads blank: a cache from before these fields keeps them so
  ci='' review='' threads='' group=open each_record mine <<<"$mine"
  ci='' threads='' each_record review <<<"$reviews"
  # Last, as they need nothing from me: on their way to the queue, in it,
  # then merged
  ci='' review='' threads='' group=auto each_record mine <<<"$mine"
  ci='' review='' threads='' group=queued each_record mine <<<"$mine"
  ci='' review='' threads='' group=deploying each_record mine <<<"$mine"

  if [ ${#lines[@]} -eq 0 ]; then
    notify-send --app-name=github GitHub "No open pull request, nothing waiting on your review 🎉"
    exit 0
  fi

  # GitHub unreachable (exit 1): the trackers printed what they last knew
  status_line=''
  if [ "$mine_status" -eq 1 ] || [ "$reviews_status" -eq 1 ]; then
    status_line=$'\n'"<span color=\"$red\">Could not reach GitHub: showing the last known state</span>"
  fi

  # Tags go in each row's invisible search terms (meta)
  selection=$(for i in "${!lines[@]}"; do printf '%s\0meta\x1f%s\n' "${lines[$i]}" "${tags[$i]}"; done |
    rofi -dmenu -i -markup-rows -p '' -format 'i f' -filter "$filter" \
      -kb-custom-1 'Control+r' -kb-custom-2 'Control+q' -kb-custom-3 'Control+s' -theme-str "$layout" -mesg "<span size=\"90%\">$mesg$status_line</span>")
  code=$?
  read -r choice filter <<<"$selection" # keep the search across refreshes
  [ "$choice" -ge 0 ] 2>/dev/null || choice=''

  case $code in
    0) [ -n "$choice" ] && exec browser-kiosk "${urls[$choice]}"; exit 0 ;;
    10) mode='' ;;
    11) [ -n "$choice" ] && [ -n "${queues[$choice]}" ] && exec browser-kiosk "${queues[$choice]}" ;; # reviews: stay
    12)
      if [ -n "$choice" ]; then
        read -r pr_task pr_repo pr_number pr_threads pr_ci <<<"${prs[$choice]}"
        # The cache may lag: Ctrl+r first when threads came in (or CI failed) since
        if [ "$pr_task" = fix ] && [ "$pr_threads" -eq 0 ] 2>/dev/null && [ "$pr_ci" != FAILURE ]; then
          notify-send --app-name=github GitHub "Nothing to fix on $pr_repo#$pr_number: no unresolved review thread, no failing CI"
        else
          exec "$assets/claude-agent-pr" "$pr_task" "$pr_repo" "$pr_number"
        fi
      fi ;;
    *) exit 0 ;;
  esac
done
