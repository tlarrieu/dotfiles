#!/usr/bin/env bash
# Rofi hub for my GitHub pull requests (see merge-queue: drafts, blocked, ready),
# those waiting on my review (see review-queue), then mine with auto-merge on
# and mine in the merge queue.
# Usage: rofi-github [filter]  (prefilled search; each row also matches an
# invisible tag: :open, :queued or :review)
# A merge glyph before the number: auto-merge is on (it joins the queue once
# ready).
# Enter: open in the browser. Alt+r: refresh from GitHub. Alt+q: open the merge
# queue page of the selected pull request's repository (mine only).

assets=$(dirname "$(readlink -f "$0")")
mode=--cached
filter=$1

# Colors from the current rofi palette: additions, deletions, review waits
rofi_dir=~/.config/rofi
variant=$(sed -n 's/^@import "\(.*\)".*/\1/p' "$rofi_dir/variant.rasi" 2>/dev/null)
color() { sed -n "s/^\s*$1:\s*\(#[0-9a-fA-F]*\);.*/\1/p" "$rofi_dir/${variant:-dark}.rasi" 2>/dev/null | head -1; }
green=$(color green) red=$(color red) yellow=$(color yellow)
green=${green:-green} red=${red:-red} yellow=${yellow:-yellow}

declare -A faces=(
  [QUEUED]='󰔟'
  [AWAITING_CHECKS]='󰦖'
  [MERGEABLE]='󰄬'
  [UNMERGEABLE]='󰀦'
  [LOCKED]='󰌾'
  [READY]='󰐕'
  [CONFLICT]='󰀩'
  [CHECKS_FAILING]='󰅙'
  [CHANGES_REQUESTED]='󰏫'
  [CHECKS_PENDING]='󰦖'
  [REVIEW_REQUIRED]='󰈈'
  [UNKNOWN]='󰋗'
  [DRAFT]='󰈤'
)

auto_glyph='󰘬' # auto-merge on

# What blocks my other pull requests, in a word
declare -A blockers=(
  [CONFLICT]=conflict
  [CHECKS_FAILING]=checks
  [CHANGES_REQUESTED]=changes
  [CHECKS_PENDING]=running
  [REVIEW_REQUIRED]=approval
  [UNKNOWN]=unknown
  [DRAFT]=draft
)

# Compact durations: 42m, 3h, 2d (minutes rounded up, for ETAs)
duration() {
  if [ "$1" -lt 3600 ]; then echo "$((($1 + 59) / 60))m"
  elif [ "$1" -lt 86400 ]; then echo "$(($1 / 3600))h"
  else echo "$(($1 / 86400))d"; fi
}

escape() { sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g' <<<"$1"; }

# Rows: <face> <status> <time> <number> <+> <−> <author> <title> [<face color>]
#   [<auto merge: auto>] [<diff: plain>]
# Pad before adding markup, which would otherwise count towards the widths
row() {
  local face plus minus who auto=' ' # the glyph takes one cell, like a space
  [ "${10}" = auto ] && auto=$auto_glyph
  face=$(printf '%-5s' "$1")
  [ -n "$9" ] && face="<span color=\"$9\">$face</span>"
  plus=$(printf '%7s' "+$5") minus=$(printf '%-7s' "−$6") who=$(printf '%-20s' "${7:0:20}")
  if [ "${11}" != plain ]; then
    plus="<span color=\"$green\">$plus</span>" minus="<span color=\"$red\">$minus</span>"
  fi
  printf '%s %-8s %-6s %s #%-7s %s %s  %s  %s' \
    "$face" "$2" "$3" "$auto" "$4" "$plus" "$minus" "$(escape "$who")" "$(escape "$8")"
}

# Icons and their meaning, under the keys: a grid filled column by column,
# <rows> high (the text is ASCII: padding in bytes is padding in cells)
legend() {
  local rows=$1 i key text glyph cell
  shift
  local -a lines=()
  for ((i = 1; i <= $#; i++)); do
    key=${!i%%=*} text=${!i#*=}
    [ "$key" = AUTO ] && glyph=$auto_glyph || glyph=${faces[$key]}
    cell="$glyph $(printf '%-20s' "$text")"
    lines[(i - 1) % rows]+="${lines[(i - 1) % rows]:+  }$cell"
  done
  printf '%s\n' "${lines[@]}" | sed 's/ *$//'
}
mesg="Enter: open  •  Alt+r: refresh  •  Alt+q: queue page"
# In lifecycle order: what blocks a pull request, getting it ready, the queue
mesg+=$'\n'$(legend 3 \
  DRAFT=draft CONFLICT=conflict CHECKS_FAILING='checks failed' \
  CHANGES_REQUESTED='changes requested' CHECKS_PENDING='checks running' REVIEW_REQUIRED='approval / review' \
  UNKNOWN='mergeability unknown' READY='ready to enqueue' AUTO=auto-merge \
  QUEUED=queued AWAITING_CHECKS='queue checks running' MERGEABLE='queue checks passed' \
  UNMERGEABLE='queue checks failed' LOCKED=merging)

# Add my pull requests, read from merge-queue lines
# A line without url is a GitHub failure message, past the (stale) cache
add_mine() {
  while IFS=$'\t' read -r kind _ number position state time additions deletions auto url queue_url title; do
    [ -n "$url" ] || continue
    case $kind in
      queued)
        where="#$position" tag=:queued
        if [ "$time" = - ]; then when='?'
        elif [ $(((time + 59) / 60)) -lt 60 ]; then when=$(duration "$time") # not "60m"
        else when=$(printf '%dh%02d' $((time / 3600)) $((time % 3600 / 60))); fi
        ;;
      ready) where='ready' when='' tag=:open ;;
      *) where=${blockers[$state]:-$state} when=$(duration $((now - time))) tag=:open ;; # since last update
    esac
    # On their way (auto-merge on) or in the queue: the diff in the fade too
    diff=''
    [ "$kind" = queued ] || [ "$auto" = auto ] && diff=plain
    line=$(row "${faces[$state]:-?}" "$where" "$when" "$number" "$additions" "$deletions" '' "$title" '' "$auto" "$diff")
    # Queued ones stay in the background: they move on their own; those
    # with auto-merge on, a bit less (they will join the queue by themselves)
    if [ "$kind" = queued ]; then line="<span fgalpha=\"60%\">$line</span>"
    elif [ "$auto" = auto ]; then line="<span fgalpha=\"80%\">$line</span>"; fi
    urls+=("$url") queues+=("$queue_url") tags+=("$tag") lines+=("$line")
  done
}

while :; do
  mine=$("$assets/merge-queue" $mode 2>&1)
  mine_status=$?
  reviews=$("$assets/review-queue" $mode 2>&1)
  reviews_status=$?
  mode=--cached

  # Both read the same repository list: one complaint is enough
  if [ "$mine_status" -eq 2 ] || [ "$reviews_status" -eq 2 ]; then
    [ "$mine_status" -eq 2 ] && message=${mine#merge-queue: } || message=${reviews#review-queue: }
    notify-send --app-name=github --urgency=critical "GitHub not watched" "$message"
    exit 1
  fi

  urls=()
  queues=()
  tags=()
  lines=()
  now=$(date +%s)

  # Columns: 1 kind, 9 auto merge (see merge-queue)
  add_mine < <(awk -F'\t' '$1 != "queued" && $9 != "auto"' <<<"$mine")

  while IFS=$'\t' read -r at _ number author additions deletions url title; do
    [ -n "$url" ] || continue
    waited=$((now - at))
    # The review face, warmer as the wait grows: 4h, then a day
    if [ "$waited" -ge 86400 ]; then tint=$red
    elif [ "$waited" -ge 14400 ]; then tint=$yellow
    else tint=''; fi
    if [ "$waited" -lt 3600 ]; then age="$((waited / 60))m"
    elif [ "$waited" -lt 86400 ]; then age="$((waited / 3600))h"
    else age="$((waited / 86400))d$((waited % 86400 / 3600))h"; fi
    line=$(row "${faces[REVIEW_REQUIRED]}" review "$age" "$number" "$additions" "$deletions" "$author" "$title" "$tint")
    urls+=("$url") queues+=('') tags+=(:review) lines+=("$line")
  done <<<"$reviews"

  # Last, as they need nothing from me: on their way to the queue, then in it
  add_mine < <(awk -F'\t' '$1 != "queued" && $9 == "auto"' <<<"$mine")
  add_mine < <(awk -F'\t' '$1 == "queued"' <<<"$mine")

  if [ ${#lines[@]} -eq 0 ]; then
    notify-send --app-name=github GitHub "No open pull request, nothing waiting on your review 🎉"
    exit 0
  fi

  # Tags go in each row's invisible search terms (meta)
  selection=$(for i in "${!lines[@]}"; do printf '%s\0meta\x1f%s\n' "${lines[$i]}" "${tags[$i]}"; done |
    rofi -dmenu -i -markup-rows -p '' -format 'i f' -filter "$filter" \
      -kb-custom-1 'Alt+r' -kb-custom-2 'Alt+q' -mesg "$mesg")
  code=$?
  read -r choice filter <<<"$selection" # keep the search across refreshes
  [ "$choice" -ge 0 ] 2>/dev/null || choice=''

  case $code in
    0) [ -n "$choice" ] && exec browser-kiosk "${urls[$choice]}"; exit 0 ;;
    10) mode='' ;;
    11) [ -n "$choice" ] && [ -n "${queues[$choice]}" ] && exec browser-kiosk "${queues[$choice]}" ;; # reviews: stay
    *) exit 0 ;;
  esac
done
