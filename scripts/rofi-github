#!/usr/bin/env bash
# Rofi hub for my GitHub pull requests (see merge-queue: drafts, blocked, ready),
# those waiting on my review (see review-queue), then mine with auto-merge on
# and mine in the merge queue.
# Usage: rofi-github [filter]  (prefilled search; each row also matches an
# invisible tag: :open, :queued or :review)
# Columns: CI (the last commit's checks), then review (conflict, draft,
# changes requested, approved, or waiting for one). A merge glyph before the
# number: auto-merge is on (it joins the queue once ready).
# Enter: open in the browser. Ctrl+r: refresh from GitHub. Ctrl+q: open the merge
# queue page of the selected pull request's repository (mine only).

assets=$(dirname "$(readlink -f "$0")")
# shellcheck source-path=SCRIPTDIR source=lib/github.sh
. "$assets/lib/github.sh"
# shellcheck source-path=SCRIPTDIR source=lib/rofi.sh
. "$assets/lib/rofi.sh"
mode=--cached
filter=$1

# Pango attributes for each face's glyph (see lib/rofi.sh for $dim)
declare -A styles=(
  [SUCCESS]="color=\"$green\"" [FAILURE]="color=\"$red\"" [PENDING]="color=\"$blue\""
  [CONFLICT]="color=\"$red\"" [CHANGES_REQUESTED]="color=\"$yellow\""
  [APPROVED]="color=\"$green\"" [REVIEW_REQUIRED]=$dim
)

declare -A faces=(
  # CI
  [SUCCESS]='󰗠'
  [FAILURE]='󰅙'
  [PENDING]='󰦖'
  # Review
  [CONFLICT]='󰀩'
  [DRAFT]='󰈤'
  [CHANGES_REQUESTED]='󰏫'
  [APPROVED]='󰔓'
  [REVIEW_REQUIRED]='󰈈'
)

auto_glyph='󰘬' # auto-merge on


# Rows: <CI> <review> <status> <time> <number> <+> <−> <author> <title>
#   [<review color>] [<auto merge: auto>] [<diff: plain>]
# (the review color, for reviews waiting on me: overrides the review style)
# CI and review are faces keys (unknown ones show as ?, missing ones as blank)
# Pad before adding markup, which would otherwise count towards the widths
row() {
  local ci review plus minus who auto=' ' # the glyph takes one cell, like a space
  [ "${11}" = auto ] && auto=$auto_glyph
  # Faces are 3 cells wide: the glyph (one cell, blank when missing), then two
  # spaces. Style the glyphs only (a review color wins over the review face's
  # own style)
  local style
  ci=${1:+${faces[$1]:-?}} review=${2:+${faces[$2]:-?}}
  [ -n "$1" ] && style=${styles[$1]} && [ -n "$style" ] && ci="<span $style>$ci</span>"
  style=''
  [ -n "$2" ] && style=${styles[$2]}
  [ -n "${10}" ] && style="color=\"${10}\""
  [ -n "$style" ] && [ -n "$review" ] && review="<span $style>$review</span>"
  ci="${ci:- }  " review="${review:- }  "
  plus=$(printf '%7s' "+$6") minus=$(printf '%-7s' "−$7") who=$(printf '%-20s' "${8:0:20}")
  if [ "${12}" != plain ]; then
    plus="<span color=\"$green\">$plus</span>" minus="<span color=\"$red\">$minus</span>"
  fi
  printf '%s%s%-8s %-6s %s #%-7s %s %s  %s  %s' \
    "$ci" "$review" "$3" "$4" "$auto" "$5" "$plus" "$minus" "$(escape "$who")" "$(escape "$9")"
}

mesg="Enter: open  •  Ctrl+r: refresh  •  Ctrl+q: queue page"

# Adds one of my pull requests (a merge-queue record, see each_record) if it
# belongs to $group: open (needs me, or someone else), auto (auto-merge on:
# on its way to the queue) or queued
# shellcheck disable=SC2154 # record fields, set by each_record
mine() {
  local in=open where when tag diff='' line
  if [ "$kind" = queued ]; then in=queued; elif [ "$auto" = auto ]; then in=auto; fi
  [ "$in" = "$group" ] || return 0
  case $kind in
    queued) where="#$position" tag=:queued when='?'; [ "$time" = - ] || when=$(eta "$time") ;;
    ready) where='ready' when='' tag=:open ;;
    *) where=$label when=$(ago $((now - time))) tag=:open ;; # since last update
  esac
  # On their way (auto-merge on) or in the queue: the diff in the fade too
  [ "$in" = open ] || diff=plain
  line=$(row "$ci" "$review" "$where" "$when" "$number" "$additions" "$deletions" '' "$title" '' "$auto" "$diff")
  # Queued ones stay in the background: they move on their own; those
  # with auto-merge on, a bit less (they will join the queue by themselves)
  case $in in
    queued) line="<span fgalpha=\"60%\">$line</span>" ;;
    auto) line="<span fgalpha=\"80%\">$line</span>" ;;
  esac
  urls+=("$url") queues+=("$queue_url") tags+=("$tag") lines+=("$line")
}

# Adds a pull request waiting on my review (a review-queue record)
# shellcheck disable=SC2154 # record fields, set by each_record
review() {
  local waited=$((now - at)) tint=''
  # The review face, warmer as the wait grows: 4h, then a day
  if [ "$waited" -ge 86400 ]; then tint=$red
  elif [ "$waited" -ge 14400 ]; then tint=$yellow; fi
  urls+=("$url") queues+=('') tags+=(:review)
  lines+=("$(row "$ci" REVIEW_REQUIRED review "$(ago "$waited")" "$number" "$additions" "$deletions" "$author" "$title" "$tint")")
}

while :; do
  mine=$("$assets/merge-queue" $mode 2>&1)
  mine_status=$?
  reviews=$("$assets/review-queue" $mode 2>&1)
  reviews_status=$?
  mode=--cached

  # Both read the same repository list: one complaint is enough
  if [ "$mine_status" -eq 2 ] || [ "$reviews_status" -eq 2 ]; then
    [ "$mine_status" -eq 2 ] && message=${mine#merge-queue: } || message=${reviews#review-queue: }
    notify-send --app-name=github --urgency=critical "GitHub not watched" "$message"
    exit 1
  fi

  urls=()
  queues=()
  tags=()
  lines=()
  now=$(date +%s)

  # ci and review blank: a cache from before these fields keeps them so
  ci='' review='' group=open each_record mine <<<"$mine"
  ci='' each_record review <<<"$reviews"
  # Last, as they need nothing from me: on their way to the queue, then in it
  ci='' review='' group=auto each_record mine <<<"$mine"
  ci='' review='' group=queued each_record mine <<<"$mine"

  if [ ${#lines[@]} -eq 0 ]; then
    notify-send --app-name=github GitHub "No open pull request, nothing waiting on your review 🎉"
    exit 0
  fi

  # GitHub unreachable (exit 1): the trackers printed what they last knew
  status_line=''
  if [ "$mine_status" -eq 1 ] || [ "$reviews_status" -eq 1 ]; then
    status_line=$'\n'"<span color=\"$red\">Could not reach GitHub: showing the last known state</span>"
  fi

  # Tags go in each row's invisible search terms (meta)
  selection=$(for i in "${!lines[@]}"; do printf '%s\0meta\x1f%s\n' "${lines[$i]}" "${tags[$i]}"; done |
    rofi -dmenu -i -markup-rows -p '' -format 'i f' -filter "$filter" \
      -kb-custom-1 'Control+r' -kb-custom-2 'Control+q' -mesg "$mesg$status_line")
  code=$?
  read -r choice filter <<<"$selection" # keep the search across refreshes
  [ "$choice" -ge 0 ] 2>/dev/null || choice=''

  case $code in
    0) [ -n "$choice" ] && exec browser-kiosk "${urls[$choice]}"; exit 0 ;;
    10) mode='' ;;
    11) [ -n "$choice" ] && [ -n "${queues[$choice]}" ] && exec browser-kiosk "${queues[$choice]}" ;; # reviews: stay
    *) exit 0 ;;
  esac
done
