#!/usr/bin/env bash
# Rofi hub for my agents and GitHub pull requests, in this order:
# agents on none of the rows below (find_loose_agents), my open pull requests
# (merge-queue), local work none of them holds (local-work), those waiting on
# my review (review-queue), then my teams', then mine with auto-merge on, queued, deploying,
# deployed. Columns: see row (and faces for the glyphs). My teams' reviews
# fade less the less needs me (see surface_team_reviews).
# Usage: rofi-github [filter]  (prefilled search; rows also match invisible
# tags: :open, :queued, :deploying, :deployed, :review, :team, :local, :unpushed,
# :agent, :todo). Rows needing nothing from me fade (see needs_me); the others
# get :todo
# Enter: open (browser; an agent's row: jump to it; local work: neovim in its
# worktree). Ctrl+r: refresh from GitHub. Ctrl+q: the repository's merge queue
# page. Ctrl+f: the agent on it, else spawn one to fix or review it (agent-pr).
# Ctrl+s: the agent on it, else a new one, on the first prompt it asks for
# (none: an interactive session; cancelled: no agent, the list closed): on
# the pull request (as Ctrl+f sets it up, see agent-pr --prompt; Ctrl+f
# there: the agent Ctrl+f starts), else in the row's repository. Ctrl+m:
# enqueue a ready one of mine (asking first, see queue_concerns) or dequeue
# it; for the others, their page at the merge box: GitHub's API only queues
# ready ones, and a repository forbidding auto-merge refuses "Merge when
# ready" to it. Ctrl+o: push the row's branch, asking first.

assets=$(dirname "$(readlink -f "$0")")
# shellcheck source-path=SCRIPTDIR source=lib/github.sh
. "$assets/lib/github.sh"
# shellcheck source-path=SCRIPTDIR source=lib/rofi.sh
. "$assets/lib/rofi.sh"
# shellcheck source-path=SCRIPTDIR source=lib/agents.sh
. "$assets/lib/agents.sh" # agent_faces, agent_wants, harness_brand, pr_agent
mode=--cached
filter=$1

# Pango attributes for each face's glyph (see lib/rofi.sh for $dim)
declare -A styles=(
  [SUCCESS]="color=\"$green\"" [FAILURE]="color=\"$red\"" [PENDING]="color=\"$blue\""
  [CONFLICT]="color=\"$red\"" [DRAFT]=$dim [CHANGES_REQUESTED]="color=\"$yellow\""
  [APPROVED]="color=\"$green\"" [BOT_REVIEWING]="color=\"$blue\"" [BOT_REVIEW_FAILED]="color=\"$red\"" [REVIEW_REQUIRED]=$dim [NO_REVIEWER]="color=\"$yellow\"" [UNKNOWN]="color=\"$blue\"" [QUEUED]=$dim
  [MERGED]="color=\"$magenta\"" [DEPLOYING]="color=\"$blue\"" [DEPLOYED]="color=\"$green\""
)

declare -A faces=(
  # CI
  [SUCCESS]=''
  [FAILURE]=''
  [PENDING]='󰦖'
  # Review
  [CONFLICT]='󰀩'
  [DRAFT]=''
  [CHANGES_REQUESTED]='󰏫'
  [BOT_REVIEWING]=''
  [BOT_REVIEW_FAILED]=''
  [APPROVED]='󰔓'
  [REVIEW_REQUIRED]='󰈈'
  [NO_REVIEWER]='󰈉' # bots review it, no human
  [UNKNOWN]='󰔟' # mergeability: GitHub hasn't worked it out yet
  # Merge queue
  [QUEUED]=''
  # Deploy
  [MERGED]=''
  [DEPLOYING]='󱓞'
  [DEPLOYED]='󰅠'
)

# The window's widest, in characters (then its padding): half of my main
# monitor (3440 px) at theme.rasi's font. In characters rather than a share of
# the monitor, as rofi's default half of the screen leaves too little on
# a narrower one (the laptop's 1920 px)
max_width=152
auto_glyph='󰘬' # auto-merge on
prompt='' # rofi's, for the list and the dialogs
# Titles followed by an author (see row) share this many characters with
# it (and the two spaces between): the title gets what the longest author
# leaves, at least min_title_width
title_and_author=92 min_title_width=70

# Sets title_width, and author_width (the longest author, 0 when none), from
# the review-queue records on stdin
# shellcheck disable=SC2154 # record fields, set by each_record
measure_authors() {
  local longest=0
  longest_author() { [ ${#author} -gt "$longest" ] && longest=${#author}; }
  each_record longest_author
  author_width=$longest
  title_width=$((title_and_author - 2 - longest))
  [ "$title_width" -ge "$min_title_width" ] || title_width=$min_title_width
}
thread_glyph='' comment_glyph='' # unresolved review threads, open review comments
unpushed_glyph='󰄝' changes_glyph='󰴓' # local work: commits to push, uncommitted changes


# Local work, unstyled: <glyph> <commits to push>, <glyph> <changed files>,
# each when there are any (see row)
# Usage: work_text <commits to push> <changed files>
work_text() {
  local out=''
  [ "${1:-0}" -gt 0 ] 2>/dev/null && out="$unpushed_glyph $1"
  [ "${2:-0}" -gt 0 ] 2>/dev/null && out+="${out:+ }$changes_glyph $2"
  printf '%s' "$out"
}

# A count indicator of row (threads, comments): glyph, space, count, dimmer;
# nothing without any
# Usage: count_cell <glyph> <count>
count_cell() {
  [ "${2:-0}" -gt 0 ] 2>/dev/null || return 0
  printf '<span %s>%s %s</span>' "$dimmer" "$1" "$2"
}

# How big a pull request is, from its additions and deletions (deletions
# count for half: they are quicker to review): XS under 10 lines, S under 50,
# M under 250, L under 1000, else XL
# Usage: pr_size <additions> <deletions>
pr_size() {
  local lines=$((${1:-0} + ${2:-0} / 2))
  if [ "$lines" -lt 10 ]; then echo XS
  elif [ "$lines" -lt 50 ]; then echo S
  elif [ "$lines" -lt 250 ]; then echo M
  elif [ "$lines" -lt 1000 ]; then echo L
  else echo XL; fi
}
# The sizes' glyphs (before the pull request number)
declare -A size_glyphs=(
  [XS]='󱎣' [S]='󱎤' [M]='󱎥' [L]='󱎦' [XL]='󱎧'
)
# Their styles: from green to red, the
# smallest faded
declare -A size_styles=(
  [XS]="color=\"$green\" $dim" [S]="color=\"$green\"" [M]="color=\"$yellow\""
  [L]="color=\"$red\"" [XL]="color=\"$red\" weight=\"bold\""
)

# A row, from named cells (<name>=<value> arguments, all optional):
#   ci, review     faces keys (unknown ones show as ?, missing ones as blank)
#   time, number, additions, deletions, title
#   project        an agent's project (or a local work's name): before the
#                  title (<project> — <title>), "local" (dimmer) in the number's
#                  place
#   author         goes last, after the time (the title gets cut at a fixed
#                  width)
#   tint           the review face's color, instead of its style (reviews
#                  waiting on me)
#   auto           auto: auto-merge is on
#   diff           plain: the number's size (see pr_size) uncolored
#   comments       how many review comments are open (see github_comments_jq)
#   threads        how many review threads are unresolved
#   work           local work (see local-work): <commits to push> <changed
#                  files> <yes when an agent works in its worktree, else ->
#   italic         italic: the whole row in italics
#   agent          the state of the agent working on it (see find_agents)
# Pad before adding markup, which would otherwise count towards the widths
row() {
  local -A c=()
  local arg
  for arg; do
    case ${arg%%=*} in
      ci | review | time | number | additions | deletions | title | author | tint | auto | diff | threads | comments | work | italic | agent | project)
        c[${arg%%=*}]=${arg#*=} ;;
      *) echo "row: unknown cell ${arg%%=*}" >&2 ;;
    esac
  done
  local ci review who='' title=${c[title]} threads comments auto='' line
  # Auto-merge: its glyph, dimmer
  [ "${c[auto]}" = auto ] && auto="<span $dimmer>$auto_glyph</span>"
  # Faces are 3 cells wide: the glyph (one cell, blank when missing), then two
  # spaces. Style the glyphs only (a tint wins over the review face's own
  # style)
  local style
  ci=${c[ci]:+${faces[${c[ci]}]:-?}} review=${c[review]:+${faces[${c[review]}]:-?}}
  [ -n "${c[ci]}" ] && style=${styles[${c[ci]}]} && [ -n "$style" ] && ci="<span $style>$ci</span>"
  style=''
  [ -n "${c[review]}" ] && style=${styles[${c[review]}]}
  [ -n "${c[tint]}" ] && style="color=\"${c[tint]}\""
  [ -n "$style" ] && [ -n "$review" ] && review="<span $style>$review</span>"
  ci="${ci:- }  " review="${review:- }  "
  # The size's glyph, a column of its own: one cell, then a space (it doesn't
  # spill over, unlike most glyphs); blank with a project
  local size glyph=' '
  if [ -z "${c[project]}" ]; then
    size=$(pr_size "${c[additions]}" "${c[deletions]}") glyph=${size_glyphs[$size]}
    [ "${c[diff]}" != plain ] && glyph="<span ${size_styles[$size]}>$glyph</span>"
  fi
  # Last, after the time, fainter than dim. The title gets cut at a fixed
  # width (in characters, as they are cells), so that a long one can't push
  # it out of the window
  if [ -n "${c[author]}" ]; then
    who="  <span fgalpha=\"40%\">$(escape "${c[author]}")</span>"
    [ ${#title} -gt "$title_width" ] && title="${title:0:title_width-1}…"
  fi
  threads=$(count_cell "$thread_glyph" "${c[threads]}")
  comments=$(count_cell "$comment_glyph" "${c[comments]}")
  # Local work
  local work ahead changed tended
  read -r ahead changed tended <<<"${c[work]:-0 0 -}"
  work=$(work_text "$ahead" "$changed")
  if [ -n "$work" ]; then
    [ "${ahead:-0}" -gt 0 ] && work=${work/"$unpushed_glyph $ahead"/"<span color=\"$yellow\">$unpushed_glyph $ahead</span>"}
    if [ "${changed:-0}" -gt 0 ]; then
      local tone=$dimmer
      [ "$tended" = yes ] || tone="color=\"$yellow\""
      work=${work/"$changes_glyph $changed"/"<span $tone>$changes_glyph $changed</span>"}
    fi
  fi
  # The agent's face
  local agent=''
  [ -n "${c[agent]}" ] && agent="<span ${agent_styles[${c[agent]}]:-$agent_fallback_style}>${agent_faces[${c[agent]}]:-󰚩}</span>"
  # Time and number: as wide as the widest shown (see measure_columns). No
  # number with a project: "local" instead, the project goes before the title
  local middle
  middle=$(printf '%-*s' "$number_width" "${c[number]}")
  if [ -n "${c[project]}" ]; then
    middle="<span $dimmer>local</span>$(printf '%*s' $((number_width - 5)) '')"
    title="${c[project]} — $title"
  fi
  local before
  # The indicators first (auto-merge, comments, threads, local work, the
  # agent), one space apart in one column, right-aligned: a \x1e after them
  # stands for the padding lining the faces up (see align_columns). Then the
  # faces and number. The time, dimmer, right-aligned, after a \x1f standing
  # for the padding lining all rows' times up (see align_columns); then the
  # author, if any
  local indicators='' indicator
  for indicator in "$auto" "$comments" "$threads" "$work" "$agent"; do
    [ -n "$indicator" ] && indicators+="${indicators:+ }$indicator"
  done
  before=$(printf '%s\x1e%s%s%s %s ' "$indicators" "$ci" "$review" "$glyph" "$middle")
  line="$before$(escape "$title")"$'\x1f'"<span $dimmer>$(printf '%*s' "$time_width" "${c[time]}")</span>$who"
  [ "${c[italic]}" = italic ] && line="<span style=\"italic\">$line</span>"
  printf '%s' "$line"
}

# Adds a pull request to the merge queue (GitHub's "Merge when ready": it
# waits there for its checks), printing where it stands, or removes it
# Usage: toggle_queue <owner/repo> <number> <out (add it) or in (remove it)>
# shellcheck disable=SC2016 # GraphQL variables
toggle_queue() {
  local id
  id=$(timeout 30 gh pr view "$2" -R "$1" --json id --jq .id) || return 1
  if [ "$3" = in ]; then
    timeout 30 gh api graphql -f id="$id" --jq 'empty' -f query='
      mutation($id: ID!) { dequeuePullRequest(input: {id: $id}) { clientMutationId } }'
  else
    timeout 30 gh api graphql -f id="$id" -f query='
      mutation($id: ID!) { enqueuePullRequest(input: {pullRequestId: $id}) { mergeQueueEntry { position state } } }' \
      --jq '.data.enqueuePullRequest.mergeQueueEntry | "In the merge queue, position \(.position) (\(.state | ascii_downcase | gsub("_"; " ")))"'
  fi
}

# The open review comments of a pull request (see github_comments_jq), one
# oldest first: its author, then, on the next line, its start (markdown
# stripped) cut to fit the dialog (see confirm_queue). Nothing when GitHub can't tell
# Usage: comment_excerpts <owner/repo> <number>
# shellcheck disable=SC2016 # GraphQL and jq variables
comment_excerpts() {
  timeout 30 gh api graphql -f owner="${1%%/*}" -f name="${1#*/}" -F number="$2" -f query='
    query($owner: String!, $name: String!, $number: Int!) {
      repository(owner: $owner, name: $name) { pullRequest(number: $number) { '"$github_comments_query"' } }
    }' 2>/dev/null | jq -r "$github_comments_jq"'
    .data.repository.pullRequest | open_comment_nodes[]
    | "  \((.author.login // "ghost") | sub("\\[bot\\]$"; ""))",
      ("    " + (.body | gsub("<[^>]*>|-{3,}|[*`#_>~]"; "") | gsub("\\s+"; " ") | ltrimstr(" ") | ltrimstr("- "))
       | if length > 46 then .[:45] + "…" else . end)' 2>/dev/null
  return 0
}

# What to check before queueing one of my pull requests, one per line
# (nothing: go ahead). Running checks are fine: the queue waits for them
# Usage: queue_concerns <CI> <review> <state> <unresolved threads> <open comments> <owner/repo> <number>
queue_concerns() {
  [ "$1" = FAILURE ] && echo "Its CI fails"
  case $2 in
    CONFLICT) echo "It conflicts with its base branch" ;;
    DRAFT) echo "It's a draft" ;;
    CHANGES_REQUESTED) echo "Changes were requested" ;;
    BOT_REVIEWING) echo "A bot is still reviewing it" ;;
    BOT_REVIEW_FAILED) echo "A bot's review failed" ;;
    REVIEW_REQUIRED) echo "It isn't approved yet" ;;
    NO_REVIEWER) echo "Only bots review it" ;;
  esac
  [ "$3" = UNKNOWN ] && echo "GitHub can't tell whether it's mergeable"
  [ "${4:-0}" -gt 0 ] 2>/dev/null && echo "$4 review thread$([ "$4" -gt 1 ] && echo s) unresolved"
  if [ "${5:-0}" -gt 0 ] 2>/dev/null; then
    echo "$5 review comment$([ "$5" -gt 1 ] && echo s) not hidden"
    comment_excerpts "$6" "$7"
  fi
  return 0
}

# Whether to queue it anyway, given its concerns (a rofi dialog: Escape, or
# Cancel, says no; Cancel comes first, so that a quick Enter doesn't queue it)
# Usage: confirm_queue <owner/repo>#<number> <concerns>
confirm_queue() {
  local mesg
  mesg="<b>$(escape "$1")</b>"$'\n'"$(escape "$2")"
  [ "$(printf '%s\n' Cancel 'Add to the merge queue anyway' |
    rofi -dmenu -i -no-custom -p "$prompt" -format i -theme-str "$layout window { width: calc(48ch + 2em min 100%); }" \
      -mesg "$mesg")" = 1 ]
}

# Sets agents: the state of the agent working on each pull request
# (<owner/repo>#<number>, see agent-pr), the one wanting me the most
# when there are several; agent_states: each agent's
# state, by session; agent_prs: the pull request each works on, by session.
# And agent_list: all of them (agent-list's records)
# shellcheck disable=SC2154 # record fields, set by each_record
find_agents() {
  declare -gA agents=() agent_states=() agent_prs=()
  agent_list=$("$assets/agent-list")
  rank_agent() {
    agent_states[$session]=$state
    [ "$pr" != - ] && [ -n "$pr" ] || return 0
    agent_prs[$session]=$pr
    local current=${agents[$pr]:-none}
    [ "${agent_wants[$state]:-0}" -gt "${agent_wants[$current]:-0}" ] && agents[$pr]=$state
    return 0
  }
  each_record rank_agent <<<"$agent_list"
}

# Sets loose_agents: agent-list's records ($agent_list) of the agents
# working on no pull request among the merge-queue records ($1) and the
# review-queue ones ($2) (one gone from them: merged long ago, reviewed; or
# none, in an agent worktree, <project>-<slot>), so that they get a row. Not
# those on none in a main checkout: the sessions I keep open there
# (super+u, or the panel, reach them). Nor those working where some local
# work lies (find_local_work's records, $3): its row tells their state
# shellcheck disable=SC2154 # record fields, set by each_record
find_loose_agents() {
  local -A listed=()
  list_pr() { listed[$repo#$number]=1; }
  each_record list_pr <<<"$1"
  each_record list_pr <<<"$2"
  local -A on_work=()
  list_work() { [ "$agent" != - ] && on_work[$agent]=1; return 0; }
  each_record list_work <<<"$3"
  loose_agents=$(head -n1 <<<"$agent_list")
  keep_loose() {
    [ -n "${on_work[$session]}" ] && return 0
    if [ "$pr" != - ] && [ -n "$pr" ]; then
      [ -n "${listed[$pr]}" ] && return 0
    else
      [[ $project =~ -[0-9]+$ ]] || return 0
    fi
    loose_agents+=$'\n'"$started"$'\t'"$state"$'\t'"$since"$'\t'"$session"$'\t'"$project"$'\t'"$pr"
  }
  each_record keep_loose <<<"$agent_list"
}

# Sets work_of and push_of, for the local work (local-work's records, $1) on
# the head branch of one of my pull requests (merge-queue's records, $2), by
# <owner/repo>#<branch>: its row's work cell (see row), and what Ctrl+o
# pushes (see pushes, when there's something to). And pr_work, for the local
# work of an agent on one of those pull requests, or on one waiting on my
# review (review-queue's records, $3), elsewhere than on its head branch (a
# detached worktree, as agent-pr falls back to), by
# <owner/repo>#<number>: its row's work cell. For a review, its uncommitted
# changes only (the commits it sits on are the pull request's, fetched by
# ref: on no branch here). And local_work: the other records, which get rows
# of their own
# shellcheck disable=SC2154 # record fields, set by each_record
find_local_work() {
  declare -gA work_of=() push_of=() pr_work=()
  local -A heads=() owned=() reviewed=()
  list_head() {
    owned[$repo#$number]=1
    [ -n "$branch" ] && [ "$branch" != - ] && heads[$repo#$branch]=1
    return 0
  }
  each_record list_head <<<"$2"
  list_reviewed() { reviewed[$repo#$number]=1; }
  each_record list_reviewed <<<"$3"
  local_work=$(head -n1 <<<"$1")
  sort_work() {
    # Gone since local-work's cache was made: none (its rows would jump to it)
    [ -n "${agent_states[${agent:--}]}" ] || agent=-
    local pr=${agent_prs[$agent]}
    if [ "$branch" != - ] && [ -n "${heads[$repo#$branch]}" ]; then
      work_of[$repo#$branch]="$ahead $changes $([ "$agent" != - ] && echo yes || echo -)"
      [ "$ahead" -gt 0 ] && push_of[$repo#$branch]="$clone $branch $upstream $ahead"
    elif [ "$agent" != - ] && [ -n "$pr" ] && [ -n "${owned[$pr]}" ]; then
      pr_work[$pr]="$ahead $changes yes"
    elif [ "$agent" != - ] && [ -n "$pr" ] && [ -n "${reviewed[$pr]}" ]; then
      [ "$changes" -gt 0 ] && pr_work[$pr]="0 $changes yes"
    else
      local_work+=$'\n'"$repo"$'\t'"$clone"$'\t'"$branch"$'\t'"$worktree"$'\t'"$upstream"$'\t'"$ahead"$'\t'"$changes"$'\t'"$agent"$'\t'"$kept"$'\t'"$time"
    fi
    return 0
  }
  each_record sort_work <<<"$1"
}

# Projects' short names: the second word of ~/.config/agents/projects'
# lines (see agent-list), when any
declare -A short_names=()
while read -r long short _; do
  [[ -n $short && $long != \#* ]] && short_names[$long]=$short
done <"${XDG_CONFIG_HOME:-$HOME/.config}/agents/projects" 2>/dev/null

# A project's name as shown: its short name, an agent worktree's
# (<project>-<slot>) its project's short one then the slot, else as it is
# Usage: short_name <name>
short_name() {
  local name=$1
  if [ -n "${short_names[$name]}" ]; then name=${short_names[$name]}
  elif [[ $name =~ ^(.+)-([0-9]+)$ ]] && [ -n "${short_names[${BASH_REMATCH[1]}]}" ]; then
    name=${short_names[${BASH_REMATCH[1]}]}-${BASH_REMATCH[2]}
  fi
  printf '%s' "$name"
}

# A local work row's name (a local-work record): its worktree's directory,
# else its clone's (see short_name)
# shellcheck disable=SC2154 # record fields, set by each_record
local_name() { short_name "$(if [ "$worktree" != - ]; then basename "$worktree"; else basename "$clone"; fi)"; }

# Asks for a new agent's first prompt (a rofi dialog), on <what> (markup):
# prints it, nothing for none (an interactive session); fails when cancelled
# (Escape). With a <task> (fix or review, see agent-pr), Ctrl+f picks it
# instead of a prompt: exits 3 (rofi binds Ctrl+f to moving forward: Right
# only does then, as in the list). Under the glyph of the harness spawning
# it, else our prompt.
# The skills it can call in [dir] (see skills in lib/agents.sh) go in a list
# under the input, after an interactive session's row. Enter takes the row
# highlighted when the input is empty or a single /word (filtering the
# skills: /name), else what was typed, matching rows or not (a prompt that
# happens to match a description stays a prompt). Ctrl+space on a skill's
# row: the dialog again, /<name> typed in, to add arguments (rofi's own
# Ctrl+space would put the whole row there). Without any skill: the input
# only, Enter on it empty an interactive session
# Usage: ask_prompt <what> [task] [dir]
ask_prompt() {
  local glyph keys=() task_hint='' answer status skill name description
  local -a names=() rows=()
  glyph=$(harness_brand "$default_harness" glyph)
  [ -n "$2" ] && keys=(-kb-custom-1 Control+f -kb-move-char-forward Right) task_hint=" Ctrl+f: $2 it."
  while IFS=$'\t' read -r name description; do
    [ -n "$name" ] && names+=("$name") rows+=("$description")
  done < <(harness_do "$default_harness" skills "$3")
  if [ ${#names[@]} -eq 0 ]; then
    answer=$(rofi -dmenu -p "${glyph:-$prompt}" -theme-str "$layout listview { enabled: false; } window { width: calc(96ch + 2em min 100%); }" "${keys[@]}" \
      -mesg "First prompt for an agent $1"$'\n'"<span size=\"90%\" $dim>Nothing: an interactive session.$task_hint Escape: cancel</span>" </dev/null)
    status=$?
    [ "$status" -eq 10 ] && [ -n "$2" ] && return 3
    [ "$status" -eq 0 ] || return 1
    printf '%s\n' "$answer"
    return 0
  fi
  # /<name>, padded to the longest, then its description, dimmer, cut to fit
  # the dialog's 96 characters (the list's gutter aside)
  local longest=0 room
  for name in "${names[@]}"; do [ $((${#name} + 1)) -gt "$longest" ] && longest=$((${#name} + 1)); done
  room=$((96 - 4 - longest - 2))
  for skill in "${!names[@]}"; do
    description=${rows[$skill]}
    [ ${#description} -gt "$room" ] && description="${description:0:room-1}…"
    rows[skill]="$(printf '%-*s' "$longest" "/${names[$skill]}")  <span $dim>$(escape "$description")</span>"
  done
  local filter='' index typed
  while :; do
    answer=$(printf '%s\n' "<span $dim>Interactive session</span>" "${rows[@]}" |
      rofi -dmenu -i -markup-rows -p "${glyph:-$prompt}" -format 'i f' -filter "$filter" \
        -kb-row-select '' -kb-custom-2 Control+space \
        -theme-str "$layout listview { lines: $((${#names[@]} + 1 < 10 ? ${#names[@]} + 1 : 10)); } window { width: calc(96ch + 2em min 100%); }" "${keys[@]}" \
        -mesg "First prompt for an agent $1"$'\n'"<span size=\"90%\" $dim>Typing: a prompt. Ctrl+space: a skill's arguments.$task_hint Escape: cancel</span>")
    status=$? index=${answer%% *} typed=${answer#* }
    [ "$status" -eq 10 ] && [ -n "$2" ] && return 3
    if [ "$status" -eq 11 ]; then
      [ "$index" -gt 0 ] 2>/dev/null && typed="/${names[index - 1]} "
      filter=$typed
      continue
    fi
    [ "$status" -eq 0 ] || return 1
    break
  done
  if [ "$index" -ge 0 ] 2>/dev/null && [[ -z $typed || $typed =~ ^/[^[:space:]]*$ ]]; then
    [ "$index" -gt 0 ] && printf '/%s\n' "${names[index - 1]}"
    return 0
  fi
  printf '%s\n' "$typed"
}

# Asks before pushing (a rofi dialog, as confirm_queue)
# Usage: confirm_push <branch> <commits> <upstream: yes, none or gone>
confirm_push() {
  local mesg what="Push"
  mesg="<b>$(escape "$1")</b>"$'\n'"$2 commit$([ "$2" -gt 1 ] && echo s) to push"
  [ "$3" = yes ] || mesg+=", on a new remote branch"
  [ "$(printf '%s\n' Cancel "$what to origin" |
    rofi -dmenu -i -no-custom -p "$prompt" -format i -theme-str "$layout window { width: calc(48ch + 2em min 100%); }" \
      -mesg "$mesg")" = 1 ]
}

# Pushes <branch> of <clone> to origin, under the same name (tracking it
# when it never was). Prints git's complaint when it refuses
# Usage: push_branch <clone> <branch> <upstream: yes, none or gone>
push_branch() {
  local track=()
  [ "$3" = yes ] || track=(--set-upstream)
  timeout 60 git -C "$1" push --quiet "${track[@]}" origin "refs/heads/$2:refs/heads/$2" 2>&1
}

layout=$hints_layout
hints enter=open ctrl+r=refresh ctrl+q='queue page' ctrl+f=fix/review ctrl+s=agent ctrl+m=merge ctrl+o=push

# A duration on a single unit, to keep the time column narrow: 42s (with
# seconds), 42m, 5h, 12d. Rounded down, or up (for time left: never 60m)
# Usage: span <seconds> [seconds] [up]
span() {
  local n=$1 unit=s step
  [ "$2" = seconds ] && [ "$n" -lt 60 ] && { echo "${n}s"; return; }
  for step in 60:m 60:h 24:d; do
    if [ "$3" = up ]; then n=$(((n + ${step%:*} - 1) / ${step%:*})); else n=$((n / ${step%:*})); fi
    unit=${step#*:}
    [ "$unit" = d ] && break
    [ "$unit" = m ] && [ "$n" -lt 60 ] && break
    [ "$unit" = h ] && [ "$n" -lt 24 ] && break
  done
  echo "$n$unit"
}

# The time column of one of my pull requests (a merge-queue record): its
# position and when it should merge (queued), nothing (ready), else since the
# merge (deploying), since it reached production (deployed), or the last
# update
# shellcheck disable=SC2154 # record fields, set by each_record
mine_when() {
  case $kind in
    queued) printf '#%s' "$position"; [ "$time" = - ] || printf ' %s' "$(span "$time" '' up)" ;;
    ready) ;;
    *) span $((now - time)) ;;
  esac
}

# Lines the rows' columns up (see row): each row's <mark> becomes the padding
# to the widest row's text before it, within <limit> characters, then <gap>
# spaces (none when no row has any text there). A longer one's next column
# follows its text. With right, the padding goes before the text instead (at
# the start of the line: the text is the row's first)
# Usage: align_at <mark> <limit> <gap> [right]
align_at() {
  local i prefix widest=0 pad
  local -a widths=()
  for i in "${!lines[@]}"; do
    [[ ${lines[$i]} == *"$1"* ]] || continue
    widths[i]=$(shown_width "${lines[$i]%%"$1"*}")
    [ "${widths[i]}" -gt "$widest" ] && widest=${widths[i]}
  done
  [ "$widest" -gt "$2" ] && widest=$2
  local gap=$3
  [ "$widest" -gt 0 ] || gap=0
  for i in "${!widths[@]}"; do
    prefix=${lines[$i]%%"$1"*} pad=$((widest - widths[i]))
    [ "$pad" -gt 0 ] || pad=0
    if [ "$4" = right ]; then
      lines[i]="$(printf '%*s' "$pad" '')$prefix$(printf '%*s' "$gap" '')${lines[$i]#*"$1"}"
    else
      lines[i]="$prefix$(printf '%*s' $((pad + gap)) '')${lines[$i]#*"$1"}"
    fi
  done
}

# The indicators' column (\x1e, right-aligned, then two spaces: the agent's
# face spills over), then the times on the right (\x1f, within max_width,
# the authors' column after them included)
align_columns() {
  local authors=0
  [ "${author_width:-0}" -gt 0 ] && authors=$((2 + author_width))
  align_at $'\x1e' "$max_width" 2 right
  align_at $'\x1f' $((max_width - 2 - time_width - authors)) 2
}

# The time column of a pull request waiting on my review: for how long

# shellcheck disable=SC2154 # record fields, set by each_record
review_when() { span $((now - at)); }

# Sets time_width and number_width: the widest time and pull request number
# of the merge-queue records ($1) and the review-queue ones ($2), so that
# columns line up without padding them all for the widest possible (a queued
# one's "#37 2h"). The loose agents' rows too ($3, see find_loose_agents):
# their turn's duration, and room for their "local" (see row). And the local
# work's rows ($4, see find_local_work): alike
# shellcheck disable=SC2154 # record fields, set by each_record
measure_columns() {
  local when
  time_width=0 number_width=0
  widest() { # <time>
    [ ${#1} -gt "$time_width" ] && time_width=${#1}
    [ ${#number} -gt "$number_width" ] && number_width=${#number}
    return 0
  }
  widest_mine() { when=$(mine_when); widest "$when"; }
  widest_review() { when=$(review_when); widest "$when"; }
  each_record widest_mine <<<"$1"
  each_record widest_review <<<"$2"
  local_room() { [ "$number_width" -ge 5 ] || number_width=5; } # "local", in the number's place
  widest_agent() {
    local_room
    when=$(agent_when); [ ${#when} -gt "$time_width" ] && time_width=${#when}
  }
  each_record widest_agent <<<"$3"
  widest_local() {
    local_room
    when=$(span $((now - time))); [ ${#when} -gt "$time_width" ] && time_width=${#when}
    return 0
  }
  each_record widest_local <<<"$4"
  return 0
}

# The time column of an agent (a agent-list record): how long its turn
# has run, when running (or monitoring)
# shellcheck disable=SC2154 # record fields, set by each_record
agent_when() { case $state in running | monitoring) [ "$since" != - ] && span $(($(date +%s) - since)) seconds ;; esac; return 0; }

# Whether a row needs me, given the state of the agent on it (if any) and
# <reasons> (a word each, empty for none): never while an agent works on it
# (it's being handled), always when one waits on me (done, idle, asking), else
# when there's a reason
# Usage: needs_me <agent state> [reason...]
needs_me() {
  case $1 in
    running | monitoring) return 1 ;;
    ?*) return 0 ;;
  esac
  shift
  local reason
  for reason; do [ -n "$reason" ] && return 0; done
  return 1
}

# Fades the caller's line unless needs_me says it needs me (same arguments),
# setting the caller's todo (" :todo", else empty) for its tags
# Usage: attend <agent state> [reason...]
attend() {
  if needs_me "$@"; then todo=' :todo'
  else todo='' line="<span fgalpha=\"40%\">$line</span>"; fi
}

# What needs me on one of my open pull requests (a merge-queue record),
# auto-merge on or not: failing CI, feedback (changes requested, unresolved
# threads, open comments), conflicts, a draft to finish, no human reviewer;
# and, without auto-merge (it would do it), being ready to queue. One word
# each
# shellcheck disable=SC2154 # record fields, set by each_record
open_reasons() {
  [ "$ci" = FAILURE ] && echo ci
  case $state in CHECKS_FAILING | BOT_REVIEW_FAILED) echo ci ;; esac
  case $review in BOT_REVIEW_FAILED) echo ci ;; CHANGES_REQUESTED) echo feedback ;; CONFLICT) echo conflict ;; DRAFT) echo draft ;; NO_REVIEWER) echo reviewer ;; esac
  case $state in CHANGES_REQUESTED) echo feedback ;; CONFLICT) echo conflict ;; DRAFT) echo draft ;; NO_REVIEWER) echo reviewer ;; esac
  [ "${threads:-0}" -gt 0 ] 2>/dev/null && echo threads
  [ "${comments:-0}" -gt 0 ] 2>/dev/null && echo comments
  [ "$kind" = ready ] && [ "$auto" != auto ] && echo ready
  return 0
}

# Adds an agent (an agent-list record): Enter, Ctrl+f and Ctrl+s go back to it
# shellcheck disable=SC2154 # record fields, set by each_record
agent() {
  local title home
  title=$(read_agent "$agents_dir/$session" agent_; agent_title "$agent_harness" "$agent_transcript")
  home=$(read_agent "$agents_dir/$session" agent_; [ "$agent_root" != - ] && echo "$agent_root")
  local todo line
  line=$(row time="$(agent_when)" project="$(short_name "$project")" title="${title:-new session}" agent="$state")
  attend "$state"
  urls+=('') queues+=('') prs+=('') merges+=('') sessions+=("$session") dirs+=('') pushes+=('') tags+=(":agent$todo") homes+=("$home")
  lines+=("$line")
}

# Adds one of my pull requests (a merge-queue record, see each_record) if it
# belongs to $group: open (needs me, or someone else), auto (auto-merge on:
# on its way to the queue), queued, deploying (merged, not in production
# yet) or deployed (in production lately)
# shellcheck disable=SC2154 # record fields, set by each_record
mine() {
  local in=open when tag=:open diff='' face italic='' line todo
  case $kind in queued | deploying | deployed) in=$kind ;; *) [ "$auto" = auto ] && in=auto ;; esac
  [ "$in" = "$group" ] || return 0
  case $kind in queued | deploying | deployed) tag=:$kind ;; esac
  when=$(mine_when)
  # On their way (auto-merge on), in the queue or merged: the diff in the
  # fade too
  [ "$in" = open ] || diff=plain
  # In the queue, its required checks passed (a failing one is optional): the
  # CI face tells its merge group's instead, the run that matters now
  # (passed, before GitHub builds one)
  if [ "$in" = queued ]; then
    review=QUEUED ci=SUCCESS
    case $queue_ci in FAILURE | PENDING) ci=$queue_ci ;; esac
  fi
  # MERGED, DEPLOYING or DEPLOYED; no queue to open, nothing for an agent to
  # fix (Ctrl+f)
  case $in in deploying | deployed) review=$state ci='' queue_url='' threads=0 comments=0 ;; esac
  # GitHub hasn't worked out whether it's mergeable yet (the approved face
  # would read ready): the review face says so, the row too. In the face
  # only, as the merge and the agent want the review itself
  face=$review
  [ "$state" = UNKNOWN ] && face=UNKNOWN italic=italic
  line=$(row ci="$ci" review="$face" time="$when" number="$number" additions="$additions" deletions="$deletions" \
    title="$title" auto="$auto" diff="$diff" threads="$threads" comments="$comments" italic="$italic" \
    work="${work_of[$repo#$branch]:-${pr_work[$repo#$number]}}" agent="${agents[$repo#$number]}")
  # Open ones (auto-merge on too) need me when blocked on me (see
  # open_reasons); queued ones, when their merge group fails (about to be
  # kicked out: back to open then); merged ones never
  local reasons=''
  case $in in
    open | auto) reasons=$(open_reasons) ;;
    queued) [ "$queue_ci" = FAILURE ] && reasons=queue ;;
  esac
  # shellcheck disable=SC2086 # one reason a word
  attend "${agents[$repo#$number]}" $reasons
  # The merge queue: can join it (ready ones; and what Ctrl+m checks first),
  # waits for GitHub's page (other open ones), can leave it (queued), or
  # neither (merged)
  local merge=''
  case $in in
    open | auto)
      if [ "$kind" = ready ]; then merge="$repo $number out ${ci:--} ${review:--} ${state:--} ${threads:-0} ${comments:-0}"
      else merge="$repo $number page"; fi ;;
    queued) merge="$repo $number in" ;;
  esac
  # Deployed: nothing left to push (squashed, its commits are on no remote
  # branch)
  local push=${push_of[$repo#$branch]}
  case $in in deploying | deployed) push='' ;; esac
  urls+=("$url") queues+=("$queue_url") prs+=("fix $repo $number") merges+=("$merge") homes+=('')
  tags+=("$tag${agents[$repo#$number]:+ :agent}${work_of[$repo#$branch]:+ :local}${pr_work[$repo#$number]:+ :local}${push:+ :unpushed}$todo") sessions+=('') dirs+=('') pushes+=("$push") lines+=("$line")
}

# Adds local work no pull request of mine holds (a local-work record, see
# find_local_work): Enter goes to the agent working there, else neovim in its
# worktree, else GitHub's page to open a pull request for it (pushed)
# <path> encoded for a URL's path: what git allows in a branch name, and a
# URL reads otherwise (% first, as the others bring theirs)
# Usage: url_path <path>
url_path() {
  local path=${1//"%"/"%25"}
  path=${path//"#"/"%23"} path=${path//"?"/"%3F"} path=${path//"&"/"%26"} path=${path//"+"/"%2B"}
  echo "$path"
}

# shellcheck disable=SC2154 # record fields, set by each_record
local_row() {
  local title state='' url='' push='' tended=- line todo
  if [ "$branch" = - ]; then title='detached HEAD'; else title=$branch; fi
  [ "$branch" != - ] && [ "$upstream" = none ] && title+=' (never pushed)'
  [ "$kept" = yes ] && title+=" (a stopped agent's, kept)"
  if [ "$agent" != - ]; then state=${agent_states[$agent]} tended=yes; fi
  [ "$branch" != - ] && [ "$upstream" = yes ] && url="https://github.com/$repo/compare/$(url_path "$branch")?expand=1"
  [ "$branch" != - ] && [ "$ahead" -gt 0 ] && push="$clone $branch $upstream $ahead"
  urls+=("$url") queues+=('') prs+=('') merges+=('') sessions+=("$([ "$agent" != - ] && echo "$agent")")
  dirs+=("$([ "$worktree" != - ] && echo "$worktree")") pushes+=("$push") homes+=("$clone")
  line=$(row time="$(span $((now - time)))" project="$(local_name)" title="$title" \
    work="$ahead $changes $tended" agent="$state")
  # Needs me: commits to push, or changes no agent tends
  attend "$state" "$([ "${ahead:-0}" -gt 0 ] && echo unpushed)" "$([ "${changes:-0}" -gt 0 ] && [ "$tended" != yes ] && echo changes)"
  tags+=(":local${push:+ :unpushed}${state:+ :agent}$todo")
  lines+=("$line")
}

# Adds a pull request waiting on my review (a review-queue record) if it
# belongs to $group: mine (requested from me) or team (from one of my teams
# only)
# shellcheck disable=SC2154 # record fields, set by each_record
review() {
  local in=mine waited=$((now - at)) tint='' line todo
  [ "${team:--}" = - ] || in=team
  [ "$in" = "$group" ] || return 0
  # The review face, warmer as the wait grows: 4h, then a day (mine only)
  if [ "$in" = team ]; then :
  elif [ "$waited" -ge 86400 ]; then tint=$red
  elif [ "$waited" -ge 14400 ]; then tint=$yellow; fi
  local cells=(ci="$ci" review=REVIEW_REQUIRED time="$(review_when)" number="$number" additions="$additions"
    deletions="$deletions" author="$author" title="$title" threads="$threads" comments="$comments"
    work="${pr_work[$repo#$number]}" agent="${agents[$repo#$number]}")
  line=$(row "${cells[@]}" tint="$tint")
  # My teams', CI green and no agent on it: faded for now, maybe lifted once
  # all rows are in (see surface_team_reviews), its review face blue then. A
  # step up each when small (XS, S) and when neglected (waiting for a day,
  # nobody on it yet: no thread, no comment)
  if [ "$in" = team ] && [ -z "${agents[$repo#$number]}" ] && [ "$ci" != FAILURE ] && [ "$ci" != PENDING ]; then
    local steps=0
    case $(pr_size "$additions" "$deletions") in XS | S) steps=$((steps + 1)) ;; esac
    [ "$waited" -ge 86400 ] && [ "${threads:-0}" -eq 0 ] && [ "${comments:-0}" -eq 0 ] && steps=$((steps + 1))
    team_steps[${#lines[@]}]=$steps
    team_lines[${#lines[@]}]=$(row "${cells[@]}" tint="$blue")
  fi
  # Needs me: requested from me (first time or again: GitHub drops me from
  # the request once I review), its CI green (failing or pending: the
  # author's turn first). My teams': never
  attend "${agents[$repo#$number]}" "$([ "$in" = mine ] && [ "$ci" != FAILURE ] && [ "$ci" != PENDING ] && echo requested)"
  urls+=("$url") queues+=('') prs+=("review $repo $number") merges+=('') sessions+=('') dirs+=('') pushes+=('') homes+=('')
  tags+=(":$([ "$in" = team ] && echo team || echo review)${agents[$repo#$number]:+ :agent}${pr_work[$repo#$number]:+ :local}$todo")
  lines+=("$line")
}

# Records (see lib/records.sh) smallest first by size (see pr_size: XS, S,
# M, L, XL), keeping their order within a size; the header first, lines
# without a tab (failure messages) dropped
# Usage: by_size <<<"$records"
by_size() {
  awk -F'\t' '
    /^#/ && !h { h = 1; print "0\t0\t" $0
                 for (i = 1; i <= NF; i++) { f = $i; sub(/^#/, "", f); col[f] = i }; next }
    h && /\t/ { n = $col["additions"] + int($col["deletions"] / 2)
                 size = n < 10 ? 1 : n < 50 ? 2 : n < 250 ? 3 : n < 1000 ? 4 : 5
                 print size "\t" NR "\t" $0 }' |
    sort -t$'\t' -k1,1n -k2,2n | cut -f3-
}

# Team reviews' fades, dimmest first: the last means nothing lifts them
team_fades=(90 70 50 40)
# Lifts my teams' reviews worth a look (see review), less the more rows
# need me (:todo ones): 0, 90%; 1-2, 70%; 3-4, 50%; else they stay faded
# (40%). Each of their steps (small, neglected) lifts one fade more, up to
# 90%: never as bright as what needs me
surface_team_reviews() {
  local i todos=0 base fade
  for i in "${!tags[@]}"; do [[ ${tags[$i]} == *:todo* ]] && todos=$((todos + 1)); done
  if [ "$todos" -eq 0 ]; then base=0
  elif [ "$todos" -le 2 ]; then base=1
  elif [ "$todos" -le 4 ]; then base=2
  else return 0; fi
  for i in "${!team_steps[@]}"; do
    fade=$((base - team_steps[i]))
    [ "$fade" -ge 0 ] || fade=0
    lines[i]="<span fgalpha=\"${team_fades[fade]}%\">${team_lines[$i]}</span>"
  done
}

while :; do
  # The trackers side by side (their output in files meanwhile: gone before
  # anything else, as we may exec away)
  outputs=$(mktemp -d)
  "$assets/merge-queue" $mode >"$outputs/mine" 2>&1 &
  mine_pid=$!
  "$assets/review-queue" $mode >"$outputs/reviews" 2>&1 &
  reviews_pid=$!
  # Local work: its cache, refreshed behind us for the next time (computing
  # it takes a while, see local-work), unless asked for now (Ctrl+r, a push)
  work_mode=$mode
  [ -n "$work_now" ] && work_mode='' work_now=''
  "$assets/local-work" $work_mode >"$outputs/local" 2>/dev/null & # the same list: they complain
  local_pid=$!
  [ "$work_mode" = --cached ] && setsid -f "$assets/local-work" >/dev/null 2>&1
  wait "$mine_pid"; mine_status=$?
  wait "$reviews_pid"; reviews_status=$?
  wait "$local_pid"
  mine=$(<"$outputs/mine") reviews=$(<"$outputs/reviews") work=$(<"$outputs/local")
  rm -r "$outputs"
  mode=--cached

  # Both read the same repository list: one complaint is enough
  if [ "$mine_status" -eq 2 ] || [ "$reviews_status" -eq 2 ]; then
    [ "$mine_status" -eq 2 ] && message=${mine#merge-queue: } || message=${reviews#review-queue: }
    notify-send --app-name=github --urgency=critical "GitHub not watched" "$message"
    exit 1
  fi

  urls=()
  queues=()
  merges=() # <repo> <number> <in (the merge queue), out (ready to join it) or page (not ready)> [<CI> <review> <state> <threads> <comments>] (mine, unless merged)
  prs=() # <agent task> <repo> <number>
  sessions=() # the agent (an agent's row), else empty
  dirs=() # the worktree to open (local work, without an agent), else empty
  pushes=() # <clone> <branch> <upstream> <commits> to push (Ctrl+o), else empty
  homes=() # where Ctrl+s starts an agent, on a row with no pull request (an agent's worktree, local work's clone), else empty
  tags=()
  lines=()
  team_steps=() team_lines=() # my teams' reviews to lift, by row (see review)
  now=$(date +%s)
  find_agents
  find_local_work "$work" "$mine" "$reviews"
  find_loose_agents "$mine" "$reviews" "$local_work"
  measure_authors <<<"$reviews"
  measure_columns "$mine" "$reviews" "$loose_agents" "$local_work"

  # First, the agents: one waiting on me is the most urgent
  each_record agent <<<"$loose_agents"
  group=open each_record mine <<<"$mine"
  # Then what lies here, unpublished, or left behind
  each_record local_row <<<"$local_work"
  # Requested from me: the smallest first (quick ones), else oldest first
  group=mine each_record review < <(by_size <<<"$reviews")
  group=team each_record review <<<"$reviews"
  # Last, as they need nothing from me: on their way to the queue, in it,
  # merged, then in production
  group=auto each_record mine <<<"$mine"
  group=queued each_record mine <<<"$mine"
  group=deploying each_record mine <<<"$mine"
  group=deployed each_record mine <<<"$mine"
  surface_team_reviews

  if [ ${#lines[@]} -eq 0 ]; then
    notify-send --app-name=github GitHub "No agent, no open pull request, nothing lying here, nothing waiting on your review 🎉"
    exit 0
  fi
  align_columns

  # GitHub unreachable (exit 1): the trackers printed what they last knew
  status_line=''
  if [ "$mine_status" -eq 1 ] || [ "$reviews_status" -eq 1 ]; then
    status_line=$'\n'"<span color=\"$red\">Could not reach GitHub: showing the last known state</span>"
  fi

  # The window: as wide as the widest row, or the status line (in the
  # message's 90% font, with 2 characters to spare, as its font's are a
  # little wider than 90% of the rows'), with their padding (theme.rasi's
  # elem-gutter, the message's margin: 1em on each side), up to max_width,
  # and the monitor. Then the hints fill lines of that width (see hints_bar)
  widest=0
  [ -n "$status_line" ] && widest=$(( ($(shown_width "$status_line") * 9 + 9) / 10 + 2 ))
  for line in "${lines[@]}"; do
    width=$(shown_width "$line")
    [ "$width" -gt "$widest" ] && widest=$width
  done
  [ "$widest" -gt "$max_width" ] && widest=$max_width
  window="window { width: calc(${widest}ch + 2em min 100%); }"
  divider=$(hints_divider "$widest")
  mesg=$(hints_bar $(( (widest - 2) * 10 / 9 )))

  # Tags go in each row's invisible search terms (meta)
  selection=$(for i in "${!lines[@]}"; do printf '%s\0meta\x1f%s\n' "${lines[$i]}" "${tags[$i]}"; done |
    rofi -dmenu -i -markup-rows -p "$prompt" -format 'i f' -filter "$filter" \
      -kb-custom-1 'Control+r' -kb-custom-2 'Control+q' -kb-custom-3 'Control+f' -kb-custom-4 'Control+m' -kb-custom-5 'Control+o' -kb-custom-6 'Control+s' \
      -kb-move-char-forward Right \
      -kb-accept-entry 'Control+j,Return,KP_Enter' -theme-str "$layout $window $divider" -mesg "<span size=\"90%\">$mesg$status_line</span>")
  code=$?
  read -r choice filter <<<"$selection" # keep the search across refreshes
  [ "$choice" -ge 0 ] 2>/dev/null || choice=''

  case $code in
    0)
      [ -n "$choice" ] || exit 0
      [ -n "${sessions[$choice]}" ] && exec "$assets/agent-jump" "${sessions[$choice]}"
      [ -n "${dirs[$choice]}" ] && exec setsid -f kitty --directory "${dirs[$choice]}" nvim >/dev/null 2>&1
      [ -n "${urls[$choice]}" ] && exec browser-kiosk "${urls[$choice]}"
      notify-send --app-name=github GitHub "Nothing to open yet: push it first (Ctrl+o)"
      exit 0 ;;
    10) mode='' ;;
    11) [ -n "$choice" ] && [ -n "${queues[$choice]}" ] && exec browser-kiosk "${queues[$choice]}" ;; # reviews: stay
    12)
      if [ -n "$choice" ] && [ -n "${sessions[$choice]}" ]; then
        exec "$assets/agent-jump" "${sessions[$choice]}"
      elif [ -n "$choice" ]; then
        # Back to the agent on it, if any; nothing to fix: says so (see
        # agent-pr)
        read -r pr_task pr_repo pr_number <<<"${prs[$choice]}"
        [ -n "$pr_task" ] && exec "$assets/agent-pr" "$pr_task" "$pr_repo" "$pr_number"
      fi ;;
    13)
      if [ -n "$choice" ]; then
        read -r merge_repo merge_number merge_queue merge_ci merge_review merge_state merge_threads merge_comments <<<"${merges[$choice]}"
        concerns=''
        [ "$merge_queue" = out ] && concerns=$(queue_concerns "$merge_ci" "$merge_review" "$merge_state" "$merge_threads" "$merge_comments" "$merge_repo" "$merge_number")
        if [ -z "$merge_repo" ]; then
          notify-send --app-name=github GitHub "The merge queue is for my open pull requests"
        elif [ "$merge_queue" = page ]; then
          # "Merge when ready" there: the merge box sits right above the
          # comment box (it has no anchor of its own showing logged out)
          exec browser-kiosk "${urls[$choice]}#issue-comment-box"
        elif [ -n "$concerns" ] && ! confirm_queue "$merge_repo#$merge_number" "$concerns"; then
          : # back to the list
        elif result=$(toggle_queue "$merge_repo" "$merge_number" "$merge_queue" 2>&1); then
          # Leaving it: merge-queue tells, refreshing
          [ "$merge_queue" = out ] && notify-send --app-name=github "Merge when ready" "$merge_repo#$merge_number"$'\n'"$result"
          mode='' # show where it stands
        else
          notify-send --app-name=github --urgency=critical \
            "$([ "$merge_queue" = out ] && echo "Not added to" || echo "Not removed from") the merge queue" \
            "$merge_repo#$merge_number"$'\n'"$result"
        fi
      fi ;;
    14)
      if [ -n "$choice" ] && [ -n "${pushes[$choice]}" ]; then
        read -r push_clone push_branch push_upstream push_commits <<<"${pushes[$choice]}"
        if confirm_push "$push_branch" "$push_commits" "$push_upstream"; then
          if result=$(push_branch "$push_clone" "$push_branch" "$push_upstream"); then
            work_now=yes # its row goes
            notify-send --app-name=github "Pushed" "$push_branch ($(basename "$push_clone"))"
          else
            notify-send --app-name=github --urgency=critical "Not pushed" "$push_branch ($(basename "$push_clone"))"$'\n'"$result"
          fi
        fi
      elif [ -n "$choice" ]; then
        notify-send --app-name=github GitHub "Nothing to push there"
      fi ;;
    15)
      # The agent on it (its own row, local work's, its pull request's); else
      # a new one, on the first prompt I give it (see ask_prompt): on its
      # pull request, else in its repository (its main clone). Either way,
      # the list is done with (cancelled too)
      if [ -n "$choice" ]; then
        [ -n "${sessions[$choice]}" ] && exec "$assets/agent-jump" "${sessions[$choice]}"
        read -r pr_task pr_repo pr_number <<<"${prs[$choice]}"
        home=${homes[$choice]}
        common=$([ -n "$home" ] && git -C "$home" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) && home=$(dirname "$common")
        if [ -n "$pr_task" ]; then
          # A pull request's row holds no session: the agent on it, found
          # before asking (agent-pr would only after); one starting already:
          # agent-pr tells
          session=$(pr_agent "$pr_repo#$pr_number")
          [ -n "$session" ] && exec "$assets/agent-jump" "$session"
          pr_spawning_now "$pr_repo#$pr_number" && exec "$assets/agent-pr" --prompt '' "$pr_task" "$pr_repo" "$pr_number"
          # Ctrl+f there: the agent Ctrl+f starts, on its own task
          first=$(ask_prompt "on <b>$(escape "$pr_repo#$pr_number")</b>" "$pr_task" "$(github_clone "$pr_repo")")
          case $? in
            0) exec "$assets/agent-pr" --prompt "$first" "$pr_task" "$pr_repo" "$pr_number" ;;
            3) exec "$assets/agent-pr" "$pr_task" "$pr_repo" "$pr_number" ;;
            *) exit 0 ;;
          esac
        elif [ -n "$home" ]; then
          first=$(ask_prompt "in <b>$(escape "$(basename "$home")")</b>" '' "$home") || exit 0
          AGENT_DIR=$home exec "$assets/agent-spawn" ${first:+"$first"}
        else
          notify-send --app-name=github GitHub "No pull request nor repository to start an agent on there"
        fi
      fi ;;
    *) exit 0 ;;
  esac
done
