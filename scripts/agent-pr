#!/usr/bin/env bash
# Spawns an agent (see agent-spawn) on a pull request, in a
# worktree at its latest commit, for one of these tasks:
#   fix      fix it (mine): resolve its conflicts with its base branch (merging
#            it in, committed on my local copy of its branch, which its worktree
#            checks out when it can), address its unresolved
#            review threads, its open review comments (see
#            github_comments_jq) and its failing CI checks; it leaves those other
#            changes uncommitted for me to review, asks in the session when it
#            disagrees with a comment, and re-runs the jobs that failed for
#            infrastructure reasons; on a flaky spec, it re-runs its job once,
#            then merges the base branch in and pushes, then asks me
#            (the only push it makes unasked)
#   review   review it (someone else's), critically: design and naming first,
#            bugs on the side; in the session, changing nothing. It first
#            goes over what I said on it already, telling whether each point
#            was addressed, and never contradicts me: it flags that for me to
#            settle instead (neither is ever posted). Asked to
#            ("post", or "post 1 3"), it drafts its points as a pending
#            review on GitHub, inline on their lines, for me to go over and
#            submit (it never submits it)
# Either way, it pushes nothing, and posts nothing on GitHub unless asked
# (re-runs and the flaky spec's merge aside; reviews drafted are pending, mine
# to submit).
# With --no-prompt: the same agent, set up the same way (the worktree, the
# rules: --no-prompt fix for mine, --no-prompt review for the others'), but
# an interactive session, with no task: the user tells it what to do.
# An agent on it already: jumps back to it instead. To fix one of mine with
# nothing to fix (no conflict, unresolved review thread, open review comment
# or failing CI, as
# merge-queue's cache tells, which may lag): says so instead. Used by
# rofi-github (Ctrl+f; Ctrl+s: --no-prompt), rofi-search (cl fix|review <PR>)
# and merge-queue's notifications.
# The repository's clone: the one in ~/dev or ~/git whose origin it is.
# Usage: agent-pr [--no-prompt] <fix|review> <owner/repo> <number>

assets=$(dirname "$(readlink -f "$0")")
# shellcheck source-path=SCRIPTDIR source=lib/github.sh
. "$assets/lib/github.sh" # github_clone, github_ignored_checks (and records.sh)
# shellcheck source-path=SCRIPTDIR source=lib/agents.sh
. "$assets/lib/agents.sh" # pr_agent, spawn_notify, harness_do
fail() {
  [ -n "$spawning" ] && rm -f "$spawning"
  spawn_notify failed "Agent ${what:-to $task} $repo#$number not started: $1"
  exit 1
}
spawning=

no_prompt=''
[ "$1" = --no-prompt ] && { no_prompt=yes; shift; }
task=$1 repo=$2 number=$3
case $task in fix | review) ;; *) task='' ;; esac
[ -n "$task" ] && [ -n "$repo" ] && [ -n "$number" ] \
  || { echo "Usage: agent-pr [--no-prompt] <fix|review> <owner/repo> <number>" >&2; exit 2; }
what="to $task"
[ -n "$no_prompt" ] && what=on

# One spawn on it at a time: from telling whether an agent is on it to
# marking this one under way (see pr_spawning), rofi-github's Ctrl+f twice,
# or with a notification's Fix, starts only one
mkdir -p "$agents_dir"
exec 9>"$agents_dir/.spawning.lock"
flock 9

# An agent on it already (from rofi-github, or a notification): back to it,
# rather than another one. Starting already (its agent not up yet): say so
session=$(pr_agent "$repo#$number")
[ -n "$session" ] && exec "$assets/agent-jump" "$session" 9>&-
if pr_spawning_now "$repo#$number"; then
  agents_notify "An agent ${what} $repo#$number is starting already: it shows in the panel once up"
  exit 0
fi

# Nothing to fix on one of mine, by merge-queue's cache (not in it, someone
# else's or in no watched repository: no telling, go ahead). Merged ones
# (threads and comments -) have nothing either
if [ "$task" = fix ] && [ -z "$no_prompt" ]; then
  found='' known_threads='' known_comments='' known_ci='' known_review=''
  # shellcheck disable=SC2154,SC2329 # record fields, set by each_record (which calls it)
  find_pr() {
    [ "$repo" = "$wanted_repo" ] && [ "$number" = "$wanted_number" ] || return 0
    found=yes known_threads=$threads known_comments=$comments known_ci=$ci known_review=$review
  }
  wanted_repo=$repo wanted_number=$number
  each_record find_pr < <("$assets/merge-queue" --cached 2>/dev/null)
  repo=$wanted_repo number=$wanted_number # each_record set them, record by record
  if [ -n "$found" ] && [ "${known_threads/#-/0}" -eq 0 ] 2>/dev/null &&
    [ "${known_comments/#-/0}" -eq 0 ] 2>/dev/null &&
    [ "$known_ci" != FAILURE ] && [ "$known_review" != CONFLICT ]; then
    notify-send --app-name=github GitHub \
      "Nothing to fix on $repo#$number: no conflict, no unresolved review thread, no open review comment, no failing CI (refresh with Ctrl+r in rofi-github if that just changed)"
    exit 0
  fi
fi

# Going ahead: under way, until its agent is up (see pr_spawning)
spawning=$(pr_spawning "$repo#$number")
: >"$spawning"
exec 9>&-

# Spawning, which takes a while (the fetch, the worktree, then the harness): say
# so now, the notification turning into the outcome (see agent-spawn)
spawn_notify started "Starting an agent $what $repo#$number…"

clone=$(github_clone "$repo")
[ -n "$clone" ] || fail "no clone of $repo in ~/dev or ~/git"

# The pull request's latest commit, whichever fork its branch lives in
timeout 60 git -C "$clone" fetch --quiet origin "refs/pull/$number/head" 2>/dev/null \
  || fail "could not fetch $repo#$number"
head=$(git -C "$clone" rev-parse FETCH_HEAD)

url="https://github.com/$repo/pull/$number"
about="You work on pull request #$number of $repo ($url), at its latest commit."
# How its harness waits on a CI job (see watch in lib/agents.sh)
watch=$(harness_do "$default_harness" watch) || watch='in the background, not by sleeping in the foreground'

if [ "$task" = fix ]; then
  # Its branches, for the merge (left to the agent to find out without them)
  IFS=$'\t' read -r branch base < <(timeout 30 gh pr view "$number" -R "$repo" \
    --json headRefName,baseRefName --jq '[.headRefName, .baseRefName] | @tsv' 2>/dev/null)

  # The agent's worktree checks out my local copy of its head branch,
  # fast-forwarded to its latest commit (created there when missing), so that
  # its commits land on the branch I push from; not when another worktree (my
  # clone's included) has it checked out, or it holds commits the pull request
  # doesn't: then the agent asks me where to commit
  local_branch='' unusable=''
  if [ -z "$branch" ]; then
    unusable='its head branch is unknown (gh pr view failed)'
  elif git -C "$clone" worktree list --porcelain | grep -qxF "branch refs/heads/$branch"; then
    unusable="$branch is checked out in another worktree"
  elif ! git -C "$clone" show-ref --verify --quiet "refs/heads/$branch"; then
    git -C "$clone" branch --quiet "$branch" "$head" && local_branch=$branch
    git -C "$clone" show-ref --verify --quiet "refs/remotes/origin/$branch" &&
      git -C "$clone" branch --quiet --set-upstream-to="origin/$branch" "$branch"
  elif git -C "$clone" merge-base --is-ancestor "refs/heads/$branch" "$head"; then
    git -C "$clone" branch --quiet --force "$branch" "$head" && local_branch=$branch
  else
    unusable="the local $branch holds commits the pull request doesn't"
  fi
  [ -n "$local_branch" ] || [ -n "$unusable" ] || unusable="$branch could not be moved to its latest commit"
  branch=${branch:-<its head branch, see gh pr view>} base=${base:-<its base branch, see gh pr view>}

  if [ -n "$local_branch" ]; then
    read -r -d '' where <<WHERE
Your worktree is on $branch, the user's local copy of its head branch,
fast-forwarded to its latest commit: make any commit there, and never create
another branch.
WHERE
    push="git push origin $branch"
  else
    read -r -d '' where <<WHERE
Your worktree is on a detached HEAD, as it could not be put on its head branch:
$unusable. Before your first commit, tell the user so, and ask them which
branch to make it on.
WHERE
    push="git push origin <the branch you committed on>:$branch"
  fi

  read -r -d '' rules <<RULES
$about
$where
Never push, but for the merge of the base branch a flaky spec calls for (see
the task). Commit only the merges resolving its conflicts or a flaky spec,
unless the user asks for more: leave every other change uncommitted, for the
user to review. Whenever you commit and don't push, give the user the command
to push it from their clone, $clone (your worktree goes once you stop; the
branch stays, as worktrees share their clone's branches): $push.
Don't reply to, nor resolve, any review thread on GitHub, nor hide any review
comment, unless the user asks you to. Re-run a CI job only when it failed for an infrastructure reason or
on a flaky spec, and once (see the task); no other one unless the user asks.
When you disagree with a reviewer's comment, or can't tell what it asks, ask
the user here before changing anything for it.
RULES

  read -r -d '' prompt <<PROMPT
Fix $url: its conflicts with its base branch, its unresolved review threads,
its open review comments, and its failing CI checks.
0. Conflicts: check whether it has any with gh pr view $number -R $repo
   --json mergeable (CONFLICTING). If so, git fetch origin $base and
   git merge origin/$base, as GitHub's "Update
   branch" would (a merge, not a rebase: the pull request's branch then only
   moves forward). Resolve each conflict from what both sides meant: read the
   pull request's change and what $base changed there since (git log -p
   --merge, for each conflicting file). When the right resolution isn't
   clear, ask the user before settling it. Run the specs covering the
   conflicting files, then commit the merge (git commit --no-edit), and give
   the push command in your summary.
1. Review threads: fetch them with gh api graphql (the pull request's
   reviewThreads, keeping those whose isResolved is false, with their path,
   line and comments). For each, make the change asked for.
   Review comments: the bodies of its reviews (gh api graphql: the pull
   request's reviews, with author, state, body, isMinimized and
   viewerDidAuthor), keeping those not hidden (isMinimized false), not
   empty, not the user's (viewerDidAuthor false), neither DISMISSED nor
   PENDING: points a reviewer made outside any line (one a bot couldn't
   anchor, say). For each point they make, as for a thread; one only
   summing up the threads (or saying there is nothing to fix) has nothing
   more. A reviewer repeating a point across reviews: one change.
2. CI: list the checks of its latest commit with gh pr checks $number -R $repo
   (tab separated: name, state, duration, link), keeping those whose state is
   fail; skip ${github_ignored_checks[*]@Q} (one only waits for approvals,
   the others are optional), and summaries of the others (such as
   "CI Summary"). For a GitHub Actions job
   (its link ends with /job/<job id>), read its log with
   gh api repos/$repo/actions/jobs/<job id>/logs (gh run view --log-failed
   prints nothing here): look for ##[error] lines and the test failures above
   them. Fix what the pull request broke. A failure it didn't cause is not
   yours to fix: tell it apart, and say so instead of changing code for it.
   When it's the infrastructure's (the runner shut down or lost, a timeout
   fetching dependencies or images, a service that didn't start: nothing the
   code did), re-run that job, once, with
   gh api -X POST repos/$repo/actions/jobs/<job id>/rerun (the id from its
   link; not gh run rerun --job, which wants another one): if it fails again,
   report it instead. One re-run already (its run_attempt, in
   gh api repos/$repo/actions/jobs/<job id>, is above 1): report it too. A
   spec failing on the base branch too: report it only. A flaky spec (one the
   pull request didn't touch nor affect, failing from test order, shared
   state, time or randomness, not on the base branch):
   a. re-run its job, once, as above (unless already re-run), then watch it
      until it ends: its new job id from gh pr checks (the re-run gets
      another one), polled $watch;
   b. if it fails again, git fetch origin $base and git merge origin/$base
      (resolving any conflict as in 0), commit it (git commit --no-edit),
      then push it, with $push from your worktree, and watch
      the job of the new commit's run the same way; nothing to merge (the
      branch has $base already): skip to c;
   c. if it still fails, stop and ask the user what to do.
   Report each step in your summary.
Any of them may have nothing to do: say so and move on. Then run the specs
covering what you changed. Finish with a summary: the conflicts (how you
resolved each), then thread by thread, then review comment by review comment,
then check by check, what you changed,
re-ran, merged and pushed, or why you did none of it.
PROMPT
else
  read -r -d '' rules <<RULES
$about
You review it for the user: change no file, commit nothing, and post nothing
on GitHub (no comment, no review) unless the user asks you to. Your review
goes here, in the session.
Be a demanding, skeptical reviewer: no praise, no filler, no softening. What
matters most is design (responsibilities, coupling, wrong or premature
abstractions, code that belongs elsewhere in the codebase, consistency with
its existing patterns) and naming (misleading, vague or inconsistent names,
ones off the codebase's or the domain's vocabulary). Judge against the
surrounding code, not the diff alone.
Stay consistent with what the user said on it already (see the task): never
report as a point something going against an earlier comment of theirs (a
change they asked for, an approach they agreed to or turned down in a reply).
When you think one of theirs was wrong, or a point of yours would go against
it, say so in its own section instead, for them to settle.
When the user asks you to post your points (all of them, or the ones they
name by number), draft them as a pending review on GitHub: only the numbered
points, never the earlier ones' status nor the conflicts. Only they see it,
until they submit it, which is theirs to do: never submit it, never give it
an event.
1. One inline comment per point, on the lines it is about in the pull
   request's diff at $head: path, line (its last line), start_line when it
   spans several, side RIGHT (LEFT for removed lines; start_side alike). Only
   lines within the diff's hunks can carry one (see the patch of each file in
   gh api repos/$repo/pulls/$number/files): a point about other lines goes in
   the review's body instead, with its file and lines.
2. Each comment says what is wrong and why, then the alternative: as a
   suggestion block (\`\`\`suggestion) when it rewrites those very lines,
   else as a code block when code helps. No diff excerpt (GitHub shows the
   lines), no number, no severity label. Write plainly, as the user would,
   in the language of the pull request's description.
3. Create it in one call, without an event (which leaves it pending):
   gh api repos/$repo/pulls/$number/reviews -X POST --input - fed
   {"commit_id": "$head", "body": <empty, or the points that could not be
   anchored>, "comments": [...]}.
4. GitHub keeps one pending review per person and pull request: when it
   refuses, as the user has one already, add your comments to theirs: its id
   from gh api graphql (the pull request's reviews(states: PENDING, first: 1)),
   then one addPullRequestReviewThread mutation per comment
   (pullRequestReviewId, path, line, side, startLine, startSide, body).
5. Then give the user its page, to go over and submit it: $url/files.
RULES

  read -r -d '' prompt <<PROMPT
Review $url. Read its description and base branch with gh pr view, fetch that
base, then review the changes against its merge base with HEAD (so that what
landed on the base since stays out).
Before reviewing, go over what the user (gh api user --jq .login) said on it
already, leaving other people's comments out: their review threads (gh api
graphql: the pull request's reviewThreads, with isResolved, isOutdated, path,
line and every comment, replies from others included), their reviews' bodies
(gh api repos/$repo/pulls/$number/reviews) and their comments on its
conversation (gh api repos/$repo/issues/$number/comments). Comments of a
pending review of theirs are drafts: keep consistent with them, but they
have no status. For every other point they made, tell from the code at HEAD
(not from its thread being resolved or outdated alone) whether it was
addressed, partly addressed, not addressed, or no longer applies (the code it
was about is gone), weighing any reply the author made.
Start your report with those earlier points, oldest first, unnumbered (none:
say so in one line): for each, its link, what it asked in a few words, its
status and why. Don't raise
again, as a new point, what an earlier one covers already.
Then report design and naming issues, the most severe first, numbered (one
numbering across both sections below). For each:
- the file and line range,
- the part of the diff it is about, as a diff code block: only the lines
  concerned, with a few lines of context (not the whole hunk); when the issue
  recurs, the most telling excerpt, then the other places it occurs,
- what is wrong and why,
- a concrete alternative (as code when it helps).
Then, in a short separate section, bugs you noticed along the way (same
format). Leave out style nitpicks a linter would catch.
Then, if any, the conflicts with the user's earlier comments, unnumbered: what
they said (with its link), what you think now, and why.
End with one line: the user can have you draft them on GitHub, as a pending
review only they see until they submit it, by saying "post" (all of them) or
"post" and their numbers.
PROMPT
fi

# No task (--no-prompt): the setup only, and rules fit for whatever the user
# asks
if [ -n "$no_prompt" ]; then
  prompt=''
  if [ "$task" = fix ]; then
    read -r -d '' rules <<RULES
$about
$where
Push nothing, and post nothing on GitHub (no comment, no reply, no review),
unless the user asks you to. Leave your changes uncommitted unless they ask
you to commit; whenever you commit and don't push, give them the command to
push it from their clone, $clone (your worktree goes once you stop; the branch
stays, as worktrees share their clone's branches): $push.
RULES
  else
    read -r -d '' rules <<RULES
$about
It's someone else's: change no file and commit nothing unless the user asks
you to, and post nothing on GitHub (no comment, no reply, no review) unless
they ask you to.
RULES
  fi
fi

AGENT_DIR=$clone AGENT_AT=$head AGENT_BRANCH=$local_branch AGENT_CONTEXT=$rules AGENT_PR="$repo#$number" \
  exec "$assets/agent-spawn" ${prompt:+"$prompt"}
