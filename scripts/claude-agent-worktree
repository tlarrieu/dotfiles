#!/usr/bin/env bash
# Creates an isolated git worktree for a Claude agent, on a detached HEAD at the
# repository's current commit (the agent creates its branch when it first needs
# to commit: the checked out branch can't be shared with the primary worktree,
# whose files would fall out of sync on commits), and reserves it a slot: the TEST_ENV_NUMBER its specs run with, so they get
# their own test databases. A slot stays taken as long as its worktree exists.
# Usage: claude-agent-worktree <repository> [<commit>]  (default: its HEAD)
# Prints "<slot> <worktree>" (worktree: <parent>/<repo>-agents/<repo>-<slot>)
# Slot files hold "<worktree> <base commit>", for claude-agent-sweep to tell
# whether the agent committed anything.

# Slots, a range of TEST_ENV_NUMBER values clear of ours (CLAUDE_AGENT_SLOTS
# overrides it, e.g. 11-19)
slots=${CLAUDE_AGENT_SLOTS:-11-19}
first_slot=${slots%-*} last_slot=${slots#*-}

root=$(git -C "$1" rev-parse --show-toplevel 2>/dev/null) || exit 1
repo=$(basename "$root")
agents_dir="$(dirname "$root")/$repo-agents"
slots_dir="${XDG_STATE_HOME:-$HOME/.local/state}/claude-agents/slots/$repo"
mkdir -p "$agents_dir" "$slots_dir"

# Free the slots of agents stopped without us noticing
"$(dirname "$(readlink -f "$0")")/claude-agent-sweep"

# Serialize spawns, so two of them can't grab the same slot
exec 9>"$slots_dir/.lock"
flock 9

slot=''
for n in $(seq "$first_slot" "$last_slot"); do
  taken=''
  [ -f "$slots_dir/$n" ] && read -r taken _ <"$slots_dir/$n"
  if [ -z "$taken" ] || [ ! -d "$taken" ]; then slot=$n; break; fi
done
[ -n "$slot" ] || { echo "All $repo agent slots are taken (remove some worktrees in $agents_dir)" >&2; exit 1; }

worktree="$agents_dir/$repo-$slot"
git -C "$root" worktree prune
base=$(git -C "$root" rev-parse --verify "${2:-HEAD}^{commit}") || exit 1
git -C "$root" worktree add --quiet --detach "$worktree" "$base" >&2 || exit 1

echo "$worktree $base" >"$slots_dir/$slot"
echo "$slot $worktree"
