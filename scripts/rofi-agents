#!/usr/bin/env bash
# Rofi hub for Claude agents: jump to a live session, or spawn a new one in
# the current project (~/.project, with an optional initial prompt) in a kitty
# window kept in the background (see the claude-agent rule in awesome), with a
# neovim tab next to the agent to inspect what it produces.

assets=$(dirname "$(readlink -f "$0")")
dir="${XDG_RUNTIME_DIR:-/tmp}/claude-agents"

declare -A faces=([running]='󱚣' [done]='󱜙' [idle]='󱜙' [attention]='󱚟')

elapsed() {
  local seconds=$(($(date +%s) - $1))
  if [ "$seconds" -lt 60 ]; then echo "${seconds}s"
  elif [ "$seconds" -lt 3600 ]; then echo "$((seconds / 60))m"
  else printf '%dh%02d' $((seconds / 3600)) $((seconds % 3600 / 60)); fi
}

# What the agent last said, or the tool it last reached for
last_message() {
  [ -f "$1" ] || return
  tail -n 100 "$1" | jq -rs '
    [.[] | select(.type == "assistant") | .message.content[]?] | last
    | if .type == "text" then .text
      elif .type == "tool_use" then "󰒓 \(.name)"
      else "" end
  ' 2>/dev/null | tr '\n' ' ' | awk '{ print substr($0, 1, 90) }' # multibyte-safe
}

spawn() {
  # Same current project as awesome's dev window (it may hold a ~)
  local project prompt
  project=$(cat ~/.project 2>/dev/null)
  project=${project/#\~/$HOME}
  [ -d "$project" ] || exit 1

  # Empty prompt (just Enter) starts an interactive session, Escape cancels
  prompt=$(rofi -dmenu -p "󰚩 $(basename "$project")" -l 0 </dev/null) || exit 0

  # One kitty window holding two tabs: the agent (focused), then neovim to
  # inspect what it produces. The prompt goes through a file to dodge session
  # quoting; the agent tab removes it, along with the session file, once started.
  local spawn_dir="${XDG_RUNTIME_DIR:-/tmp}/claude-agents-spawn"
  mkdir -p "$spawn_dir"
  local session_file prompt_file agent
  session_file=$(mktemp "$spawn_dir/session.XXXXXX")

  # Fish loads the claude function, which brings the settings from my dotfiles
  if [ -n "$prompt" ]; then
    prompt_file=$(mktemp "$spawn_dir/prompt.XXXXXX")
    printf '%s' "$prompt" >"$prompt_file"
    agent="set -l prompt (string collect < $prompt_file); rm -f $prompt_file $session_file; claude \$prompt"
  else
    agent="rm -f $session_file; claude"
  fi

  cat >"$session_file" <<SESSION
new_tab
cd $project
launch fish -c '$agent'
new_tab
cd $project
launch fish -c nvim
SESSION

  setsid -f kitty --single-instance --name claude-agent --session "$session_file" >/dev/null 2>&1
}

sessions=()
lines=('󰐕  New agent')
while read -r _ state since session project; do
  read -r _ _ _ _ _ _ _ transcript _ <"$dir/$session"
  duration=''
  [ "$state" = running ] && [ "$since" != - ] && duration=$(elapsed "$since")
  sessions+=("$session")
  lines+=("$(printf '%s  %-16s %5s   %s' "${faces[$state]:-󰚩}" "$project" "$duration" "$(last_message "$transcript")")")
done < <("$assets/claude-agent-list")

choice=$(printf '%s\n' "${lines[@]}" | rofi -dmenu -i -p '󰚩' -format i) || exit 0
[ -n "$choice" ] || exit 0

if [ "$choice" -eq 0 ]; then
  spawn
else
  "$assets/claude-agent-jump" "${sessions[$((choice - 1))]}"
fi
