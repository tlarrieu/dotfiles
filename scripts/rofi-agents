#!/usr/bin/env bash
# Rofi hub for Claude agents: jump to a live session.
# New agents are spawned from rofi-search ('cl' keyword, see claude-agent-spawn).

assets=$(dirname "$(readlink -f "$0")")
# shellcheck source-path=SCRIPTDIR source=lib/claude-agents.sh
. "$assets/lib/claude-agents.sh"
# shellcheck source-path=SCRIPTDIR source=lib/records.sh
. "$assets/lib/records.sh"

# The session title: the one given with /rename (or --name), else Claude's own
title() {
  [ -f "$1" ] || return
  grep -E '"type":"(custom-title|agent-name|ai-title)"' "$1" | jq -rs '
    (map(select(.type == "custom-title")) | last | .customTitle)
    // (map(select(.type == "agent-name")) | last | .agentName)
    // (map(select(.type == "ai-title")) | last | .aiTitle) // empty
  ' 2>/dev/null | awk '{ print substr($0, 1, 90) }' # multibyte-safe
}

sessions=()
lines=()
# Adds a claude-agent-list record
# shellcheck disable=SC2154 # record and state file fields, set by each_record and read_agent
agent() {
  local duration=''
  read_agent "$agents_dir/$session" agent_
  [ "$state" = running ] && [ "$since" != - ] && duration=$(elapsed "$since")
  sessions+=("$session")
  lines+=("$(printf '%s  %-16s %5s   %s' "${agent_faces[$state]:-󰚩}" "$project" "$duration" "$(title "$agent_transcript")")")
}
each_record agent < <("$assets/claude-agent-list")

if [ ${#sessions[@]} -eq 0 ]; then
  notify-send --app-name=claude --icon="$assets/claude.png" Claude "No agent running (spawn one with 'cl' in rofi-search)"
  exit 0
fi

choice=$(printf '%s\n' "${lines[@]}" | rofi -dmenu -i -p '󰚩' -format i) || exit 0
[ -n "$choice" ] || exit 0

"$assets/claude-agent-jump" "${sessions[$choice]}"
