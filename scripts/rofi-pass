#!/bin/bash

assets=$(dirname "$(readlink -f "$0")")
# shellcheck source-path=SCRIPTDIR source=lib/rofi.sh
. "$assets/lib/rofi.sh"

function copy_status {
  if [ $? = 0 ]; then
    notify-send "Pass: copied" "The clipboard will be cleared in <b>45 sec</b>"
  else
    notify-send "Pass: error" "Something went wrong.\nTry running pass manually."
  fi
}

function edit_status {
  if [ $? = 0 ]; then
    notify-send "Pass: success" "The entry has been modified"
  else
    notify-send "Pass: failure" "The entry has <b>not</b> been modified"
  fi
}

function generate_password {
  pass generate -i -c "$option"
  copy_status
}

function type {
  xdotool type --clearmodifiers --delay=0 "$1"
}

function press {
  xdotool key "$1"
}

function password {
  pass show "$option" | sed -n '1p'
}

function login {
  pass show "$option" | sed -n '2p'
}

function account_id {
  pass show "$option" | sed -n '3p'
}

# How wide a window fitting the longest of the given lines is (markup aside),
# in characters: between 65 and 100
function fit_chars {
  printf '%s\n' "$@" | sed -e 's/<[^>]*>//g' \
    | awk '{ if (length > max) max = length } END { print (max < 65 ? 65 : max > 100 ? 100 : max) }'
}

# A theme fitting the window to the given lines (see fit_chars), plus the 1em
# gutters on each side, and never more than the screen
function fit_width {
  echo "window { width: calc($(fit_chars "$@")ch + 2em min 100%); }"
}

hints enter=autofill shift+enter=insert ctrl+enter=edit alt+enter=generate ctrl+q='QR code'

entries=$(\
  pass git ls-files \
  | grep '.gpg$' \
  | { sed -e 's/.gpg$//' ; echo "perso/carte-bleue"; } \
  | { sed -e 's/.gpg$//' ; echo "tmp"; } \
)

# The hints under the list, as rofi-github shows them (see lib/rofi.sh), in
# lines fitting the window (in the message's 90% font, as rofi-github)
widest=$(fit_chars "$entries")
mesg=$(hints_bar $(( (widest - 2) * 10 / 9 )))

option=$(\
  echo "$entries" \
  | rofi \
      -dmenu \
      -l 5 \
      -theme-str "$hints_layout $(fit_width "$entries") $(hints_divider "$widest")" \
      -i \
      -p 󰟵 \
      -no-history \
      -kb-custom-1 "Return" \
      -kb-custom-2 "Shift+Return" \
      -kb-custom-3 "Control+Return" \
      -kb-custom-4 "Alt+Return" \
      -kb-custom-5 "Control+q" \
      -kb-accept-entry "" \
      -kb-accept-custom "" \
      -kb-accept-alt "" \
      -mesg "<span size=\"90%\">$mesg</span>"
)

rofi_signal=$?

if [ ${#option} -gt 0 ]; then
  # The exit code for -kb-custom-X is X+9
  case $rofi_signal in
    10)
      case "$option" in
      tmp)
        generate_password
        ;;
      perso/carte-bleue)
        PASSWORD_STORE_CLIP_TIME=5 pass show -c1 perso/carte-bleue
        press "Control_L+v"
        press Tab
        PASSWORD_STORE_CLIP_TIME=5 pass show -c2 perso/carte-bleue
        press "Control_L+v"
        press Tab
        PASSWORD_STORE_CLIP_TIME=5 pass show -c3 perso/carte-bleue
        press "Control_L+v"
        ;;

      # password only
      perso/linux | \
      perso/microsoft |\
      perso/paypal |\
      perso/duckduckgo |\
      */google)
        type "$(password)"
        press Return
        ;;

      # passwords shows up after we validate the login
      pro/azure |\
      pro/elevo | \
      pro/payfit | \
      perso/impots.gouv.fr | \
      perso/amazon |\
      perso/france-travail |\
      perso/swile |\
      pro/newrelic)
        type "$(login)"
        press Return
        sleep 1
        type "$(password)"
        press Return
        ;;

      pro/bitwarden |\
      perso/syndic)
        type "$(login)"
        press Return
        sleep 1
        press Tab
        type "$(password)"
        press Return
        ;;

      pro/onoff)
        press Tab
        press Tab
        type "$(login)"
        press Tab
        type "$(password)"
        press Return
        ;;

      perso/cpf |\
      perso/trainline |\
      perso/assurance-maladie |\
      perso/mma-assurance)
        type "$(login)"
        press Tab
        press Tab
        type "$(password)"
        press Return
        ;;

      # “normal” case where login and password fields are visible, but the
      # first field is not focused
      pro/travelperk |\
      perso/bankin)
        press Tab
        type "$(login)"
        press Tab
        type "$(password)"
        press Return
        ;;

      # “normal” case where login and password fields are visible
      *)
        type "$(login)"
        press Tab
        type "$(password)"
        press Return
        ;;
      esac
      ;;
    11)
      answer=$(\
        echo -e "Password\nLogin" \
        | rofi \
            -dmenu \
            -l 2 \
            -theme-str "$(fit_width Password Login)" \
            -i \
            -p  \
            -no-history \
      )
      if [ ${#answer} -gt 0 ]; then
        case $answer in
          "Password")
            type "$(password)"
            ;;
          *)
            type "$(login)"
            ;;
        esac
      fi
      ;;
    12)
      EDITOR="kitty -- nvim" pass edit "$option"
      edit_status
      ;;
    13)
      pass git ls-files | grep "$option"
      if [ $? = 0 ]; then
        answer=$(\
          echo -e "✔ Yes\n✖ No" \
          | rofi \
              -dmenu \
              -l 2 \
              -theme-str "$(fit_width "✔ Yes" " You are about to change password for <b>$option</b>. Is that OK?")" \
              -i \
              -p  \
              -no-history \
              -mesg " You are about to change password for <b>$option</b>. Is that OK?"
        )
        if [ ${#answer} -gt 0 ]; then
          case $answer in
            "✔ Yes")
              generate_password
              ;;
            *)
              notify-send "Pass: aborted" "Nothing was changed!"
            ;;
          esac
        else
          notify-send "Pass: aborted" "Nothing was changed!"
        fi
      else
        pass generate -c "$option"
        copy_status
      fi
      ;;
    14)
      pass -q1 "$option"
      ;;
  esac
fi
